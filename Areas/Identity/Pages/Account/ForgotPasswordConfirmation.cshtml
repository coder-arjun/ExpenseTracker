@page
@model ForgotPasswordConfirmationModel
@{
    ViewData["Title"] = "Check your email";
}

<div class="login-wrapper">
    <div class="login-container">
        <div class="login-illustration d-none d-md-flex">
            <div class="login-shape login-shape-1"></div>
            <div class="login-shape login-shape-2"></div>
            <div class="login-shape login-shape-3"></div>
            <span class="login-float-icon"><i class="bi bi-envelope-check"></i></span>
            <span class="login-float-icon"><i class="bi bi-send"></i></span>
            <span class="login-float-icon"><i class="bi bi-shield-lock"></i></span>
            <i class="bi bi-envelope-paper-fill login-logo"></i>
            <div class="login-app-name">Finoma</div>
            <div class="login-tagline">If that account exists, a reset link is on its way.</div>
        </div>
        <div class="login-form-panel">
            <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Account ledger</div>
            <div class="login-heading">Check your email</div>
            <div class="login-subheading">
                If an account matches what you entered, we've emailed a link to reset your
                password. The link is single-use — check your spam folder if it doesn't arrive
                within a few minutes.
            </div>
            <div class="d-grid mb-2 login-field">
                <a asp-page="./Login" class="btn btn-lg btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Back to login
                </a>
            </div>
        </div>
    </div>
</div>
