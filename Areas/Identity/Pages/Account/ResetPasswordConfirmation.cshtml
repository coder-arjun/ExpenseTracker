@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Password reset";
}

<div class="login-wrapper">
    <div class="login-container">
        <div class="login-illustration d-none d-md-flex">
            <div class="login-shape login-shape-1"></div>
            <div class="login-shape login-shape-2"></div>
            <div class="login-shape login-shape-3"></div>
            <span class="login-float-icon"><i class="bi bi-shield-check"></i></span>
            <span class="login-float-icon"><i class="bi bi-check2-circle"></i></span>
            <span class="login-float-icon"><i class="bi bi-unlock"></i></span>
            <i class="bi bi-shield-fill-check login-logo"></i>
            <div class="login-app-name">Finoma</div>
            <div class="login-tagline">All set — your password has been updated.</div>
        </div>
        <div class="login-form-panel">
            <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Account ledger</div>
            <div class="login-heading">Password reset</div>
            <div class="login-subheading">
                Your password has been changed successfully. You can now sign in with your
                new password.
            </div>
            <div class="d-grid mb-2 login-field">
                <a asp-page="./Login" class="btn btn-lg btn-primary">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign in
                </a>
            </div>
        </div>
    </div>
</div>
