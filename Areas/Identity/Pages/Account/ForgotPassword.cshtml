@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}

<div class="login-wrapper">
    <div class="login-container">
        <!-- Left illustration panel (matches the login page) -->
        <div class="login-illustration d-none d-md-flex">
            <div class="login-shape login-shape-1"></div>
            <div class="login-shape login-shape-2"></div>
            <div class="login-shape login-shape-3"></div>
            <span class="login-float-icon"><i class="bi bi-shield-lock"></i></span>
            <span class="login-float-icon"><i class="bi bi-envelope"></i></span>
            <span class="login-float-icon"><i class="bi bi-key"></i></span>
            <span class="login-float-icon"><i class="bi bi-currency-rupee"></i></span>
            <i class="bi bi-shield-lock-fill login-logo"></i>
            <div class="login-app-name">Finoma</div>
            <div class="login-tagline">Locked out? We'll email you a secure link to set a new password.</div>
            <ul class="login-features">
                <li><i class="bi bi-check-circle-fill"></i> Use your email or User ID</li>
                <li><i class="bi bi-check-circle-fill"></i> Single-use, time-limited link</li>
                <li><i class="bi bi-check-circle-fill"></i> Your data stays private</li>
            </ul>
        </div>
        <!-- Right form panel -->
        <div class="login-form-panel">
            <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Account ledger</div>
            <div class="login-heading">Forgot password?</div>
            <div class="login-subheading">Enter your email or User ID and we'll send a reset link.</div>
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-3 login-field">
                    <input asp-for="Input.EmailOrUserId" class="form-control" autocomplete="username" aria-required="true" placeholder="email or user ID" autofocus />
                    <label asp-for="Input.EmailOrUserId" class="form-label">Email or User ID</label>
                    <span asp-validation-for="Input.EmailOrUserId" class="text-danger"></span>
                </div>
                <div class="d-grid mb-3 login-field">
                    <button type="submit" class="btn btn-lg btn-primary">
                        <i class="bi bi-envelope-arrow-up me-2"></i>Send reset link
                    </button>
                </div>
                <div class="text-center login-field">
                    <p class="mb-0">
                        <a asp-page="./Login"><i class="bi bi-arrow-left me-1"></i>Back to login</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
