@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    // Returning user (username pre-filled from the "Remember me" cookie): jump
    // straight to the password field. Fresh visit: focus the username field.
    var hasRememberedUser = !string.IsNullOrEmpty(Model.Input?.EmailOrUserId);
}

<style>
    .login-field .pwd-input { padding-right: 2.75rem; }
    .login-field .password-toggle {
        position: absolute; top: 0; right: 0; height: 100%; width: 2.75rem;
        display: flex; align-items: center; justify-content: center;
        background: transparent; border: 0; padding: 0; cursor: pointer;
        color: var(--ink-muted); z-index: 3; font-size: 1.05rem;
    }
    .login-field .password-toggle:hover { color: var(--red); }
    .login-field .password-toggle:focus-visible { color: var(--red); outline: 2px solid var(--red); outline-offset: -2px; border-radius: var(--r-sm); }
</style>

<div class="login-wrapper">
    <div class="login-container">
        <!-- Left illustration panel -->
        <div class="login-illustration d-none d-md-flex">
            <div class="login-shape login-shape-1"></div>
            <div class="login-shape login-shape-2"></div>
            <div class="login-shape login-shape-3"></div>
            <span class="login-float-icon"><i class="bi bi-currency-rupee"></i></span>
            <span class="login-float-icon"><i class="bi bi-graph-up"></i></span>
            <span class="login-float-icon"><i class="bi bi-piggy-bank"></i></span>
            <span class="login-float-icon"><i class="bi bi-wallet2"></i></span>
            <i class="bi bi-bar-chart-line-fill login-logo"></i>
            <div class="login-app-name">Finoma</div>
            <div class="login-tagline">Your personal finance companion for smarter money management.</div>
            <ul class="login-features">
                <li><i class="bi bi-check-circle-fill"></i> Track income, expenses & savings</li>
                <li><i class="bi bi-check-circle-fill"></i> Set budgets with smart alerts</li>
                <li><i class="bi bi-check-circle-fill"></i> Visual dashboards & insights</li>
                <li><i class="bi bi-check-circle-fill"></i> Category-wise spending analysis</li>
            </ul>
        </div>
        <!-- Right form panel -->
        <div class="login-form-panel">
            <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Account ledger</div>
            <div class="login-heading">Welcome Back</div>
            <div class="login-subheading">Sign in to continue managing your finances</div>
            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
                <div class="form-floating mb-3 login-field">
                    <input asp-for="Input.EmailOrUserId" class="form-control" autocomplete="username" aria-required="true" placeholder="email or user ID" autofocus="@(!hasRememberedUser)" />
                    <label asp-for="Input.EmailOrUserId" class="form-label">Email or User ID</label>
                    <span asp-validation-for="Input.EmailOrUserId" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3 login-field position-relative">
                    <input asp-for="Input.Password" class="form-control pwd-input" autocomplete="current-password" aria-required="true" placeholder="password" autofocus="@hasRememberedUser" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <button type="button" id="loginPasswordToggle" class="password-toggle"
                            aria-label="Show password" aria-pressed="false" title="Show password">
                        <i class="bi bi-eye" aria-hidden="true"></i>
                    </button>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3 login-field">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe" class="form-check-label">
                        @Html.DisplayNameFor(m => m.Input.RememberMe)
                    </label>
                </div>
                <div class="d-grid mb-3 login-field">
                    <button id="login-submit" type="submit" class="btn btn-lg btn-primary">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Log in
                    </button>
                </div>
                <div class="text-center login-field">
                    <p class="mb-2">
                        <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    </p>
                    <p class="mb-0">
                        <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register as a new user</a>
                    </p>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var btn = document.getElementById('loginPasswordToggle');
            var inp = document.querySelector('input[name="Input.Password"]');
            if (!btn || !inp) return;
            btn.addEventListener('click', function () {
                var show = inp.getAttribute('type') !== 'text';
                inp.setAttribute('type', show ? 'text' : 'password');
                btn.setAttribute('aria-pressed', show ? 'true' : 'false');
                btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                btn.setAttribute('title', show ? 'Hide password' : 'Show password');
                btn.querySelector('i').className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
            });
        })();
    </script>
}
