@model ExpenseTracker.Models.Domain.Goal

@*
    Presentation only. The form still posts Name, TargetAmount, Deadline and
    Description to the same Create action with the same binding and validation.
    The right-hand panel is a read-out of those four fields.
*@

@{ ViewData["Title"] = "New Goal"; }

<a asp-action="Index" class="ev-back"><i class="bi bi-arrow-left"></i> All goals</a>

<div class="page-head has-stroke">
    <div class="page-eyebrow">Saving goals</div>
    <h1>New goal</h1>
    <p class="page-lede">Name what you're saving for, and how much it takes.</p>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <form asp-action="Create" id="goalForm">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="xp-field">
                <label asp-for="Name" class="xp-label">Name</label>
                <input asp-for="Name" class="form-control" maxlength="100"
                       placeholder="e.g. Emergency fund" id="glName" autocomplete="off" autofocus />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            @* The number the whole page exists to capture. *@
            <div class="xp-field">
                <label asp-for="TargetAmount" class="xp-label">Target amount</label>
                <div class="xp-money is-lg" id="glMoney">
                    <span class="xp-money-prefix" aria-hidden="true">&#8377;</span>
                    <input asp-for="TargetAmount" type="number" step="0.01" min="0"
                           placeholder="0.00" id="glTarget" autocomplete="off" />
                </div>
                @* Indian grouping shown as a read-back rather than typed into the
                   field — reformatting a number input mid-keystroke breaks it. *@
                <div class="xp-hint" id="glTargetEcho">Set the total amount you want to reach.</div>
                <span asp-validation-for="TargetAmount" class="text-danger"></span>
            </div>

            <div class="xp-field">
                <label asp-for="Deadline" class="xp-label is-optional">Deadline <em>(optional)</em></label>
                <input asp-for="Deadline" type="date" class="form-control" id="glDeadline" />
                <div class="xp-hint" id="glDeadlineEcho">Helps you track whether you're on pace.</div>
                <span asp-validation-for="Deadline" class="text-danger"></span>
            </div>

            <div class="xp-field">
                <label asp-for="Description" class="xp-label is-optional">Why this goal matters <em>(optional)</em></label>
                <textarea asp-for="Description" class="form-control" rows="3" maxlength="500"
                          id="glWhy" placeholder="e.g. Build financial security and cover unexpected expenses."></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <hr class="hairline my-4" />

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button type="submit" class="btn btn-primary btn-lg gl-submit">Create goal</button>
                <a asp-action="Index" class="btn btn-link tfr-cancel">Cancel</a>
            </div>
        </form>
    </div>

    <div class="col-lg-5 d-none d-lg-block">
        <aside class="glc-panel" id="glPreview" aria-label="Goal preview" aria-live="polite">
            <div class="glc-panel-eyebrow">Your new goal</div>

            @* An empty ring: a new goal starts at 0%, and saying so honestly is the
               point of the panel. *@
            <div class="glc-ring" aria-hidden="true">
                <svg viewBox="0 0 120 120">
                    <circle class="glc-ring-track" cx="60" cy="60" r="52"></circle>
                    <circle class="glc-ring-val" cx="60" cy="60" r="52"></circle>
                </svg>
                <div class="glc-ring-center">
                    <span class="glc-ring-pct">0<span class="u">%</span></span>
                    <span class="glc-ring-lbl">funded</span>
                </div>
            </div>

            <h2 class="glc-panel-title" id="glPvName">Your goal</h2>
            <div class="glc-panel-amount" id="glPvAmount">&#8377;0<span class="of"> target</span></div>
            <div class="glc-panel-deadline" id="glPvDeadline">No deadline set</div>

            <p class="glc-panel-why" id="glPvWhy" hidden></p>

            <p class="glc-panel-quote">
                &ldquo;Small contributions today create financial freedom tomorrow.&rdquo;
            </p>
        </aside>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Display only. Reads the four fields and mirrors them into the panel.
        (function () {
            var MONTHS = ['January','February','March','April','May','June',
                          'July','August','September','October','November','December'];
            var $ = function (id) { return document.getElementById(id); };
            var name = $('glName'), target = $('glTarget'), deadline = $('glDeadline'), why = $('glWhy');

            function money(n) {
                if (!isFinite(n) || n <= 0) return '₹0';
                try {
                    return n.toLocaleString('en-IN', { style: 'currency', currency: 'INR',
                        minimumFractionDigits: 0, maximumFractionDigits: 0 }).replace(/\s/g, '');
                } catch (_) { return '₹' + Math.round(n); }
            }
            function longDate(v) {
                var p = (v || '').split('-');
                if (p.length !== 3) return null;
                var m = parseInt(p[1], 10);
                if (!MONTHS[m - 1]) return null;
                return { text: String(parseInt(p[2], 10)).padStart(2, '0') + ' ' + MONTHS[m - 1] + ' ' + p[0],
                         date: new Date(+p[0], m - 1, +p[2]) };
            }

            function sync() {
                var typed = (name.value || '').trim();
                $('glPvName').textContent = typed || 'Your goal';
                $('glPvName').classList.toggle('is-empty', typed.length === 0);

                var amt = parseFloat(target.value);
                var has = isFinite(amt) && amt > 0;
                $('glPvAmount').innerHTML = (has ? money(amt) : '₹0') + '<span class="of"> target</span>';
                $('glPvAmount').classList.toggle('is-empty', !has);
                // Indian grouping, read back rather than typed into the field.
                $('glTargetEcho').textContent = has
                    ? money(amt) + ' — the total you want to reach.'
                    : 'Set the total amount you want to reach.';

                var d = longDate(deadline.value);
                if (d) {
                    var days = Math.round((d.date - new Date(new Date().toDateString())) / 86400000);
                    $('glPvDeadline').textContent = 'By ' + d.text;
                    $('glDeadlineEcho').textContent = days >= 0
                        ? days + ' day' + (days === 1 ? '' : 's') + " from today — helps you track whether you're on pace."
                        : 'That date has already passed.';
                } else {
                    $('glPvDeadline').textContent = 'No deadline set';
                    $('glDeadlineEcho').textContent = "Helps you track whether you're on pace.";
                }

                var reason = (why.value || '').trim();
                $('glPvWhy').textContent = reason;
                $('glPvWhy').hidden = reason.length === 0;
            }

            [name, target, deadline, why].forEach(function (el) {
                el.addEventListener('input', sync);
                el.addEventListener('change', sync);
            });
            sync();
        })();
    </script>
}
