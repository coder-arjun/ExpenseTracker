@model ExpenseTracker.Models.Domain.GoalContribution

@{
    ViewData["Title"] = "Contribute";
    var total = (decimal)(ViewData["CurrentTotal"] ?? 0m);
    var INR = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
}

<div class="page-header">
    <h1><i class="bi bi-plus-circle me-2"></i>Contribute to Goal</h1>
    <p><a asp-action="Index" class="text-decoration-none">Goals</a> / Contribute</p>
</div>

<div class="row"><div class="col-md-6"><div class="card"><div class="card-body">
    <p class="text-muted">Current total: <strong>@total.ToString("C0", INR)</strong></p>
    <form asp-action="Contribute" asp-route-id="@Model.GoalId">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Amount" class="form-label">Amount (₹)</label>
            <input asp-for="Amount" class="form-control" type="number" step="0.01" autofocus />
            <span asp-validation-for="Amount" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Date" class="form-label"></label>
            <input asp-for="Date" type="date" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Note" class="form-label">Note <span class="text-muted">(optional)</span></label>
            <input asp-for="Note" class="form-control" maxlength="200" />
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Add</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
