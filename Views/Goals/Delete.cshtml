@model ExpenseTracker.Models.Domain.Goal

@{ ViewData["Title"] = "Delete Goal"; }

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Delete goal</div>
    <h1><i class="bi bi-trash me-2"></i>Delete Goal</h1>
    <p><a asp-action="Index" class="text-decoration-none">GOALS</a> / DELETE</p>
</div>

<div class="row"><div class="col-md-6">
    <div class="delete-warning mb-3">
        <i class="bi bi-exclamation-triangle me-2"></i>
        Delete this goal and all its contribution history? This action cannot be undone.
    </div>
    <div class="card"><div class="card-body">
        <dl class="row mb-3">
            <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
            <dt class="col-sm-4">Target</dt><dd class="col-sm-8 text-tabular t-balance">@Model.TargetAmount.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</dd>
            <dt class="col-sm-4">Deadline</dt><dd class="col-sm-8 folio">@(Model.Deadline?.ToString("dd MMM yyyy") ?? "—")</dd>
        </dl>
        <form asp-action="Delete">
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </form>
    </div></div>
</div></div>
