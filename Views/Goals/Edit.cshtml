@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.Goal

@{ ViewData["Title"] = "Edit Goal"; }

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Edit goal</div>
    <h1><i class="bi bi-pencil me-2"></i>Edit Goal</h1>
    <p><a asp-action="Index" class="text-decoration-none">GOALS</a> / EDIT</p>
</div>

<div class="row"><div class="col-md-6"><div class="card"><div class="card-body">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="100" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="TargetAmount" class="form-label">Target</label>
            <div class="input-currency">
                <input asp-for="TargetAmount" class="form-control" type="number" step="0.01" />
            </div>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Deadline" class="form-label">Deadline</label>
            <input asp-for="Deadline" type="date" class="form-control" />
        </div>
        <div class="form-group mb-3">
            <label asp-for="Description" class="form-label"></label>
            <textarea asp-for="Description" class="form-control" rows="2" maxlength="500"></textarea>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-select">
                @foreach (var s in Enum.GetValues<GoalStatus>())
                {
                    <option value="@s" selected="@(Model.Status == s ? "selected" : null)">@s</option>
                }
            </select>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
