@using Microsoft.AspNetCore.Mvc.Rendering
@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.RecurringRule

@{
    ViewData["Title"] = "New Recurring Rule";
    var expCats = (SelectList)ViewData["ExpenseCategories"]!;
    var incCats = (SelectList)ViewData["IncomeCategories"]!;
    var accs = (SelectList)ViewData["Accounts"]!;
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Standing orders</div>
    <h1><i class="bi bi-arrow-repeat me-2"></i>New Recurring Rule</h1>
    <p><a asp-action="Index" class="text-decoration-none">Recurring</a> / New</p>
</div>

<div class="row"><div class="col-md-8"><div class="card"><div class="card-body">
    <form asp-action="Create" id="ruleForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="100" placeholder="e.g. House rent" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select" id="typeSelect">
                    @foreach (var t in Enum.GetValues<RecurringType>())
                    {
                        <option value="@t" selected="@(Model.Type == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Amount" class="form-label">Amount</label>
                <div class="input-currency">
                    <input asp-for="Amount" type="number" step="0.01" class="form-control" />
                </div>
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label class="form-label">Day of month</label>
                <input asp-for="DayOfMonth" type="number" min="1" max="28" class="form-control" />
                <div class="form-text">1–28 (avoids Feb edge cases)</div>
            </div>
            <div class="col-md-6" id="expenseFields">
                <label asp-for="CategoryId" class="form-label">Expense category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="@expCats">
                    <option value="">— pick —</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="col-md-6" id="incomeFields">
                <label asp-for="Source" class="form-label">Income source</label>
                <input asp-for="Source" class="form-control" placeholder="e.g. Salary" />
                <span asp-validation-for="Source" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="AccountId" class="form-label">Account <span class="text-muted">(optional)</span></label>
                <select asp-for="AccountId" class="form-select" asp-items="@accs">
                    <option value="">— none —</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label">Description / note</label>
                <input asp-for="Description" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label">End date <span class="text-muted">(optional)</span></label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active immediately</label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Show Category vs Source field based on Type
        function syncTypeFields() {
            var t = document.getElementById('typeSelect').value;
            document.getElementById('expenseFields').style.display = (t === 'Expense') ? '' : 'none';
            document.getElementById('incomeFields').style.display  = (t === 'Income')  ? '' : 'none';
        }
        document.getElementById('typeSelect').addEventListener('change', syncTypeFields);
        syncTypeFields();
    </script>
}
