@model IEnumerable<ExpenseTracker.Models.Domain.RecurringRule>

@{
    ViewData["Title"] = "Recurring";
    var INR = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <h1><i class="bi bi-arrow-repeat me-2"></i>Recurring</h1>
        <p>Scheduled transactions that auto-post on their due date.</p>
    </div>
    <div>
        <form asp-action="RunNow" method="post" class="d-inline">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary" title="Catch up any due rules right now">
                <i class="bi bi-lightning-charge me-1"></i>Run Now
            </button>
        </form>
        <a asp-action="Create" class="btn btn-primary ms-1">
            <i class="bi bi-plus-circle me-1"></i>New Rule
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty-state">
        <i class="bi bi-arrow-repeat"></i>
        <p>No recurring rules yet. Add one for your rent, EMI, salary, or subscriptions.</p>
    </div></div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead><tr>
                <th>Name</th><th>Type</th><th>Amount</th><th>Category / Source</th>
                <th>Account</th><th>Schedule</th><th>Next due</th><th>Status</th><th>Actions</th>
            </tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr class="@(r.IsActive ? "" : "text-muted")">
                        <td class="fw-semibold">@r.Name</td>
                        <td>
                            @if (r.Type == ExpenseTracker.Models.Domain.RecurringType.Expense)
                            { <span class="badge bg-danger-subtle text-danger">Expense</span> }
                            else
                            { <span class="badge bg-success-subtle text-success">Income</span> }
                        </td>
                        <td>@r.Amount.ToString("C0", INR)</td>
                        <td>@(r.Category?.Name ?? r.Source ?? "—")</td>
                        <td>@(r.Account?.Name ?? "—")</td>
                        <td>Monthly · day @r.DayOfMonth</td>
                        <td>@r.NextDueDate.ToString("yyyy-MM-dd")</td>
                        <td>
                            @if (r.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-secondary">Paused</span> }
                        </td>
                        <td>
                            <form asp-action="Toggle" asp-route-id="@r.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(r.IsActive ? "Pause" : "Resume")">
                                    <i class="bi @(r.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
