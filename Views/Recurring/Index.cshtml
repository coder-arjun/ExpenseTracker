@model IEnumerable<ExpenseTracker.Models.Domain.RecurringRule>

@{
    ViewData["Title"] = "Recurring";
    var INR = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mb-4">
    <div class="page-header mb-0">
        <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Standing orders</div>
        <h1><i class="bi bi-arrow-repeat me-2"></i>Recurring</h1>
        <p>SCHEDULED ENTRIES THAT AUTO-POST ON THEIR DUE DATE</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-action="RunNow" method="post" class="flex-fill flex-sm-grow-0 m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary w-100" title="Catch up any due rules right now">
                <i class="bi bi-lightning-charge me-1"></i>Run Now
            </button>
        </form>
        <a asp-action="Create" class="btn btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-circle me-1"></i>New Rule
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-arrow-repeat"></i></div>
        <div class="es-title">No recurring rules yet</div>
        <p class="es-body">Add a standing order for your rent, EMI, salary, or subscriptions and let the ledger post it on schedule.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Rule</a>
    </div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <table class="table table-hover table-stack mb-0">
            <thead><tr>
                <th>Name</th><th>Type</th><th class="text-end">Amount</th><th>Category / Source</th>
                <th>Account</th><th>Schedule</th><th>Next due</th><th>Status</th><th>Actions</th>
            </tr></thead>
            <tbody>
                @foreach (var r in Model)
                {
                    var isExpense = r.Type == ExpenseTracker.Models.Domain.RecurringType.Expense;
                    var amountClass = isExpense ? "t-expense" : "t-income";
                    var amountSign = isExpense ? "&minus;" : "+";
                    <tr class="@(r.IsActive ? "" : "text-muted")">
                        <td data-label="Name" class="fw-semibold">@r.Name</td>
                        <td data-label="Type">
                            @if (isExpense)
                            { <span class="badge bg-danger-subtle text-danger">Expense</span> }
                            else
                            { <span class="badge bg-success-subtle text-success">Income</span> }
                        </td>
                        <td data-label="Amount" class="text-end fw-semibold text-tabular @amountClass">@Html.Raw(amountSign)@r.Amount.ToString("C0", INR)</td>
                        <td data-label="Category / Source">@(r.Category?.Name ?? r.Source ?? "—")</td>
                        <td data-label="Account">@(r.Account?.Name ?? "—")</td>
                        <td data-label="Schedule">Monthly &middot; day @r.DayOfMonth</td>
                        <td data-label="Next due" class="folio">@r.NextDueDate.ToString("dd MMM yyyy")</td>
                        <td data-label="Status">
                            @if (r.IsActive)
                            { <span class="badge bg-success">Active</span> }
                            else
                            { <span class="badge bg-secondary">Paused</span> }
                        </td>
                        <td data-label="Actions">
                            <form asp-action="Toggle" asp-route-id="@r.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(r.IsActive ? "Pause" : "Resume")">
                                    <i class="bi @(r.IsActive ? "bi-pause-fill" : "bi-play-fill")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}
