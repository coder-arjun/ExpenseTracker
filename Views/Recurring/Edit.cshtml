@using Microsoft.AspNetCore.Mvc.Rendering
@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.RecurringRule

@{
    ViewData["Title"] = "Edit Recurring Rule";
    var expCats = (SelectList)ViewData["ExpenseCategories"]!;
    var incCats = (SelectList)ViewData["IncomeCategories"]!;
    var accs = (SelectList)ViewData["Accounts"]!;
}

<div class="page-header">
    <h1><i class="bi bi-pencil me-2"></i>Edit Recurring Rule</h1>
    <p><a asp-action="Index" class="text-decoration-none">Recurring</a> / Edit</p>
</div>

<div class="row"><div class="col-md-8"><div class="card"><div class="card-body">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" maxlength="100" />
            </div>
            <div class="col-md-6">
                <label asp-for="Type" class="form-label"></label>
                <select asp-for="Type" class="form-select" id="typeSelect">
                    @foreach (var t in Enum.GetValues<RecurringType>())
                    {
                        <option value="@t" selected="@(Model.Type == t ? "selected" : null)">@t</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Amount" class="form-label">Amount (₹)</label>
                <input asp-for="Amount" type="number" step="0.01" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Day of month</label>
                <input asp-for="DayOfMonth" type="number" min="1" max="28" class="form-control" />
            </div>
            <div class="col-md-6" id="expenseFields">
                <label asp-for="CategoryId" class="form-label">Expense category</label>
                <select asp-for="CategoryId" class="form-select" asp-items="@expCats">
                    <option value="">— pick —</option>
                </select>
            </div>
            <div class="col-md-6" id="incomeFields">
                <label asp-for="Source" class="form-label">Income source</label>
                <input asp-for="Source" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="AccountId" class="form-label">Account</label>
                <select asp-for="AccountId" class="form-select" asp-items="@accs">
                    <option value="">— none —</option>
                </select>
            </div>
            <div class="col-md-6">
                <label asp-for="Description" class="form-label">Description / note</label>
                <input asp-for="Description" class="form-control" maxlength="200" />
            </div>
            <div class="col-md-6">
                <label asp-for="StartDate" class="form-label"></label>
                <input asp-for="StartDate" type="date" class="form-control" />
            </div>
            <div class="col-md-6">
                <label asp-for="EndDate" class="form-label">End date</label>
                <input asp-for="EndDate" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <div class="form-check">
                    <input asp-for="IsActive" class="form-check-input" />
                    <label asp-for="IsActive" class="form-check-label">Active</label>
                </div>
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        function syncTypeFields() {
            var t = document.getElementById('typeSelect').value;
            document.getElementById('expenseFields').style.display = (t === 'Expense') ? '' : 'none';
            document.getElementById('incomeFields').style.display  = (t === 'Income')  ? '' : 'none';
        }
        document.getElementById('typeSelect').addEventListener('change', syncTypeFields);
        syncTypeFields();
    </script>
}
