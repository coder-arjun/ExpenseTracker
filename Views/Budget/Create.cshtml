@using Microsoft.AspNetCore.Mvc.Rendering
@model ExpenseTracker.Models.Domain.Budget

@{
    ViewData["Title"] = "Add Budget";
    var yearMonth = ViewData["YearMonth"] as string ?? DateTime.Now.ToString("yyyy-MM");
    var categories = (SelectList)ViewData["Categories"]!;
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Budget ledger</div>
    <h1><i class="bi bi-bullseye me-2"></i>Add Budget</h1>
    <p class="text-uppercase">Set a spending limit for the month</p>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="card create-form-card" style="border-top-color: #1565c0;">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@categories">
                            <option value="">Overall (All Categories)</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="YearMonth" class="form-label">Month</label>
                        <input asp-for="YearMonth" type="month" class="form-control" value="@yearMonth" />
                        <span asp-validation-for="YearMonth" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
                        <a asp-action="Index" asp-route-yearMonth="@yearMonth" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
        <div class="create-illustration illus-budget">
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <span class="illus-particle"><i class="bi bi-clipboard-data"></i></span>
            <span class="illus-particle"><i class="bi bi-pie-chart"></i></span>
            <span class="illus-particle"><i class="bi bi-calculator"></i></span>
            <span class="illus-particle"><i class="bi bi-bar-chart-line"></i></span>
            <span class="illus-particle"><i class="bi bi-speedometer2"></i></span>
            <i class="bi bi-bullseye illus-icon"></i>
            <div class="illus-title">Set Your Limits</div>
            <div class="illus-subtitle">Define spending limits to stay on track and avoid overspending.</div>
            <div class="create-tip">
                <i class="bi bi-lightbulb-fill"></i> Tip: You'll get alerts when spending reaches 80% of budget.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
