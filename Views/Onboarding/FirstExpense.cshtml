@model ExpenseTracker.Models.Domain.Expense

@{
    ViewData["Title"] = "Your first expense";
    var cats = (dynamic)ViewData["Categories"]!;
}

<div class="onboarding-wrap">
    <div class="onboarding-progress" aria-label="Step 2 of 3">
        <div class="onboarding-dot done"></div>
        <div class="onboarding-line done"></div>
        <div class="onboarding-dot active"></div>
        <div class="onboarding-line"></div>
        <div class="onboarding-dot"></div>
    </div>

    <div class="onboarding-card">
        <div class="onboarding-emoji" aria-hidden="true">💸</div>
        <div class="page-header">
            <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> First entry</div>
            <h1>Log your first expense</h1>
            <p>Post your opening debit</p>
        </div>
        <p class="lead text-muted">Even a small one. The point is to feel the muscle once — then daily logging becomes automatic.</p>

        <form asp-action="FirstExpense" method="post" class="onboarding-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Amount" class="form-label">Amount</label>
                    <div class="input-currency">
                        <input asp-for="Amount" class="form-control form-control-lg text-tabular" placeholder="e.g. 250" autofocus />
                    </div>
                    <span asp-validation-for="Amount" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Date" class="form-label">Date</label>
                    <input asp-for="Date" type="date" class="form-control form-control-lg" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="CategoryId" class="form-label">Category</label>
                    <select asp-for="CategoryId" class="form-select form-select-lg">
                        <option value="">— Select —</option>
                        @foreach (var c in cats)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <span asp-validation-for="CategoryId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Description" class="form-label">Description <span class="text-muted">(optional)</span></label>
                    <input asp-for="Description" class="form-control form-control-lg" placeholder="e.g. Morning coffee" />
                </div>
            </div>

            <div class="onboarding-actions mt-4">
                <button type="submit" class="btn btn-primary btn-lg">
                    Save and continue <i class="bi bi-arrow-right ms-1"></i>
                </button>
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg">Skip — go to Dashboard</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
