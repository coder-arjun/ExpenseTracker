@using System.Globalization
@using ExpenseTracker.Models.ViewModel
@using ExpenseTracker.Services
@model ExpenseTracker.Models.ViewModel.EventDetailsViewModel

@*
    The live region of the event workspace. Re-rendered wholesale by /Events/Board/{id}
    after every mutation, so Razor stays the single source of truth — no templating in JS.

    Money hierarchy, deliberately three-tier:
      hero / totals   exact, no decimals   ₹3,61,500
      figures & lines compact              ₹12.40L      (exact in the title attribute)
      entries         exact with decimals  ₹1,00,000.00

    Every control degrades: each is a real <form> posting to a real MVC action.
*@

@{
    var inr = CultureInfo.GetCultureInfo("en-IN");
    var t = Model.Totals;
    var flash = ViewData["Flash"] as string;

    var healthSay = !t.HasAllocation
        ? "Allocate amounts to your sub-events and this becomes a live plan."
        : t.IsOverBudget
            ? $"You've exceeded your plan by {MoneyFormat.Compact(Math.Abs(t.Available))}."
            : t.RawPercent >= 85m
                ? $"{MoneyFormat.Percent(t.RawPercent)} of your budget is already committed."
                : $"You're {MoneyFormat.Compact(t.Available)} under plan.";
}

<div class="ev-board" data-ev-flash="@flash" data-event-id="@Model.Event.Id"
     data-ev-available="@t.Available.ToString(CultureInfo.InvariantCulture)">

    @* ── The hero: what's left ─────────────────────────────────────── *@
    <section class="ev-section" aria-label="Budget position">
        <div class="ev-hero">
            <span class="ev-display ev-hero-figure @(t.IsOverBudget ? "is-over" : "")"
                  data-ev-hero title="@MoneyFormat.Full(Math.Abs(t.Available))">@MoneyFormat.Exact(Math.Abs(t.Available))</span>
            <div class="ev-eyebrow ev-hero-caption">@(t.IsOverBudget ? "Over budget" : "Still available")</div>
            @if (t.HasAllocation)
            {
                <div class="ev-meta ev-hero-exact">@MoneyFormat.Percent(t.RawPercent) of planned budget used</div>
            }
        </div>

        @if (t.HasAllocation)
        {
            <div class="ev-health-block">
                <span class="ev-health @t.HealthClass">@t.HealthLabel</span>
                <p class="ev-health-say">@healthSay</p>
            </div>
        }

        <partial name="_Meter" model="@(new MeterModel(t,
            Hint: t.HasCommitted
                ? $"{MoneyFormat.Exact(t.Paid)} paid · {MoneyFormat.Exact(t.Committed)} committed · {MoneyFormat.Percent(t.RawPercent)} of {MoneyFormat.Exact(t.Allocated)}"
                : $"{MoneyFormat.Exact(t.Paid)} paid · {MoneyFormat.Percent(t.RawPercent)} of {MoneyFormat.Exact(t.Allocated)}"))" />

        <div class="ev-figures">
            <div>
                <span class="ev-display ev-figure-v" title="@MoneyFormat.Full(t.Allocated)">@MoneyFormat.Compact(t.Allocated)</span>
                <div class="ev-meta ev-figure-l">Allocated</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v t-out" title="@MoneyFormat.Full(t.Paid)">@MoneyFormat.Compact(t.Paid)</span>
                <div class="ev-meta ev-figure-l">Paid</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v t-soft" title="@MoneyFormat.Full(t.Committed)">@MoneyFormat.Compact(t.Committed)</span>
                <div class="ev-meta ev-figure-l">Committed</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v t-in" title="@MoneyFormat.Full(t.Received)">@MoneyFormat.Compact(t.Received)</span>
                <div class="ev-meta ev-figure-l">Received</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v" title="@MoneyFormat.Full(t.NetOutlay)">@MoneyFormat.Compact(t.NetOutlay)</span>
                <div class="ev-meta ev-figure-l">Net outlay</div>
            </div>
        </div>
    </section>

    @* ── Sub-events ────────────────────────────────────────────────── *@
    <section class="ev-section" aria-label="Sub-events">
        <div class="ev-section-head">
            <div>
                <h2>Sub-events</h2>
                <div class="ev-meta">
                    @if (t.SubEventCount == 0)
                    {
                        <text>Nothing broken out yet</text>
                    }
                    else
                    {
                        <text>@t.SubEventCount categor@(t.SubEventCount == 1 ? "y" : "ies")</text>
                        @if (t.SpendCount > 0)
                        {
                            <span class="ev-sep">·</span>
                            <text>@t.SpendCount entr@(t.SpendCount == 1 ? "y" : "ies")</text>
                        }
                    }
                </div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                @if (t.SubEventCount > 0)
                {
                    <button type="button" class="btn btn-sm btn-primary" data-ev-open="spend">
                        <i class="bi bi-plus-lg me-1"></i>Log spend
                    </button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" data-ev-open="subevent">
                    <i class="bi bi-plus-lg me-1"></i>Add sub-event
                </button>
            </div>
        </div>

        @if (Model.SubEvents.Count == 0)
        {
            <div class="ev-empty">
                <span class="ev-empty-mark"><i class="bi bi-signpost-split" aria-hidden="true"></i></span>
                <h3>Break the event into parts</h3>
                <p>
                    Add the things you actually pay for — <em>Wedding hall</em>, <em>Stage decoration</em>,
                    <em>Ornaments</em> — then give each one a budget.
                </p>
                <button type="button" class="btn btn-primary" data-ev-open="subevent">
                    <i class="bi bi-plus-lg me-1"></i>Add the first sub-event
                </button>
            </div>
        }
        else if (!t.HasAllocation)
        {
            <div class="ev-empty">
                <span class="ev-empty-mark"><i class="bi bi-sliders" aria-hidden="true"></i></span>
                <h3>No budget allocated yet</h3>
                <p>
                    You have @t.SubEventCount sub-event@(t.SubEventCount == 1 ? "" : "s") ready. Start assigning
                    amounts to see your event plan come to life.
                </p>
                <button type="button" class="btn btn-primary" data-ev-open="allocate">
                    <i class="bi bi-sliders me-1"></i>Allocate budget
                </button>
            </div>
        }

        @if (Model.SubEvents.Count > 0)
        {
            <div class="ev-lines">
                @foreach (var s in Model.SubEvents)
                {
                    <details class="ev-line @(s.IsOverBudget ? "is-over" : "")"
                             data-subevent-id="@s.Id" data-subevent-name="@s.Name">
                        <summary>
                            @if (s.IsOverBudget)
                            {
                                <span class="ev-eyebrow ev-line-flag">Over budget</span>
                            }
                            <span class="ev-line-name">@s.Name</span>
                            <span class="ev-meta ev-line-sub">
                                @if (s.HasAllocation)
                                {
                                    <span title="@MoneyFormat.Full(s.Allocated)">@MoneyFormat.Compact(s.Allocated) planned</span>
                                    <span class="ev-sep">·</span>
                                    <text>@MoneyFormat.Percent(s.RawPercent) used</text>
                                }
                                else
                                {
                                    <text>No budget set</text>
                                }
                                @if (s.HasCommitted)
                                {
                                    <span class="ev-sep">·</span>
                                    <span title="@MoneyFormat.Full(s.Committed)">@MoneyFormat.Compact(s.Committed) committed</span>
                                }
                            </span>
                            <span class="ev-line-result">
                                <span class="ev-line-var @(s.IsOverBudget ? "is-over" : "")"
                                      title="@MoneyFormat.FullSigned(s.Available)">@MoneyFormat.CompactSigned(s.Available)</span>
                                <span class="ev-line-spent" title="@MoneyFormat.Full(s.Actual)">@MoneyFormat.Compact(s.Actual) spent</span>
                            </span>
                            @if (s.HasAllocation || s.Actual > 0m)
                            {
                                <partial name="_Meter" model="@(new MeterModel(s))" />
                            }
                            <i class="bi bi-chevron-down ev-line-caret" aria-hidden="true"></i>
                        </summary>

                        <div class="ev-line-body">
                            <div class="ev-line-tools">
                                <form asp-controller="EventLedger" asp-action="UpdateSubEvent" method="post" class="ev-inline-form js-ev-form">
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <label class="ev-field">
                                        <span>Name</span>
                                        <input type="text" name="name" value="@s.Name" maxlength="100" required class="form-control form-control-sm" />
                                    </label>
                                    <label class="ev-field ev-field-amount">
                                        <span>Allocated</span>
                                        <input type="number" name="allocated" value="@s.Allocated.ToString(CultureInfo.InvariantCulture)"
                                               min="0" step="0.01" inputmode="decimal" class="form-control form-control-sm" />
                                    </label>
                                    <label class="ev-field">
                                        <span>Note</span>
                                        <input type="text" name="note" value="@s.Note" maxlength="200" class="form-control form-control-sm" placeholder="optional" />
                                    </label>
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-check-lg me-1"></i>Save
                                    </button>
                                </form>

                                <div class="ev-line-actions">
                                    <button type="button" class="btn btn-sm btn-primary"
                                            data-ev-open="spend" data-sub-id="@s.Id" data-sub-name="@s.Name">
                                        <i class="bi bi-plus-lg me-1"></i>Log spend
                                    </button>
                                    <form asp-controller="EventLedger" asp-action="DeleteSubEvent" method="post"
                                          class="js-ev-form d-inline"
                                          data-confirm="Delete '@s.Name'@(s.Spends.Count > 0 ? $" and its {s.Spends.Count} entries" : "")? This can't be undone.">
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                                    </form>
                                </div>
                            </div>

                            @if (s.Spends.Count == 0)
                            {
                                <p class="ev-meta">Nothing logged against this sub-event yet.</p>
                            }
                            else
                            {
                                <ul class="ev-entries">
                                    @foreach (var sp in s.Spends)
                                    {
                                        <li class="ev-entry @(sp.IsCommitted ? "is-committed" : "")">
                                            <span class="ev-entry-date">@sp.Date.ToString("d MMM", inr)</span>
                                            <span class="ev-entry-who">
                                                @(string.IsNullOrEmpty(sp.PaidTo) ? (sp.IsCommitted ? "Commitment" : "Payment") : sp.PaidTo)
                                                @if (sp.IsCommitted)
                                                {
                                                    <span class="ev-tag">Committed</span>
                                                }
                                            </span>
                                            @if (!string.IsNullOrEmpty(sp.Note))
                                            {
                                                <span class="ev-entry-note">@sp.Note</span>
                                            }
                                            <span class="ev-entry-amt">@MoneyFormat.Full(sp.Amount)</span>
                                            <span class="ev-entry-act">
                                                @if (sp.IsCommitted)
                                                {
                                                    <form asp-controller="EventLedger" asp-action="MarkPaid" method="post" class="js-ev-form d-inline">
                                                        <input type="hidden" name="id" value="@sp.Id" />
                                                        <button type="submit" class="btn btn-sm btn-link ev-icon-btn" title="Mark as paid" aria-label="Mark as paid">
                                                            <i class="bi bi-check2-circle"></i>
                                                        </button>
                                                    </form>
                                                }
                                                <button type="button" class="btn btn-sm btn-link ev-icon-btn"
                                                        data-ev-open="edit-spend"
                                                        data-spend-id="@sp.Id"
                                                        data-amount="@sp.Amount.ToString(CultureInfo.InvariantCulture)"
                                                        data-date="@sp.Date.ToString("yyyy-MM-dd")"
                                                        data-paid-to="@sp.PaidTo"
                                                        data-note="@sp.Note"
                                                        data-status="@sp.Status"
                                                        aria-label="Edit this entry">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                <form asp-controller="EventLedger" asp-action="DeleteSpend" method="post"
                                                      class="js-ev-form d-inline" data-confirm="Delete this @MoneyFormat.Full(sp.Amount) entry?">
                                                    <input type="hidden" name="id" value="@sp.Id" />
                                                    <button type="submit" class="btn btn-sm btn-link ev-icon-btn" aria-label="Delete this entry">
                                                        <i class="bi bi-x-lg"></i>
                                                    </button>
                                                </form>
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </details>
                }
            </div>

            <div class="ev-lines-total">
                <span class="ev-meta">Total across @t.SubEventCount sub-event@(t.SubEventCount == 1 ? "" : "s")</span>
                <span class="v @(t.IsOverBudget ? "text-danger" : "")" title="@MoneyFormat.FullSigned(t.Available)">
                    @MoneyFormat.CompactSigned(t.Available)
                </span>
            </div>
        }
    </section>

    @* ── Money received: the total is the hero ─────────────────────── *@
    <section class="ev-section" aria-label="Money received">
        <div class="ev-section-head">
            <div>
                <h2>Money received</h2>
                <div class="ev-meta">Offsets the cost without touching your income ledger</div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary" data-ev-open="contribution">
                <i class="bi bi-plus-lg me-1"></i>Add contribution
            </button>
        </div>

        @if (Model.Contributions.Count == 0)
        {
            <div class="ev-empty">
                <span class="ev-empty-mark"><i class="bi bi-gift" aria-hidden="true"></i></span>
                <h3>Nothing received yet</h3>
                <p>Gifts, cash from relatives or a sponsor's share go here, and come off the event's net cost.</p>
                <button type="button" class="btn btn-outline-secondary" data-ev-open="contribution">
                    <i class="bi bi-plus-lg me-1"></i>Add a contribution
                </button>
            </div>
        }
        else
        {
            <div class="ev-received-hero">
                <span class="ev-display" title="@MoneyFormat.Full(t.Received)">@MoneyFormat.Exact(t.Received)</span>
                <div class="ev-meta ev-figure-l">
                    Total received
                    <span class="ev-sep">·</span>
                    @t.ContributionCount contribution@(t.ContributionCount == 1 ? "" : "s")
                </div>
            </div>

            <ul class="ev-gifts">
                @foreach (var c in Model.Contributions)
                {
                    <li class="ev-gift">
                        <span class="ev-gift-date">@c.Date.ToString("d MMM", inr)</span>
                        <span class="ev-gift-who">@(string.IsNullOrEmpty(c.FromWhom) ? "Contribution" : c.FromWhom)</span>
                        @if (!string.IsNullOrEmpty(c.Note))
                        {
                            <span class="ev-gift-note">@c.Note</span>
                        }
                        <span class="ev-gift-amt">+@MoneyFormat.Full(c.Amount)</span>
                        <span class="ev-gift-act">
                            <form asp-controller="EventLedger" asp-action="DeleteContribution" method="post"
                                  class="js-ev-form d-inline" data-confirm="Delete this @MoneyFormat.Full(c.Amount) contribution?">
                                <input type="hidden" name="id" value="@c.Id" />
                                <button type="submit" class="btn btn-sm btn-link ev-icon-btn" aria-label="Delete this contribution">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </span>
                    </li>
                }
            </ul>
        }
    </section>
</div>
