@using ExpenseTracker.Data
@model ExpenseTracker.Models.Domain.Event

@{
    ViewData["Title"] = "Delete Event";
    var subCount = (int)(ViewData["SubEventCount"] ?? 0);
    var spendCount = (int)(ViewData["SpendCount"] ?? 0);
    var contribCount = (int)(ViewData["ContributionCount"] ?? 0);
}

<div class="create-page-header">
    <i class="bi bi-exclamation-triangle header-icon"></i>
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Confirm removal</div>
    <h1>Delete Event</h1>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <div class="card create-form-card" style="border-top-color: #C20E3A;">
            <div class="card-body">
                <h2 class="h4 mb-3">
                    <i class="bi bi-@EventTemplates.Icon(Model.EventType) me-2"></i>@Model.Name
                </h2>

                <p class="mb-3">Deleting this event also removes everything inside it:</p>
                <ul class="ev-delete-list">
                    <li><strong>@subCount</strong> sub-event@(subCount == 1 ? "" : "s")</li>
                    <li><strong>@spendCount</strong> spend entr@(spendCount == 1 ? "y" : "ies")</li>
                    <li><strong>@contribCount</strong> contribution@(contribCount == 1 ? "" : "s")</li>
                </ul>

                <div class="alert alert-warning" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    This can't be undone. Your expenses, income and account balances are untouched —
                    event budgets are a separate ledger.
                </div>

                <form asp-action="Delete" method="post">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete permanently
                    </button>
                    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
