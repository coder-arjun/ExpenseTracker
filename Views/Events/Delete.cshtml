@using ExpenseTracker.Data
@model ExpenseTracker.Models.Domain.Event

@{
    ViewData["Title"] = "Delete event";
    var subCount = (int)(ViewData["SubEventCount"] ?? 0);
    var spendCount = (int)(ViewData["SpendCount"] ?? 0);
    var contribCount = (int)(ViewData["ContributionCount"] ?? 0);
}

<div class="ev-id" data-ev-type="@Model.EventType" style="max-width:40rem;">
    <a asp-action="Details" asp-route-id="@Model.Id" class="ev-back"><i class="bi bi-arrow-left"></i> Back to event</a>

    <header class="mb-4">
        <div class="ev-eyebrow">Confirm removal</div>
        <h1 class="ev-title mt-2" style="font-size:clamp(1.9rem,1.3rem+2.2vw,2.8rem);">
            <span class="ev-head-mark"><i class="bi bi-@EventTemplates.Icon(Model.EventType)" aria-hidden="true"></i></span>@Model.Name
        </h1>
    </header>

    <p class="ev-meta mb-3">Deleting this event also removes everything inside it:</p>
    <ul class="ev-delete-list">
        <li><span>Sub-events</span><strong>@subCount</strong></li>
        <li><span>Spend &amp; commitment entries</span><strong>@spendCount</strong></li>
        <li><span>Contributions</span><strong>@contribCount</strong></li>
    </ul>

    <p class="ev-meta mb-4">
        This can't be undone. Your expenses, income and account balances are untouched —
        events are a separate ledger.
    </p>

    <form asp-action="Delete" method="post" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete permanently</button>
        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
    </form>
</div>
