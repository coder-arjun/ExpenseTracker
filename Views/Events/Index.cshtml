@using System.Globalization
@using ExpenseTracker.Data
@using ExpenseTracker.Models.Domain
@using ExpenseTracker.Models.ViewModel
@using ExpenseTracker.Services
@model ExpenseTracker.Models.PaginatedList<ExpenseTracker.Models.ViewModel.EventIndexRow>

@{
    ViewData["Title"] = "Events";
    var inr = CultureInfo.GetCultureInfo("en-IN");

    var filter = (ViewData["Filter"] as string ?? "all").ToLowerInvariant();
    var counts = ViewData["Counts"] as EventFilterCounts ?? new EventFilterCounts();
    var anyEvents = (bool)(ViewData["AnyEvents"] ?? false);

    var pageAllocated = Model.Sum(r => r.Allocated);
    var pagePaid = Model.Sum(r => r.Paid);
    var pageCommitted = Model.Sum(r => r.Committed);
    var pageAvailable = pageAllocated - pagePaid - pageCommitted;

    var tabs = new (string Key, string Label, int Count)[]
    {
        ("all",       "All events", counts.All),
        ("upcoming",  "Upcoming",   counts.Upcoming),
        ("planning",  "Planning",   counts.Planning),
        ("active",    "Active",     counts.Active),
        ("completed", "Completed",  counts.Completed),
        ("archived",  "Archived",   counts.Archived),
    };
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="mb-1">Events</h1>
        <p class="ev-meta mb-0">Plan the money behind life's big moments.</p>
    </div>
    <div class="d-flex gap-2">
        @if (anyEvents)
        {
            <div class="btn-group flex-fill flex-sm-grow-0">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle w-100" data-bs-toggle="dropdown" aria-expanded="false">
                    Export
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" asp-action="Export" asp-route-format="xlsx">
                        <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Excel (.xlsx)
                    </a></li>
                    <li><a class="dropdown-item" asp-action="Export" asp-route-format="pdf">
                        <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>PDF
                    </a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" asp-action="Export" asp-route-format="csv">
                        <i class="bi bi-filetype-csv me-2 text-secondary"></i>CSV
                    </a></li>
                </ul>
            </div>
        }
        <a asp-action="Create" class="btn btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-lg me-1"></i>New event
        </a>
    </div>
</div>

@if (!anyEvents)
{
    <div class="ev-id ev-empty" data-ev-type="Wedding" style="max-width:38rem;">
        <span class="ev-empty-mark"><i class="bi bi-gem" aria-hidden="true"></i></span>
        <h3>No events yet</h3>
        <p>
            A wedding, a birthday, a house warming — anything with many moving parts and one
            budget. Break it into sub-events, allocate what you plan to spend, then track what
            actually goes out. Kept entirely separate from your everyday ledger.
        </p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Create your first event</a>
    </div>
}
else
{
    <nav class="ev-rail" aria-label="Filter events">
        @foreach (var tab in tabs)
        {
            <a asp-action="Index" asp-route-filter="@tab.Key" class="@(filter == tab.Key ? "is-active" : "")">
                @tab.Label<span class="n">@tab.Count</span>
            </a>
        }
    </nav>

    if (Model.Any())
    {
        <div class="ev-topline">
            <div>
                <span class="ev-display ev-figure-v" title="@MoneyFormat.Full(pageAllocated)">@MoneyFormat.Compact(pageAllocated)</span>
                <div class="ev-meta ev-figure-l">Allocated</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v t-out" title="@MoneyFormat.Full(pagePaid)">@MoneyFormat.Compact(pagePaid)</span>
                <div class="ev-meta ev-figure-l">Paid</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v t-soft" title="@MoneyFormat.Full(pageCommitted)">@MoneyFormat.Compact(pageCommitted)</span>
                <div class="ev-meta ev-figure-l">Committed</div>
            </div>
            <div>
                <span class="ev-display ev-figure-v @(pageAvailable < 0 ? "t-out" : "t-in")" title="@MoneyFormat.FullSigned(pageAvailable)">
                    @MoneyFormat.CompactSigned(pageAvailable)
                </span>
                <div class="ev-meta ev-figure-l">@(pageAvailable < 0 ? "Over plan" : "Still available")</div>
            </div>
        </div>

        <div class="ev-grid">
            @foreach (var e in Model)
            {
                @*
                    The card was a single <a>, so nothing else could live inside it —
                    a form nested in an anchor is invalid HTML. The whole card is still
                    one click target, via a stretched overlay on the name link, which
                    leaves room for a real status form on top of it.
                *@
                <article class="ev-card ev-id @(e.IsArchived ? "is-archived" : "")" data-ev-type="@e.EventType">
                    @*
                        The click target is a direct child of the card, not a link
                        nested in the heading: `.ev-card > * { z-index: 1 }` gives every
                        child its own stacking context, so an overlay inside the heading
                        could never paint above its siblings.
                    *@
                    <a class="ev-card-link" asp-action="Details" asp-route-id="@e.Id"
                       aria-label="Open @e.Name"><span class="visually-hidden">Open @e.Name</span></a>

                    <span class="ev-card-mark"><i class="bi bi-@EventTemplates.Icon(e.EventType)" aria-hidden="true"></i></span>

                    <h2 class="ev-title ev-card-name">@e.Name</h2>
                    <div class="ev-meta ev-card-when">
                        @if (e.EventDate.HasValue)
                        {
                            <text>@e.EventDate.Value.ToString("d MMM yyyy", inr)</text>
                            <span class="ev-sep">·</span>
                        }
                        <text>@e.Status</text>
                    </div>

                    <span class="ev-display ev-card-spent @(e.IsOverBudget ? "is-over" : "")"
                          title="@MoneyFormat.Full(e.Actual)">@MoneyFormat.Compact(e.Actual)</span>
                    <div class="ev-meta ev-card-of">
                        spent
                        @if (e.HasAllocation)
                        {
                            <span class="ev-sep">·</span>
                            <span title="@MoneyFormat.Full(e.Allocated)">of @MoneyFormat.Compact(e.Allocated)</span>
                        }
                    </div>

                    @if (e.HasAllocation || e.Actual > 0m)
                    {
                        <partial name="_Meter" model="@(new MeterModel(e))" />
                    }

                    <div class="ev-card-foot">
                        @if (e.HasAllocation)
                        {
                            <span class="ev-card-left @(e.IsOverBudget ? "is-over" : "")" title="@MoneyFormat.FullSigned(e.Available)">
                                @MoneyFormat.Compact(Math.Abs(e.Available)) @(e.IsOverBudget ? "over" : "remaining")
                            </span>
                        }
                        else
                        {
                            <span class="ev-meta">No budget set</span>
                        }
                        <span class="ev-meta">@e.SubEventCount sub-event@(e.SubEventCount == 1 ? "" : "s")</span>
                    </div>

                    @* Close, cancel or reopen without opening the event first. *@
                    <div class="dropdown ev-card-status">
                        <button type="button" class="btn btn-sm ev-card-status-btn"
                                data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"
                                aria-label="Change status of @e.Name" title="Change status">
                            <span class="ev-status-dot" data-status="@e.Status" aria-hidden="true"></span>
                            <span class="ev-card-status-label">@e.Status</span>
                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end ev-status-list">
                            <li><h6 class="dropdown-header">Move this event to</h6></li>
                            @foreach (var (value, label, icon) in new[]
                            {
                                (EventStatus.Planning,  "Planning",  "bi-pencil"),
                                (EventStatus.Active,    "Active",    "bi-play-circle"),
                                (EventStatus.Completed, "Completed", "bi-check2-circle"),
                                (EventStatus.Cancelled, "Cancelled", "bi-x-circle"),
                            })
                            {
                                <li>
                                    <form asp-action="SetStatus" asp-route-id="@e.Id" method="post">
                                        <input type="hidden" name="status" value="@value" />
                                        <input type="hidden" name="returnTo" value="index" />
                                        <input type="hidden" name="filter" value="@filter" />
                                        <button type="submit" class="dropdown-item @(e.Status == value ? "is-current" : "")"
                                                @(e.Status == value ? "aria-current=true" : "")>
                                            <i class="bi @icon" aria-hidden="true"></i>
                                            <span class="ev-status-opt"><span class="l">@label</span></span>
                                            @if (e.Status == value)
                                            {
                                                <i class="bi bi-check2 ev-status-tick" aria-hidden="true"></i>
                                            }
                                        </button>
                                    </form>
                                </li>
                            }
                        </ul>
                    </div>
                </article>
            }
        </div>

        ViewData["PageIndex"] = Model.PageIndex;
        ViewData["TotalPages"] = Model.TotalPages;
        ViewData["HasPreviousPage"] = Model.HasPreviousPage;
        ViewData["HasNextPage"] = Model.HasNextPage;

        <partial name="_PaginationPartial" />
    }
    else
    {
        <div class="ev-empty">
            <span class="ev-empty-mark"><i class="bi bi-funnel" aria-hidden="true"></i></span>
            <h3>Nothing in @tabs.First(t => t.Key == filter).Label.ToLowerInvariant()</h3>
            <p>No events match this view yet.</p>
            <a asp-action="Index" asp-route-filter="all" class="btn btn-outline-secondary">Show all events</a>
        </div>
    }
}
