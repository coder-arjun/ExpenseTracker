@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-exclamation-triangle"></i></div>
        <div class="es-title">Something went wrong</div>
        <p class="es-body">An error occurred while processing your request. The entry could not be posted to the ledger.</p>

        @if (Model.ShowRequestId)
        {
            <p class="es-body text-tabular"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }

        <div class="mt-4">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-house me-1"></i>Go to Dashboard
            </a>
        </div>
    </div>
</div>
