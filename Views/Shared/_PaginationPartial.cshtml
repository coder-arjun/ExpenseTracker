@{
    var pageIndex = (int)ViewData["PageIndex"]!;
    var totalPages = (int)ViewData["TotalPages"]!;
    var hasPreviousPage = (bool)ViewData["HasPreviousPage"]!;
    var hasNextPage = (bool)ViewData["HasNextPage"]!;

    // Build query string preserving filter params
    var filterType = ViewData["FilterType"]?.ToString();
    var selectedMonth = ViewData["SelectedMonth"]?.ToString();
    var selectedYear = ViewData["SelectedYear"]?.ToString();
    var startDate = ViewData["StartDate"]?.ToString();
    var endDate = ViewData["EndDate"]?.ToString();
    var selectedCategory = ViewData["SelectedCategory"]?.ToString();

    // Debts (Owed to Me) filters
    var person = ViewData["Person"]?.ToString();
    var direction = ViewData["Direction"]?.ToString();
    var showSettled = ViewData["ShowSettled"]?.ToString();

    // Windowed pagination: show at most 5 page numbers around the current page,
    // with first/last shortcuts + ellipses, plus Prev/Next. No long number runs.
    const int window = 5;
    var winStart = Math.Max(1, pageIndex - window / 2);
    var winEnd = Math.Min(totalPages, winStart + window - 1);
    winStart = Math.Max(1, winEnd - window + 1);

    string BuildPageUrl(int page)
    {
        var queryParams = new List<string> { $"page={page}" };
        if (!string.IsNullOrEmpty(filterType)) queryParams.Add($"filterType={filterType}");
        if (!string.IsNullOrEmpty(selectedMonth)) queryParams.Add($"selectedMonth={selectedMonth}");
        if (!string.IsNullOrEmpty(selectedYear)) queryParams.Add($"selectedYear={selectedYear}");
        if (!string.IsNullOrEmpty(startDate)) queryParams.Add($"startDate={startDate}");
        if (!string.IsNullOrEmpty(endDate)) queryParams.Add($"endDate={endDate}");
        if (!string.IsNullOrEmpty(selectedCategory)) queryParams.Add($"selectedCategory={selectedCategory}");
        if (!string.IsNullOrEmpty(person)) queryParams.Add($"person={Uri.EscapeDataString(person)}");
        if (!string.IsNullOrEmpty(direction)) queryParams.Add($"direction={direction}");
        if (string.Equals(showSettled, "True", StringComparison.OrdinalIgnoreCase)) queryParams.Add("showSettled=true");
        return "?" + string.Join("&", queryParams);
    }
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-3">
        <ul class="pagination justify-content-center align-items-center">
            <li class="page-item @(hasPreviousPage ? "" : "disabled")">
                <a class="page-link" href="@BuildPageUrl(pageIndex - 1)" aria-label="Previous page">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i><span class="d-none d-sm-inline ms-1">Prev</span>
                </a>
            </li>

            @if (winStart > 1)
            {
                <li class="page-item"><a class="page-link" href="@BuildPageUrl(1)">1</a></li>
                @if (winStart > 2)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
            }

            @for (int i = winStart; i <= winEnd; i++)
            {
                <li class="page-item @(i == pageIndex ? "active" : "")">
                    <a class="page-link" href="@BuildPageUrl(i)">@i</a>
                </li>
            }

            @if (winEnd < totalPages)
            {
                @if (winEnd < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                }
                <li class="page-item"><a class="page-link" href="@BuildPageUrl(totalPages)">@totalPages</a></li>
            }

            <li class="page-item @(hasNextPage ? "" : "disabled")">
                <a class="page-link" href="@BuildPageUrl(pageIndex + 1)" aria-label="Next page">
                    <span class="d-none d-sm-inline me-1">Next</span><i class="bi bi-chevron-right" aria-hidden="true"></i>
                </a>
            </li>
        </ul>
        <div class="text-center folio mt-2">Page @pageIndex of @totalPages</div>
    </nav>
}
