@{
    // Active-section highlighting. Presentation only — derived from the current route.
    var curCtrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var moneySection = new[] { "Expenses", "Incomes", "Accounts", "Transfers", "Debts", "Categories" };
    var planningSection = new[] { "Budget", "Savings", "Goals", "Events", "Recurring" };
    string Act(params string[] ctrls) => ctrls.Contains(curCtrl, StringComparer.OrdinalIgnoreCase) ? " active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <script>
        // Apply saved theme immediately to prevent flash of wrong theme.
        // Sets BOTH data-theme (custom) and data-bs-theme (Bootstrap 5.3 native)
        // so Bootstrap components flip automatically without an override avalanche.
        (function () {
            var t = localStorage.getItem('theme'); // 'light' | 'dark' | null (= system)
            var dark = t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches);
            var mode = dark ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', mode);
            document.documentElement.setAttribute('data-bs-theme', mode);
            document.documentElement.setAttribute('data-color-scheme', t || 'system');
        })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @* The Ledger: warm paper in light, espresso ink in dark. Red is the
       stamp/accent, never the chrome colour — so the OS title bar stays calm. *@
    <meta name="theme-color" content="#F8F7F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#14130E" media="(prefers-color-scheme: dark)" />
    <title>@ViewData["Title"] - Finoma</title>
    @{
        var ogBase = $"{Context.Request.Scheme}://{Context.Request.Host}";
        var ogImage = ogBase + "/icons/og-image.png";
        const string ogDesc = "A private, modern personal finance tracker — track expenses, income & savings, set budgets with smart alerts, and get plain-English insights into your money. Everything stays on your own ledger.";
    }
    @* Open Graph / Twitter — crisp, rich link preview when shared (WhatsApp, etc.) *@
    <meta name="description" content="@ogDesc" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Finoma" />
    <meta property="og:title" content="Finoma — A private, modern ledger for your money" />
    <meta property="og:description" content="@ogDesc" />
    <meta property="og:url" content="@ogBase" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:secure_url" content="@ogImage" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Finoma — personal finance, privacy-first" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Finoma — A private, modern ledger for your money" />
    <meta name="twitter:description" content="@ogDesc" />
    <meta name="twitter:image" content="@ogImage" />
    <script type="importmap"></script>
    @* The Ledger type stack:
         display  = Space Grotesk (mechanical grotesk; numerals rhyme with the figures)
         body     = Inter (utility; self-hosted fallback declared in site.css)
         figures  = IBM Plex Mono (tabular money columns) *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=Instrument+Serif:ital@0;1&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ExpenseTracker.styles.css" asp-append-version="true" />
    <link rel="manifest" href="~/manifest.webmanifest" />
    <link rel="icon" type="image/svg+xml" href="~/icons/icon.svg" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" sizes="any" asp-append-version="true" />
    <link rel="icon" type="image/png" sizes="512x512" href="~/icons/icon-512.png" asp-append-version="true" />
    <link rel="apple-touch-icon" href="~/icons/icon-512.png" asp-append-version="true" />
</head>
<body>
    <a href="#main-content" class="skip-link">Skip to main content</a>
    <header>
        <nav class="navbar navbar-expand-lg navbar-light" aria-label="Primary">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-wallet2 me-2" aria-hidden="true"></i>Finoma
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNav"
                        aria-controls="mobileNav" aria-label="Open menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="offcanvas offcanvas-end mobile-drawer" tabindex="-1" id="mobileNav" aria-labelledby="mobileNavLabel">
                    <div class="offcanvas-header">
                        <span class="mobile-drawer-brand" id="mobileNavLabel">
                            <span class="mobile-drawer-seal" aria-hidden="true">&#8377;</span>
                            <span>Finoma</span>
                        </span>
                        <button type="button" class="mobile-drawer-close" data-bs-dismiss="offcanvas" aria-label="Close menu">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                    <div class="offcanvas-body">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form class="mobile-drawer-search d-lg-none" role="search"
                                  asp-controller="Search" asp-action="Results" method="get">
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                                    <input type="search" name="q" class="form-control" placeholder="Search transactions…"
                                           aria-label="Search" autocomplete="off" />
                                </div>
                            </form>
                            <div class="mobile-drawer-label d-lg-none">Navigate</div>
                        }
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            @* ---- Desktop: four destinations, grouped ---- *@
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link@(Act("Dashboard"))" asp-area="" asp-controller="Dashboard" asp-action="Index">Overview</a>
                            </li>
                            <li class="nav-item dropdown d-none d-lg-block">
                                <a class="nav-link dropdown-toggle@(Act(moneySection))" href="#" id="moneyMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Money</a>
                                <ul class="dropdown-menu" aria-labelledby="moneyMenu">
                                    <li><a class="dropdown-item" asp-controller="Expenses" asp-action="Index">
                                        <i class="bi bi-cash-stack me-2" aria-hidden="true"></i>Expenses</a></li>
                                    <li><a class="dropdown-item" asp-controller="Incomes" asp-action="Index">
                                        <i class="bi bi-graph-up-arrow me-2" aria-hidden="true"></i>Income</a></li>
                                    <li><a class="dropdown-item" asp-controller="Accounts" asp-action="Index">
                                        <i class="bi bi-wallet2 me-2" aria-hidden="true"></i>Accounts</a></li>
                                    <li><a class="dropdown-item" asp-controller="Transfers" asp-action="Index">
                                        <i class="bi bi-arrow-left-right me-2" aria-hidden="true"></i>Transfers</a></li>
                                    <li><a class="dropdown-item" asp-controller="Debts" asp-action="Index">
                                        <i class="bi bi-cash-coin me-2" aria-hidden="true"></i>Owed to Me</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item" asp-controller="Categories" asp-action="Index">
                                        <i class="bi bi-tags me-2" aria-hidden="true"></i>Categories</a></li>
                                </ul>
                            </li>
                            <li class="nav-item dropdown d-none d-lg-block">
                                <a class="nav-link dropdown-toggle@(Act(planningSection))" href="#" id="planningMenu" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">Planning</a>
                                <ul class="dropdown-menu" aria-labelledby="planningMenu">
                                    <li><a class="dropdown-item" asp-controller="Budget" asp-action="Index">
                                        <i class="bi bi-speedometer me-2" aria-hidden="true"></i>Budgets</a></li>
                                    <li><a class="dropdown-item" asp-controller="Savings" asp-action="Index">
                                        <i class="bi bi-piggy-bank me-2" aria-hidden="true"></i>Savings</a></li>
                                    <li><a class="dropdown-item" asp-controller="Goals" asp-action="Index">
                                        <i class="bi bi-bullseye me-2" aria-hidden="true"></i>Goals</a></li>
                                    <li><a class="dropdown-item" asp-controller="Events" asp-action="Index">
                                        <i class="bi bi-calendar-event me-2" aria-hidden="true"></i>Events</a></li>
                                    <li><a class="dropdown-item" asp-controller="Recurring" asp-action="Index">
                                        <i class="bi bi-arrow-repeat me-2" aria-hidden="true"></i>Recurring</a></li>
                                </ul>
                            </li>
                            <li class="nav-item d-none d-lg-block">
                                <a class="nav-link@(Act("Insights"))" asp-area="" asp-controller="Insights" asp-action="Index">Insights</a>
                            </li>

                            @* ---- Mobile drawer: flat and grouped by heading ---- *@
                            <li class="nav-item d-lg-none">
                                <a class="nav-link@(Act("Dashboard"))" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-house me-1" aria-hidden="true"></i>Overview</a>
                            </li>
                            <li class="d-lg-none"><div class="mobile-drawer-label">Money</div></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Expenses"))" asp-controller="Expenses" asp-action="Index">
                                <i class="bi bi-cash-stack me-1" aria-hidden="true"></i>Expenses</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Incomes"))" asp-controller="Incomes" asp-action="Index">
                                <i class="bi bi-graph-up-arrow me-1" aria-hidden="true"></i>Income</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Accounts"))" asp-controller="Accounts" asp-action="Index">
                                <i class="bi bi-wallet2 me-1" aria-hidden="true"></i>Accounts</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Transfers"))" asp-controller="Transfers" asp-action="Index">
                                <i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>Transfers</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Debts"))" asp-controller="Debts" asp-action="Index">
                                <i class="bi bi-cash-coin me-1" aria-hidden="true"></i>Owed to Me</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Categories"))" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-tags me-1" aria-hidden="true"></i>Categories</a></li>
                            <li class="d-lg-none"><div class="mobile-drawer-label">Planning</div></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Budget"))" asp-controller="Budget" asp-action="Index">
                                <i class="bi bi-speedometer me-1" aria-hidden="true"></i>Budgets</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Savings"))" asp-controller="Savings" asp-action="Index">
                                <i class="bi bi-piggy-bank me-1" aria-hidden="true"></i>Savings</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Goals"))" asp-controller="Goals" asp-action="Index">
                                <i class="bi bi-bullseye me-1" aria-hidden="true"></i>Goals</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Events"))" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-1" aria-hidden="true"></i>Events</a></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Recurring"))" asp-controller="Recurring" asp-action="Index">
                                <i class="bi bi-arrow-repeat me-1" aria-hidden="true"></i>Recurring</a></li>
                            <li class="d-lg-none"><div class="mobile-drawer-label">Understand</div></li>
                            <li class="nav-item d-lg-none"><a class="nav-link@(Act("Insights"))" asp-controller="Insights" asp-action="Index">
                                <i class="bi bi-lightbulb me-1" aria-hidden="true"></i>Insights</a></li>
                        }
                    </ul>
                    <div class="mobile-drawer-label d-lg-none">Settings</div>
                    <div class="d-flex align-items-center gap-2 nav-utility">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <form class="navbar-search d-none d-lg-flex" role="search"
                                  asp-controller="Search" asp-action="Results" method="get">
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-search" aria-hidden="true"></i></span>
                                    <input type="search" name="q" class="form-control" placeholder="Search…"
                                           aria-label="Search" autocomplete="off" />
                                </div>
                            </form>
                        }
                        <button class="theme-toggle" id="pwaInstallMenuItem" type="button" hidden
                                aria-label="Install Finoma as an app" title="Install app">
                            <i class="bi bi-download" aria-hidden="true"></i>
                            <span class="theme-toggle-text d-lg-none">Install app</span>
                        </button>
                        <button class="theme-toggle" id="themeToggle" type="button"
                                aria-pressed="false" aria-label="Switch to dark mode" title="Switch to dark mode">
                            <i class="bi bi-moon-fill" aria-hidden="true"></i>
                            <i class="bi bi-sun-fill" aria-hidden="true"></i>
                            <span class="theme-toggle-text d-lg-none">Appearance</span>
                        </button>
                        <partial name="_LoginPartial" />
                    </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    @* Toast host — top-center stack. Populated from server flash messages
       (rendered by _ToastPartial below) AND from client JS (window.toast). *@
    <div id="toastHost" class="toast-host" aria-live="polite" aria-atomic="true"></div>

    <div class="container-xl">
        <main id="main-content" role="main" class="pb-3 pt-4">
            <partial name="_ToastPartial" />
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer text-muted">
        <div class="container">
            <div class="d-flex justify-content-between align-items-center">
                <span>&copy; 2026 Finoma</span>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <partial name="_QuickAddPartial" />
        <partial name="_CommandPalettePartial" />
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <script src="~/js/quick-add.js" asp-append-version="true"></script>
        <script src="~/js/command-palette.js" asp-append-version="true"></script>
    }
    <script>
        // Register the service worker for PWA installability + offline shell.
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', function () {
                navigator.serviceWorker.register('/sw.js').catch(function (e) {
                    console.warn('SW registration failed:', e);
                });
            });
        }

        // Surface the native install prompt as a "More → Install app" menu item.
        // Hidden by default; only revealed when the browser fires beforeinstallprompt.
        (function () {
            var deferred = null;
            var item = document.getElementById('pwaInstallMenuItem');
            window.addEventListener('beforeinstallprompt', function (e) {
                e.preventDefault();
                deferred = e;
                if (item) item.hidden = false;
            });
            if (item) {
                item.addEventListener('click', async function (e) {
                    e.preventDefault();
                    if (!deferred) { item.hidden = true; return; }
                    item.hidden = true;
                    deferred.prompt();
                    try { await deferred.userChoice; } catch (e2) { /* ignore */ }
                    deferred = null;
                });
            }
            window.addEventListener('appinstalled', function () {
                if (item) item.hidden = true;
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
