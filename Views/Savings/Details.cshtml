@model ExpenseTracker.Models.Domain.Saving

@{
    ViewData["Title"] = "Saving Details";
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Saving record</div>
    <h1><i class="bi bi-eye me-2"></i>Saving Details</h1>
    <p><a asp-action="Index" class="text-decoration-none">Savings</a> / Details</p>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8 text-tabular t-balance fw-semibold">@Model.Amount.ToString("C")</dd>
                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8 folio">@Model.Date.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-4">Note</dt>
                    <dd class="col-sm-8">@Model.Note</dd>
                    <dt class="col-sm-4">Month</dt>
                    <dd class="col-sm-8">@Model.YearMonth</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
<div class="mt-3">
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
</div>
