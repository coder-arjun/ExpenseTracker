@model ExpenseTracker.Models.PaginatedList<ExpenseTracker.Models.Domain.Saving>

@{
    ViewData["Title"] = "Savings";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Savings ledger</div>
        <h1><i class="bi bi-piggy-bank me-2"></i>Savings</h1>
        <p>MANAGE AND TRACK ALL YOUR SAVINGS</p>
    </div>
    <div>
        <div class="btn-group me-1">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="bi bi-download me-1"></i>Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="xlsx">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Excel (.xlsx)
                </a></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="pdf">
                    <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>PDF
                </a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="csv">
                    <i class="bi bi-filetype-csv me-2 text-secondary"></i>CSV (plain text)
                </a></li>
            </ul>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Saving
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-piggy-bank"></i></div>
        <div class="es-title">No savings recorded yet</div>
        <p class="es-body">Start saving today &mdash; every entry builds toward a stronger tomorrow.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Saving</a>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <table class="table table-hover table-stack mb-0">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Amount</th>
                        <th>Note</th>
                        <th>Month</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="Date" class="folio">@item.Date.ToString("dd MMM yyyy")</td>
                            <td data-label="Amount" class="text-end fw-semibold text-tabular t-balance">@item.Amount.ToString("C")</td>
                            <td data-label="Note">@item.Note</td>
                            <td data-label="Month">@item.YearMonth</td>
                            <td data-label="Actions">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit">
                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" aria-label="View details">
                                    <i class="bi bi-eye" aria-hidden="true"></i>
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" aria-label="Delete">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@{
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPreviousPage"] = Model.HasPreviousPage;
    ViewData["HasNextPage"] = Model.HasNextPage;
}
<partial name="_PaginationPartial" />
