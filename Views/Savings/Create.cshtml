@model ExpenseTracker.Models.Domain.Saving

@{
    ViewData["Title"] = "Add Saving";
}
@{
    string currentYearMonth = DateTime.Now.ToString("yyyy-MM");
}

<div class="create-page-header illus-saving">
    <i class="bi bi-piggy-bank header-icon"></i>
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> New saving</div>
    <h1>Add Saving</h1>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="card create-form-card" style="border-top-color: #1565c0;">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Note" class="form-label"></label>
                        <input asp-for="Note" class="form-control" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="YearMonth" class="form-label">Month (yyyy-MM)</label>
                        <input asp-for="YearMonth" class="form-control" value="@currentYearMonth" placeholder="2026-03" />
                        <span asp-validation-for="YearMonth" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
        <div class="create-illustration illus-saving">
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <span class="illus-particle"><i class="bi bi-shield-check"></i></span>
            <span class="illus-particle"><i class="bi bi-safe"></i></span>
            <span class="illus-particle"><i class="bi bi-lock"></i></span>
            <span class="illus-particle"><i class="bi bi-gem"></i></span>
            <span class="illus-particle"><i class="bi bi-star"></i></span>
            <i class="bi bi-piggy-bank illus-icon"></i>
            <div class="illus-title">Secure Your Future</div>
            <div class="illus-subtitle">Every small saving today builds a stronger financial tomorrow.</div>
            <div class="create-tip">
                <i class="bi bi-lightbulb-fill"></i> Tip: Aim to save at least 20% of your monthly income.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
