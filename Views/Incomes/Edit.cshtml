@using Microsoft.AspNetCore.Mvc.Rendering
@model ExpenseTracker.Models.Domain.Income

@{
    ViewData["Title"] = "Edit Income";
    var categories = (SelectList)ViewData["Categories"]!;
    var accounts = ViewData["Accounts"] as SelectList;
}

<div class="page-header">
    <h1><i class="bi bi-pencil me-2"></i>Edit Income</h1>
    <p><a asp-action="Index" class="text-decoration-none">Incomes</a> / Edit</p>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />
                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control text-tabular" inputmode="decimal" aria-required="true" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="date" class="form-control" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Source" class="form-label"></label>
                        <input asp-for="Source" class="form-control" />
                        <span asp-validation-for="Source" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@categories">
                            <option value="">-- Select Category (optional) --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    @if (accounts != null && accounts.Any())
                    {
                        <div class="form-group mb-3">
                            <label asp-for="AccountId" class="form-label"></label>
                            <select asp-for="AccountId" class="form-select" asp-items="@accounts">
                                <option value="">— none —</option>
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                        </div>
                    }
                    <div class="form-group mb-3">
                        <label asp-for="YearMonth" class="form-label">Month (yyyy-MM)</label>
                        <input asp-for="YearMonth" class="form-control" placeholder="2026-03" />
                        <span asp-validation-for="YearMonth" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
