@model ExpenseTracker.Models.ViewModel.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

@{
    var kpiNetWorth = (decimal)(ViewData["KpiNetWorth"] ?? 0m);
    var kpiSpend = (decimal)(ViewData["KpiMonthSpend"] ?? 0m);
    var kpiSavings = (decimal)(ViewData["KpiSavingsRate"] ?? 0m);
    var kpiGoals = (int)(ViewData["KpiActiveGoals"] ?? 0);
}

@{
    var inrCulture = System.Globalization.CultureInfo.GetCultureInfo("en-IN");
    var periodSpendLabel = Model.FilterType == "Month" ? "This month · spend"
                         : Model.FilterType == "Year" ? "This year · spend"
                         : "This period · spend";

    // Every figure on this page is labelled with the period it actually covers and,
    // where two figures share a name, the formula that produced it. The numbers are
    // untouched — only their captions. See the note beside "Savings rate" below:
    // the hero and the figure row genuinely measure different things.
    string periodLabel;
    if (Model.FilterType == "Month" && !string.IsNullOrEmpty(Model.SelectedMonth)
        && DateTime.TryParseExact(Model.SelectedMonth, "yyyy-MM",
               System.Globalization.CultureInfo.InvariantCulture,
               System.Globalization.DateTimeStyles.None, out var pmDate))
        periodLabel = pmDate.ToString("MMMM yyyy", inrCulture);
    else if (Model.FilterType == "Year" && Model.SelectedYear.HasValue)
        periodLabel = Model.SelectedYear.Value.ToString();
    else if (Model.FilterType == "DateRange")
        periodLabel = "selected range";
    else
        periodLabel = "all time";

    // Largest spending category, straight from the data already on the page.
    var topLeak = Model.TopLeakages != null && Model.TopLeakages.Count > 0 ? Model.TopLeakages[0] : null;
}

@* ── Statement masthead — the signature ── *@
<div class="statement" role="region" aria-label="Financial statement summary">
    <div class="statement-eyebrow"><span class="seal-dot">&#9679;</span> Statement &middot; The Reckoning</div>
    <span class="statement-figure" data-countup="@kpiNetWorth" data-countup-format="currency"
          aria-label="Net worth @kpiNetWorth.ToString("C0", inrCulture)">@kpiNetWorth.ToString("C0", inrCulture)</span>
    <div class="statement-sub">
        Total across all accounts
        <span class="stmt-note">All time &middot; not affected by the filter below</span>
    </div>
    <div class="statement-meta">
        <div class="sm-item">
            <div class="sm-label">@periodSpendLabel</div>
            <div class="sm-value t-expense"><span data-countup="@kpiSpend" data-countup-format="currency">@kpiSpend.ToString("C0", inrCulture)</span></div>
            <div class="sm-note">Recorded expenses &middot; @periodLabel</div>
        </div>
        <div class="sm-item">
            <div class="sm-label">Surplus rate</div>
            <div class="sm-value t-goal"><span data-countup="@kpiSavings" data-countup-format="percent">@kpiSavings%</span></div>
            <div class="sm-note">(income &minus; expenses) &divide; income &middot; @periodLabel</div>
        </div>
        <div class="sm-item">
            <div class="sm-label">Active goals</div>
            <div class="sm-value"><span data-countup="@kpiGoals">@kpiGoals</span></div>
            <div class="sm-note"><a asp-controller="Goals" asp-action="Index">View goals &rarr;</a></div>
        </div>
    </div>
</div>

<!-- Filter Bar -->
<div class="xp-filters sticky-filter">
    <div class="xp-filters-title">Period</div>
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-md-2">
            <label class="form-label fw-semibold">Filter By</label>
            <select name="filterType" id="filterType" class="form-select" onchange="toggleFilterInputs()">
                <option value="Month" selected="@(Model.FilterType == "Month" ? "selected" : null)">Month</option>
                <option value="Year" selected="@(Model.FilterType == "Year" ? "selected" : null)">Year</option>
                <option value="DateRange" selected="@(Model.FilterType == "DateRange" ? "selected" : null)">Date Range</option>
            </select>
        </div>
        <div class="col-md-2" id="monthInput">
            <label class="form-label fw-semibold">Month</label>
            <input type="month" name="selectedMonth" class="form-control" value="@Model.SelectedMonth" />
        </div>
        <div class="col-md-2" id="yearInput" style="display:none;">
            <label class="form-label fw-semibold">Year</label>
            <input type="number" name="selectedYear" class="form-control" min="2020" max="2030" value="@Model.SelectedYear" />
        </div>
        <div class="col-md-2" id="startDateInput" style="display:none;">
            <label class="form-label fw-semibold">Start Date</label>
            <input type="date" name="startDate" class="form-control" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2" id="endDateInput" style="display:none;">
            <label class="form-label fw-semibold">End Date</label>
            <input type="date" name="endDate" class="form-control" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary w-100">
                <i class="bi bi-funnel me-1"></i>Apply
            </button>
        </div>
    </form>
</div>

@* ── Financial overview: figures on the surface, not in five boxes ── *@
<section class="dash-section" aria-label="Financial overview">
    <div class="dash-eyebrow">Overview <span class="sep">&middot;</span> The Position</div>
    <div class="dash-figures">
        <div>
            <div class="dash-fig-label">Income</div>
            <div class="dash-fig-value t-income">@Model.TotalIncome.ToString("C0", inrCulture)</div>
            <div class="dash-fig-note">Recorded income &middot; @periodLabel</div>
        </div>
        <div>
            <div class="dash-fig-label">Expenses</div>
            <div class="dash-fig-value t-expense">@Model.TotalExpense.ToString("C0", inrCulture)</div>
            <div class="dash-fig-note">Recorded expenses &middot; @periodLabel</div>
        </div>
        <div>
            <div class="dash-fig-label">Savings</div>
            <div class="dash-fig-value">@Model.TotalSaving.ToString("C0", inrCulture)</div>
            <div class="dash-fig-note">Savings entries &middot; @periodLabel</div>
        </div>
        <div>
            <div class="dash-fig-label">Net balance</div>
            <div class="dash-fig-value">@Model.NetBalance.ToString("C0", inrCulture)</div>
            <div class="dash-fig-note">Income + savings &minus; expenses &middot; @periodLabel</div>
        </div>
        <div>
            <div class="dash-fig-label">Savings rate</div>
            <div class="dash-fig-value t-goal">@Model.SavingsRate.ToString("0.0")%</div>
            <div class="dash-fig-note">Savings entries &divide; income &middot; @periodLabel</div>
        </div>
    </div>
</section>

@* ── The signal: derived from the category data already on this page ── *@
@if (topLeak != null && Model.TotalExpense > 0)
{
    <section class="dash-insight" aria-label="Spending insight">
        <div class="dash-eyebrow">Insight <span class="sep">&middot;</span> The Signal</div>
        <p class="dash-insight-lede">
            <strong>@topLeak.Category</strong> is your largest spending category for @periodLabel.
        </p>
        <div class="dash-insight-figures">
            <span class="v">@topLeak.Amount.ToString("C0", inrCulture)</span>
            <span class="s">@topLeak.Percentage% of recorded expenses</span>
        </div>
        <a asp-controller="Expenses" asp-action="Index" class="dash-insight-link">View spending &rarr;</a>
    </section>
}

@* An editorial heading gives the tabbed area its own hierarchy. *@
<div class="dash-tabhead">
    <div class="dash-eyebrow">Financial overview <span class="sep">&middot;</span> The Ledger</div>
    <h2>A clear view of your money.</h2>
</div>

<!-- Dashboard Tabs -->
<ul class="nav nav-pills dashboard-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="overview-tab" data-bs-toggle="pill"
                data-bs-target="#overview-pane" type="button" role="tab"
                aria-controls="overview-pane" aria-selected="true">
            <i class="bi bi-graph-up me-1"></i>Overview
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="leakage-tab" data-bs-toggle="pill"
                data-bs-target="#leakage-pane" type="button" role="tab"
                aria-controls="leakage-pane" aria-selected="false">
            <i class="bi bi-droplet-half me-1"></i>Leakage
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="transactions-tab" data-bs-toggle="pill"
                data-bs-target="#transactions-pane" type="button" role="tab"
                aria-controls="transactions-pane" aria-selected="false">
            <i class="bi bi-clock-history me-1"></i>Transactions
        </button>
    </li>
    @if (Model.BudgetAlerts.Any())
    {
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="budget-tab" data-bs-toggle="pill"
                    data-bs-target="#budget-pane" type="button" role="tab"
                    aria-controls="budget-pane" aria-selected="false">
                <i class="bi bi-exclamation-triangle me-1"></i>Budget Alerts
                <span class="badge bg-danger ms-1">@Model.BudgetAlerts.Count</span>
            </button>
        </li>
    }
</ul>

<div class="tab-content">
    <!-- Overview Tab -->
    <div class="tab-pane fade show active" id="overview-pane" role="tabpanel" aria-labelledby="overview-tab">
        <div class="row g-4">
            @{
                // ── Accessible chart summaries used as canvas aria-labels ──
                var catTotal = Model.ExpensesByCategory.Values.Sum();
                string categoryAriaLabel;
                if (Model.ExpensesByCategory.Count == 0)
                {
                    categoryAriaLabel = "Expenses by category chart: no data available.";
                }
                else
                {
                    var topCat = Model.ExpensesByCategory.OrderByDescending(kv => kv.Value).First();
                    var topPct = catTotal > 0 ? Math.Round(topCat.Value / catTotal * 100m) : 0;
                    categoryAriaLabel =
                        $"Doughnut chart: expenses by category, {Model.ExpensesByCategory.Count} categories totalling " +
                        $"{catTotal.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))}. " +
                        $"Largest is {topCat.Key} at {topPct}%. Full data available as a table below.";
                }
                var comparisonAriaLabel =
                    $"Income versus expenses chart. Income: {Model.TotalIncome.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))}. " +
                    $"Expenses: {Model.TotalExpense.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))}. " +
                    $"Net: {(Model.TotalIncome - Model.TotalExpense).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))}. " +
                    $"Full data available as a table below.";
            }

            <div class="col-md-6">
                <div class="dash-panel">
                    <div class="dash-eyebrow">Spending <span class="sep">&middot;</span> The Leakage</div>
                    <div class="dash-panel-body">
                        <div class="dash-donut">
                            <div class="chart-container">
                                <canvas id="categoryChart" role="img" aria-label="@categoryAriaLabel"
                                        aria-describedby="categoryChartTable"></canvas>
                            </div>
                            @* Centre of the ring: the figure the chart is about. *@
                            <div class="dash-donut-centre" aria-hidden="true">
                                <span class="v">@catTotal.ToString("C0", inrCulture)</span>
                                <span class="l">Total spent</span>
                            </div>
                        </div>

                        @* The ranked list replaces the legend: same information, read top-down. *@
                        @if (Model.ExpensesByCategory.Count > 0)
                        {
                            <ol class="dash-rank">
                                @{ var rankIdx = 0; }
                                @foreach (var kv in Model.ExpensesByCategory.OrderByDescending(x => x.Value).Take(6))
                                {
                                    var pct = catTotal > 0 ? Math.Round(kv.Value / catTotal * 100m, 1) : 0;
                                    <li>
                                        <span class="dot" data-i="@rankIdx" aria-hidden="true"></span>
                                        <span class="n">@kv.Key</span>
                                        <span class="a">@kv.Value.ToString("C0", inrCulture)</span>
                                        <span class="p">@pct%</span>
                                    </li>
                                    rankIdx++;
                                }
                            </ol>
                        }
                        <details class="chart-fallback mt-2" id="categoryChartTable">
                            <summary><i class="bi bi-table me-1" aria-hidden="true"></i>View data as table</summary>
                            @if (Model.ExpensesByCategory.Count == 0)
                            {
                                <p class="text-muted small mt-2 mb-0">No expense data for this period.</p>
                            }
                            else
                            {
                                <table class="table table-sm mt-2 mb-0">
                                    <caption class="sr-only-v2">Expenses by category, percent of total in parentheses</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Category</th>
                                            <th scope="col" class="text-end">Amount</th>
                                            <th scope="col" class="text-end">Share</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var kv in Model.ExpensesByCategory.OrderByDescending(x => x.Value))
                                        {
                                            var pct = catTotal > 0 ? Math.Round(kv.Value / catTotal * 100m, 1) : 0;
                                            <tr>
                                                <td>@kv.Key</td>
                                                <td class="text-end text-tabular">@kv.Value.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                                <td class="text-end text-tabular">@pct%</td>
                                            </tr>
                                        }
                                        <tr class="fw-semibold">
                                            <td>Total</td>
                                            <td class="text-end text-tabular">@catTotal.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                            <td class="text-end text-tabular">100%</td>
                                        </tr>
                                    </tbody>
                                </table>
                            }
                        </details>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="dash-panel">
                    <div class="dash-eyebrow">Cash flow <span class="sep">&middot;</span> The Tide</div>
                    <div class="dash-panel-body">
                        <div class="dash-legend">
                            <span><i class="sw" style="background:#3E8C7A"></i>Income</span>
                            <span><i class="sw" style="background:#C2547A"></i>Expenses</span>
                        </div>
                        <div class="chart-container">
                            <canvas id="comparisonChart" role="img" aria-label="@comparisonAriaLabel"
                                    aria-describedby="comparisonChartTable"></canvas>
                        </div>
                        <details class="chart-fallback mt-2" id="comparisonChartTable">
                            <summary><i class="bi bi-table me-1" aria-hidden="true"></i>View data as table</summary>
                            @{
                                var months = Model.MonthlyIncomes.Keys
                                    .Concat(Model.MonthlyExpenses.Keys)
                                    .Distinct().OrderBy(m => m).ToList();
                            }
                            @if (months.Count == 0)
                            {
                                <p class="text-muted small mt-2 mb-0">No data for this period.</p>
                            }
                            else
                            {
                                <table class="table table-sm mt-2 mb-0">
                                    <caption class="sr-only-v2">Monthly income versus expenses</caption>
                                    <thead>
                                        <tr>
                                            <th scope="col">Month</th>
                                            <th scope="col" class="text-end">Income</th>
                                            <th scope="col" class="text-end">Expenses</th>
                                            <th scope="col" class="text-end">Net</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var m in months)
                                        {
                                            var inc = Model.MonthlyIncomes.TryGetValue(m, out var i) ? i : 0;
                                            var exp = Model.MonthlyExpenses.TryGetValue(m, out var e) ? e : 0;
                                            var net = inc - exp;
                                            <tr>
                                                <td>@m</td>
                                                <td class="text-end text-tabular t-income">@inc.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                                <td class="text-end text-tabular t-expense">@exp.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                                <td class="text-end text-tabular @(net >= 0 ? "t-income" : "t-expense")">@net.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                        </details>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Leakage Tab -->
    <div class="tab-pane fade" id="leakage-pane" role="tabpanel" aria-labelledby="leakage-tab">
        <div class="dash-panel">
            <div class="dash-eyebrow">Spending <span class="sep">&middot;</span> The Leakage</div>
            <div class="dash-panel-body">
                @* bg-light was a white box on a dark page; this is the shared console. *@
                <div class="xp-filters">
                    <div class="row g-2 align-items-end">
                        <div class="col-md-2">
                            <label class="form-label" for="leakageFilterType">Period</label>
                            <select id="leakageFilterType" class="form-select form-select-sm" onchange="toggleLeakageFilters()">
                                <option value="Month">Month</option>
                                <option value="Year" selected>Year</option>
                                <option value="DateRange">Date Range</option>
                            </select>
                        </div>
                        <div class="col-md-2" id="leakageMonthInput" style="display:none;">
                            <label class="form-label">Month</label>
                            <input type="month" id="leakageMonth" class="form-control form-control-sm"
                                   value="@DateTime.Now.ToString("yyyy-MM")" />
                        </div>
                        <div class="col-md-2" id="leakageYearInput">
                            <label class="form-label">Year</label>
                            <input type="number" id="leakageYear" class="form-control form-control-sm"
                                   min="2020" max="2030" value="@DateTime.Now.Year" />
                        </div>
                        <div class="col-md-2" id="leakageStartDateInput" style="display:none;">
                            <label class="form-label">Start Date</label>
                            <input type="date" id="leakageStartDate" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-2" id="leakageEndDateInput" style="display:none;">
                            <label class="form-label">End Date</label>
                            <input type="date" id="leakageEndDate" class="form-control form-control-sm" />
                        </div>
                        <div class="col-md-auto ms-md-auto">
                            <button type="button" class="btn btn-sm btn-primary" onclick="loadLeakageData()">Apply</button>
                        </div>
                    </div>
                </div>
                <!-- Leakage Results -->
                <div id="leakageResults">
                    @await Html.PartialAsync("_LeakagePartial", Model.TopLeakages)
                </div>
            </div>
        </div>
    </div>

    <!-- Budget Alerts Tab -->
    @if (Model.BudgetAlerts.Any())
    {
        <div class="tab-pane fade" id="budget-pane" role="tabpanel" aria-labelledby="budget-tab">
            <div class="card shadow-sm">
                <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-exclamation-triangle me-1"></i>Budget Alerts</span>
                    <a asp-controller="Budget" asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-speedometer me-1"></i>Manage Budgets
                    </a>
                </div>
                <div class="card-body">
                    @foreach (var alert in Model.BudgetAlerts.OrderByDescending(a => a.PercentageUsed))
                    {
                        var barClass = alert.PercentageUsed >= 100 ? "bg-danger" : "bg-warning";
                        var alertClass = alert.PercentageUsed >= 100 ? "border-danger" : "border-warning";
                        var icon = alert.PercentageUsed >= 100 ? "bi-exclamation-triangle-fill" : "bi-exclamation-circle";

                        <div class="border rounded p-3 mb-3 @alertClass">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="mb-0">
                                    <i class="bi @icon me-1 @(alert.PercentageUsed >= 100 ? "text-danger" : "text-warning")"></i>
                                    @alert.CategoryName
                                </h6>
                                <span class="fw-semibold">@alert.ActualSpent.ToString("C") / @alert.BudgetAmount.ToString("C")</span>
                            </div>
                            <div class="progress mb-2" style="height: 8px;">
                                <div class="progress-bar @barClass" role="progressbar"
                                     style="width: @Math.Min(alert.PercentageUsed, 100)%"></div>
                            </div>
                            <div class="d-flex justify-content-between">
                                <small class="text-muted">@alert.PercentageUsed% used</small>
                                @if (alert.Remaining >= 0)
                                {
                                    <small class="text-warning fw-semibold">@alert.Remaining.ToString("C") remaining</small>
                                }
                                else
                                {
                                    <small class="text-danger fw-semibold">@((-alert.Remaining).ToString("C")) over budget!</small>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Transactions Tab -->
    <div class="tab-pane fade" id="transactions-pane" role="tabpanel" aria-labelledby="transactions-tab">
        <div class="dash-panel">
            <div class="dash-eyebrow">Recent activity <span class="sep">&middot;</span> The Record</div>
            <div class="dash-panel-body">
                <table class="txn-table">
                    <thead>
                        <tr>
                            <th class="txn-date">Date</th>
                            <th>Description</th>
                            <th class="txn-type">Type</th>
                            <th class="txn-amount">Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentTransactions.Any())
                        {
                            @foreach (var t in Model.RecentTransactions)
                            {
                                <tr class="@(t.Type == "Income" ? "is-credit" : t.Type == "Expense" ? "is-debit" : "is-saving")">
                                    <td class="txn-date" data-label="Date">@t.Date.ToString("dd MMM yyyy")</td>
                                    <td class="txn-desc" data-label="Description">
                                        @if (string.IsNullOrWhiteSpace(t.Description))
                                        {
                                            <span class="none">No description</span>
                                        }
                                        else
                                        {
                                            @t.Description
                                        }
                                    </td>
                                    <td class="txn-type" data-label="Type">
                                        @if (t.Type == "Income")
                                        {
                                            <span class="txn-tag is-credit">Credit</span>
                                        }
                                        else if (t.Type == "Expense")
                                        {
                                            <span class="txn-tag is-debit">Debit</span>
                                        }
                                        else
                                        {
                                            <span class="txn-tag is-saving">Saving</span>
                                        }
                                    </td>
                                    <td class="txn-amount @(t.Type == "Income" ? "t-income" : t.Type == "Expense" ? "t-expense" : "")" data-label="Amount">@(t.Type == "Income" ? "+" : t.Type == "Expense" ? "−" : "")@t.Amount.ToString("C")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="txn-empty">No transactions found for the selected period.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@{
    // Share link built from the current host so it always points at the live site.
    var shareAppUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var shareTextDash =
        "📊 Finoma — a clean, privacy-first way to manage your money.\n\n" +
        "Track your expenses, income & savings, set budgets with smart alerts, and get plain-English insights into where your money goes — all kept private on your own ledger.\n\n" +
        $"Try it free: {shareAppUrl}";
    var waHrefDash = "https://wa.me/?text=" + Uri.EscapeDataString(shareTextDash);
}

@* A closing statement in Finoma's voice, not a generic SaaS call-to-action. *@
<section class="share-section" aria-label="Share Finoma">
    <div class="dash-eyebrow">Spread the word <span class="sep">&middot;</span> The Word</div>
    <h2 class="share-heading">Good money habits are worth sharing.</h2>
    <p class="share-sub">
        Finoma is free, private and built to help you understand where your money goes.
        Nothing leaves your ledger.
    </p>
    <a href="@waHrefDash" target="_blank" rel="noopener noreferrer" class="btn btn-whatsapp btn-lg">
        <i class="bi bi-whatsapp me-2" aria-hidden="true"></i>Share Finoma
    </a>
</section>

<style>
    .share-section { margin: 3rem 0 1rem; padding: 2.75rem 0 0.5rem; border-top: 1px solid var(--hairline); max-width: 42rem; }
    .share-heading { font-family: var(--font-display); font-weight: 600; font-size: clamp(1.3rem, 1.1rem + 1vw, 1.95rem); letter-spacing: -0.02em; color: var(--ink); margin-bottom: 0.5rem; }
    .share-sub { color: var(--ink-muted); max-width: 34rem; margin: 0 0 1.6rem; }
    .btn-whatsapp { background: #25D366; border: 1px solid #25D366; color: #fff; font-weight: 600; box-shadow: 0 6px 18px -6px rgba(37, 211, 102, 0.55); transition: background var(--transition-fast), box-shadow var(--transition-fast), transform var(--motion-fast) var(--ease-out); }
    .btn-whatsapp:hover, .btn-whatsapp:focus-visible { background: #1ebe5d; border-color: #1ebe5d; color: #fff; box-shadow: 0 9px 24px -6px rgba(37, 211, 102, 0.7); }
    .btn-whatsapp:active { background: #1aa653; border-color: #1aa653; color: #fff; transform: translateY(0.5px); }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
    <script>
        // Filter toggle
        function toggleFilterInputs() {
            var type = document.getElementById('filterType').value;
            document.getElementById('monthInput').style.display = type === 'Month' ? '' : 'none';
            document.getElementById('yearInput').style.display = type === 'Year' ? '' : 'none';
            document.getElementById('startDateInput').style.display = type === 'DateRange' ? '' : 'none';
            document.getElementById('endDateInput').style.display = type === 'DateRange' ? '' : 'none';
        }
        toggleFilterInputs();

        // Chart instances for resize on tab switch
        var chartInstances = [];

        // ─── Accessible-chart helpers ───────────────────────────────────
        // Pattern generator: each colour gets a *distinct shape* overlay so
        // colour-blind users can still tell categories apart at a glance.
        // (Replaces the need for the chartjs-plugin-patternomaly external dep.)
        var PATTERN_KINDS = ['diagonal', 'reverse-diagonal', 'dots', 'cross',
                             'horizontal', 'vertical', 'zigzag', 'chevron'];
        function makePattern(color, idx) {
            var size = 16;
            var off = document.createElement('canvas');
            off.width = size; off.height = size;
            var ctx = off.getContext('2d');
            ctx.fillStyle = color;
            ctx.fillRect(0, 0, size, size);
            ctx.strokeStyle = 'rgba(255,255,255,0.55)';
            ctx.fillStyle   = 'rgba(255,255,255,0.65)';
            ctx.lineWidth = 1.6;
            var kind = PATTERN_KINDS[idx % PATTERN_KINDS.length];
            ctx.beginPath();
            switch (kind) {
                case 'diagonal':
                    for (var x = -size; x < size * 2; x += 5) { ctx.moveTo(x, 0); ctx.lineTo(x + size, size); }
                    break;
                case 'reverse-diagonal':
                    for (var x2 = -size; x2 < size * 2; x2 += 5) { ctx.moveTo(x2, size); ctx.lineTo(x2 + size, 0); }
                    break;
                case 'dots':
                    for (var y = 3; y < size; y += 6) {
                        for (var x3 = 3; x3 < size; x3 += 6) {
                            ctx.beginPath(); ctx.arc(x3, y, 1.4, 0, Math.PI * 2); ctx.fill();
                        }
                    }
                    return ctx.createPattern(off, 'repeat');
                case 'cross':
                    for (var xc = 0; xc <= size; xc += 6) { ctx.moveTo(xc, 0); ctx.lineTo(xc, size); }
                    for (var yc = 0; yc <= size; yc += 6) { ctx.moveTo(0, yc); ctx.lineTo(size, yc); }
                    break;
                case 'horizontal':
                    for (var yh = 2; yh < size; yh += 4) { ctx.moveTo(0, yh); ctx.lineTo(size, yh); }
                    break;
                case 'vertical':
                    for (var xv = 2; xv < size; xv += 4) { ctx.moveTo(xv, 0); ctx.lineTo(xv, size); }
                    break;
                case 'zigzag':
                    ctx.moveTo(0, size / 2);
                    for (var xz = 0; xz < size; xz += 4) { ctx.lineTo(xz + 2, 0); ctx.lineTo(xz + 4, size / 2); }
                    break;
                case 'chevron':
                    for (var yk = 0; yk < size; yk += 5) {
                        ctx.moveTo(0, yk); ctx.lineTo(size / 2, yk + 3); ctx.lineTo(size, yk);
                    }
                    break;
            }
            ctx.stroke();
            return ctx.createPattern(off, 'repeat');
        }

        // Tiny inline plugin: draw a percentage label on each slice/bar
        // whose share is ≥ 5%. White text with a subtle shadow for legibility.
        var directLabelsPlugin = {
            id: 'directLabels',
            afterDatasetsDraw: function (chart) {
                var ctx = chart.ctx;
                var type = chart.config.type;
                ctx.save();
                ctx.font = '600 11px Inter, system-ui, sans-serif';
                ctx.textAlign = 'center';
                ctx.textBaseline = 'middle';
                chart.data.datasets.forEach(function (ds, dsi) {
                    var meta = chart.getDatasetMeta(dsi);
                    if (meta.hidden) return;
                    var values = ds.data || [];
                    var datasetTotal = values.reduce(function (a, b) { return a + (b || 0); }, 0);
                    meta.data.forEach(function (el, i) {
                        var v = values[i] || 0;
                        if (datasetTotal <= 0) return;
                        var share = v / datasetTotal;
                        // Skip tiny slivers — labels would overlap and clutter
                        if (share < 0.05) return;
                        var label = (type === 'doughnut' || type === 'pie')
                            ? Math.round(share * 100) + '%'
                            : null;
                        if (!label) return;
                        var pos = (typeof el.tooltipPosition === 'function')
                            ? el.tooltipPosition() : { x: el.x, y: el.y };
                        ctx.shadowColor = 'rgba(0,0,0,0.55)';
                        ctx.shadowBlur = 3;
                        ctx.fillStyle = '#fff';
                        ctx.fillText(label, pos.x, pos.y);
                        ctx.shadowBlur = 0;
                    });
                });
                ctx.restore();
            }
        };
        Chart.register(directLabelsPlugin);

        // Shared INR formatter for tooltips.
        var inrNF = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 });
        function inrFmt(n) { try { return inrNF.format(n); } catch (e) { return '₹' + Math.round(n); } }

        // Axis furniture should be felt, not read.
        var _dark = document.documentElement.getAttribute('data-theme') === 'dark';
        var gridTone = _dark ? 'rgba(255,255,255,0.045)' : 'rgba(26,24,20,0.06)';
        var axisTone = _dark ? 'rgba(255,255,255,0.42)' : 'rgba(26,24,20,0.45)';
        function compactINR(v) {
            var a = Math.abs(v);
            if (a >= 10000000) return '₹' + (v / 10000000).toFixed(1) + 'Cr';
            if (a >= 100000)   return '₹' + (v / 100000).toFixed(1) + 'L';
            if (a >= 1000)     return '₹' + Math.round(v / 1000) + 'K';
            return '₹' + v;
        }

        // Category doughnut chart
        var catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory.Keys.ToArray()));
        var catValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ExpensesByCategory.Values.ToArray()));
        // A restrained six-tone set drawn from the brand palette, not a rainbow.
        // Hatched fills are gone; the % label on each slice, the ranked list beside
        // the chart and the data table below carry the meaning without relying on hue.
        var catColors = ['#C2547A', '#A08346', '#3E8C7A', '#7A6BA8', '#B5713C', '#6E6A60'];
        function catColor(i) { return catColors[i % catColors.length]; }

        if (catLabels.length > 0) {
            chartInstances.push(new Chart(document.getElementById('categoryChart'), {
                type: 'doughnut',
                data: {
                    labels: catLabels,
                    datasets: [{
                        data: catValues,
                        backgroundColor: catLabels.map(function (_, i) { return catColor(i); }),
                        hoverOffset: 6,
                        borderWidth: 2,
                        borderColor: getComputedStyle(document.documentElement).getPropertyValue('--color-surface') || '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '68%',
                    plugins: {
                        // The ranked list beside the chart is the legend now.
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (c) {
                                    var t = c.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                    var pct = t ? Math.round(c.parsed / t * 1000) / 10 : 0;
                                    return ' ' + c.label + '  ' + inrFmt(c.parsed) + '  (' + pct + '%)';
                                }
                            }
                        }
                    }
                }
            }));
        }

        // Comparison chart (income vs expenses)
        var allMonths = [...new Set([
            ...@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyIncomes.Keys.ToArray())),
            ...@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses.Keys.ToArray()))
        ])].sort();

        var incomeData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyIncomes));
        var expenseData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyExpenses));

        var incomeValues = allMonths.map(function(m) { return incomeData[m] || 0; });
        var expenseValues = allMonths.map(function(m) { return expenseData[m] || 0; });

        var filterType = '@Model.FilterType';
        var compChartType = (filterType === 'Month') ? 'doughnut' : 'bar';

        // Income vs Expense patterns: income = diagonal, expense = reverse-diagonal.
        // Two strongly-distinct shapes so the comparison stays legible even at the
        // common red-green confusion that ~5% of users have.
        var INCOME_TONE  = '#3E8C7A';
        var EXPENSE_TONE = '#C2547A';

        // "2026-03" is a database key, not a label a person reads.
        var MON = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
        function monthLabel(key) {
            var m = /^(\d{4})-(\d{2})$/.exec(key);
            if (!m) return key;
            var name = MON[parseInt(m[2], 10) - 1] || key;
            return allMonths.length > 12 ? name + " '" + m[1].slice(2) : name;
        }
        var monthLabels = allMonths.map(monthLabel);

        if (allMonths.length > 0) {
            if (compChartType === 'bar') {
                chartInstances.push(new Chart(document.getElementById('comparisonChart'), {
                    type: 'bar',
                    data: {
                        labels: monthLabels,
                        datasets: [
                            { label: 'Income',   data: incomeValues,  backgroundColor: INCOME_TONE,
                              borderRadius: 3, borderSkipped: false, maxBarThickness: 14 },
                            { label: 'Expenses', data: expenseValues, backgroundColor: EXPENSE_TONE,
                              borderRadius: 3, borderSkipped: false, maxBarThickness: 14 }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            // The HTML legend above the canvas is the legend now; the
                            // built-in one duplicated it and collided with the x-axis.
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function (c) { return ' ' + c.dataset.label + '  ' + inrFmt(c.parsed.y); }
                                }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                border: { display: false },
                                grid: { color: gridTone, drawTicks: false },
                                ticks: { color: axisTone, font: { size: 10 }, padding: 8,
                                         callback: function (v) { return compactINR(v); } }
                            },
                            x: {
                                border: { display: false },
                                grid: { display: false },
                                ticks: { color: axisTone, font: { size: 11 } }
                            }
                        }
                    }
                }));
            } else {
                chartInstances.push(new Chart(document.getElementById('comparisonChart'), {
                    type: 'doughnut',
                    data: {
                        labels: ['Income', 'Expenses'],
                        datasets: [{
                            data: [@Model.TotalIncome, @Model.TotalExpense],
                            backgroundColor: [INCOME_TONE, EXPENSE_TONE],
                            hoverBackgroundColor: ['#16A34A', '#DC2626'],
                            borderWidth: 2,
                            borderColor: getComputedStyle(document.documentElement).getPropertyValue('--color-surface') || '#fff'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: {
                                    generateLabels: function () {
                                        return [
                                            { text: 'Income',   fillStyle: '#16A34A', strokeStyle: '#16A34A', lineWidth: 0, index: 0 },
                                            { text: 'Expenses', fillStyle: '#DC2626', strokeStyle: '#DC2626', lineWidth: 0, index: 1 }
                                        ];
                                    }
                                }
                            }
                        }
                    }
                }));
            }
        }

        // Resize charts when switching back to overview tab
        document.getElementById('overview-tab').addEventListener('shown.bs.tab', function () {
            chartInstances.forEach(function (c) { c.resize(); });
        });

        // Leakage filter toggle
        function toggleLeakageFilters() {
            var type = document.getElementById('leakageFilterType').value;
            document.getElementById('leakageMonthInput').style.display = type === 'Month' ? '' : 'none';
            document.getElementById('leakageYearInput').style.display = type === 'Year' ? '' : 'none';
            document.getElementById('leakageStartDateInput').style.display = type === 'DateRange' ? '' : 'none';
            document.getElementById('leakageEndDateInput').style.display = type === 'DateRange' ? '' : 'none';
        }

        // Load leakage data via AJAX
        function loadLeakageData() {
            var type = document.getElementById('leakageFilterType').value;
            var params = new URLSearchParams();
            params.append('filterType', type);

            if (type === 'Month') {
                params.append('selectedMonth', document.getElementById('leakageMonth').value);
            } else if (type === 'Year') {
                params.append('selectedYear', document.getElementById('leakageYear').value);
            } else if (type === 'DateRange') {
                var start = document.getElementById('leakageStartDate').value;
                var end = document.getElementById('leakageEndDate').value;
                if (start) params.append('startDate', start);
                if (end) params.append('endDate', end);
            }

            var resultsDiv = document.getElementById('leakageResults');
            resultsDiv.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Loading...</span></div></div>';

            fetch('@Url.Action("GetLeakageData", "Dashboard")?' + params.toString())
                .then(function (response) { return response.text(); })
                .then(function (html) { resultsDiv.innerHTML = html; })
                .catch(function () { resultsDiv.innerHTML = '<div class="text-center text-danger py-4">Failed to load data. Please try again.</div>'; });
        }
    </script>
}
