@model List<ExpenseTracker.Models.ViewModel.MoneyLeakage>

@*
    Presentation only — same model, same ordering, same figures. Also returned by the
    GetLeakageData AJAX endpoint, so the markup stays self-contained.

    The ranking is the differentiator, so the bars use one tonal rose scale rather than
    five unrelated hues: rank carries meaning, colour just reinforces it.
*@

@if (Model.Any())
{
    <ol class="leak-list">
        @foreach (var (leakage, index) in Model.Select((l, i) => (l, i)))
        {
            <li class="leak-item" data-rank="@index">
                <span class="leak-rank" aria-hidden="true">@((index + 1).ToString("00"))</span>
                <div class="leak-body">
                    <div class="leak-head">
                        <span class="leak-name">@leakage.Category</span>
                        <span class="leak-figures">
                            <span class="leak-amount">&minus;@leakage.Amount.ToString("C")</span>
                            <span class="leak-share">@leakage.Percentage%</span>
                        </span>
                    </div>
                    <div class="leak-bar" role="progressbar"
                         aria-label="@leakage.Category share of expenses"
                         aria-valuenow="@leakage.Percentage" aria-valuemin="0" aria-valuemax="100">
                        <span style="width:@leakage.Percentage.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></span>
                    </div>
                </div>
            </li>
        }
    </ol>
}
else
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-inbox"></i></div>
        <div class="es-title">No leakage to report</div>
        <p class="es-body">No expenses found for the selected period.</p>
    </div>
}
