@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.Account

@{ ViewData["Title"] = "Add Account"; }

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> New account</div>
    <h1><i class="bi bi-wallet2 me-2"></i>Add Account</h1>
    <p><a asp-action="Index" class="text-decoration-none">Accounts</a> / New</p>
</div>

<div class="row"><div class="col-md-6"><div class="card"><div class="card-body">
    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-group mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" maxlength="50" placeholder="e.g. HDFC Savings" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Type" class="form-label"></label>
            <select asp-for="Type" class="form-select">
                @foreach (var t in Enum.GetValues<AccountType>())
                {
                    <option value="@t" selected="@(Model.Type == t ? "selected" : null)">@t</option>
                }
            </select>
        </div>
        <div class="form-group mb-3">
            <label asp-for="OpeningBalance" class="form-label"></label>
            <div class="input-currency">
                <input asp-for="OpeningBalance" class="form-control text-tabular" type="number" step="0.01" inputmode="decimal" />
            </div>
            <div class="form-text">What's in this account right now. Subsequent income/expense/transfers adjust it from here.</div>
            <span asp-validation-for="OpeningBalance" class="text-danger"></span>
        </div>
        <div class="form-check mb-3">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label">Active</label>
        </div>
        <div class="form-group">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
