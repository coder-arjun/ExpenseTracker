@using ExpenseTracker.Models.Domain
@model IEnumerable<ExpenseTracker.Models.Domain.Account>

@{
    ViewData["Title"] = "Accounts";
    var balances = (Dictionary<int, decimal>)ViewData["Balances"]!;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-stretch align-items-sm-center gap-3 mb-4">
    <div class="page-header mb-0">
        <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Account ledger</div>
        <h1><i class="bi bi-wallet2 me-2"></i>Accounts</h1>
        <p>CASH &middot; BANK &middot; CREDIT &middot; UPI &mdash; EVERY MONEY LOCATION</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Transfers" asp-action="Create" class="btn btn-outline-secondary flex-fill flex-sm-grow-0">
            <i class="bi bi-arrow-left-right me-1"></i>Transfer
        </a>
        <a asp-action="Create" class="btn btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-circle me-1"></i>Add Account
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-wallet2"></i></div>
        <div class="es-title">No accounts yet</div>
        <p class="es-body">Add Cash, your bank, or your UPI wallet to start tracking balances.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Add Account</a>
    </div>
}
else
{
    var grandTotal = balances.Values.Sum();
    var grandClass = grandTotal < 0 ? "t-expense" : "t-balance";
    var grandPrefix = grandTotal < 0 ? Html.Raw("&minus;") : Html.Raw("");
    <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-end py-3">
            <div>
                <div class="eyebrow mb-1">Total across active accounts</div>
                <div class="ledger-total fs-3 text-tabular @grandClass d-inline-block pt-2 ps-1">@grandPrefix@Math.Abs(grandTotal).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</div>
            </div>
            <div class="folio">@Model.Count() account@(Model.Count() == 1 ? "" : "s")</div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var a in Model)
        {
            var bal = balances.TryGetValue(a.Id, out var b) ? b : a.OpeningBalance;
            var icon = a.Type switch
            {
                AccountType.Cash   => "bi-cash-coin",
                AccountType.Bank   => "bi-bank",
                AccountType.Credit => "bi-credit-card",
                AccountType.Wallet => "bi-wallet",
                AccountType.UPI    => "bi-phone",
                _ => "bi-wallet2"
            };
            var balClass = bal < 0 ? "t-expense" : "t-balance";
            var balPrefix = bal < 0 ? Html.Raw("&minus;") : Html.Raw("");
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(a.IsActive ? "" : "opacity-50")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <i class="@icon me-1"></i>
                                <span class="fw-semibold">@a.Name</span>
                                @if (a.IsPrimary)
                                {
                                    <span class="badge bg-success-subtle text-success ms-1" title="Debt settlements land here"><i class="bi bi-star-fill me-1"></i>Primary</span>
                                }
                                <div class="small text-muted">@a.Type @(a.IsActive ? "" : "· Inactive")</div>
                            </div>
                            <div class="d-flex gap-1">
                                @if (!a.IsPrimary)
                                {
                                    <form asp-action="SetPrimary" asp-route-id="@a.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-success" aria-label="Make primary account" title="Make primary account"><i class="bi bi-star" aria-hidden="true"></i></button>
                                    </form>
                                }
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold text-tabular @balClass">
                            @balPrefix@Math.Abs(bal).ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </div>
                        <small class="folio">Opening: @a.OpeningBalance.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
