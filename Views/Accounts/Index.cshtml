@using ExpenseTracker.Models.Domain
@model IEnumerable<ExpenseTracker.Models.Domain.Account>

@{
    ViewData["Title"] = "Accounts";
    var balances = (Dictionary<int, decimal>)ViewData["Balances"]!;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <h1><i class="bi bi-wallet2 me-2"></i>Accounts</h1>
        <p>Cash, bank, credit card, UPI — track every money location.</p>
    </div>
    <div>
        <a asp-controller="Transfers" asp-action="Create" class="btn btn-outline-primary me-1">
            <i class="bi bi-arrow-left-right me-1"></i>Transfer
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>Add Account
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card">
        <div class="empty-state">
            <i class="bi bi-wallet2"></i>
            <p>No accounts yet. Add Cash, your bank, or your UPI wallet to start tracking balances.</p>
        </div>
    </div>
}
else
{
    var grandTotal = balances.Values.Sum();
    <div class="card mb-3 border-start border-4 border-primary">
        <div class="card-body py-2">
            <div class="text-muted small">Total across active accounts</div>
            <div class="fs-3 fw-bold">@grandTotal.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</div>
        </div>
    </div>

    <div class="row g-3">
        @foreach (var a in Model)
        {
            var bal = balances.TryGetValue(a.Id, out var b) ? b : a.OpeningBalance;
            var icon = a.Type switch
            {
                AccountType.Cash   => "bi-cash-coin",
                AccountType.Bank   => "bi-bank",
                AccountType.Credit => "bi-credit-card",
                AccountType.Wallet => "bi-wallet",
                AccountType.UPI    => "bi-phone",
                _ => "bi-wallet2"
            };
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 @(a.IsActive ? "" : "opacity-50")">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <i class="@icon me-1"></i>
                                <span class="fw-semibold">@a.Name</span>
                                <div class="small text-muted">@a.Type @(a.IsActive ? "" : "· Inactive")</div>
                            </div>
                            <div>
                                <a asp-action="Edit" asp-route-id="@a.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <a asp-action="Delete" asp-route-id="@a.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </div>
                        </div>
                        <div class="fs-4 fw-bold @(bal < 0 ? "text-danger" : "text-success")">
                            @bal.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))
                        </div>
                        <small class="text-muted">Opening: @a.OpeningBalance.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</small>
                    </div>
                </div>
            </div>
        }
    </div>
}
