@using ExpenseTracker.Models.Domain
@using ExpenseTracker.Services
@model IEnumerable<ExpenseTracker.Models.Domain.Account>

@*
    Presentation only. Balances still come from ViewData["Balances"], every route and
    form (SetPrimary, Edit, Delete) is unchanged.
*@

@{
    ViewData["Title"] = "Accounts";
    var balances = (Dictionary<int, decimal>)ViewData["Balances"]!;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
    <div class="page-head has-stroke mb-0">
        <div class="page-eyebrow">Account ledger</div>
        <h1>Accounts</h1>
        <p class="page-lede">Cash, bank, credit and UPI — every money location.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Transfers" asp-action="Create" class="btn btn-sm btn-outline-secondary flex-fill flex-sm-grow-0">
            Transfer
        </a>
        <a asp-action="Create" class="btn btn-sm btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-lg me-1"></i>Add account
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-wallet2"></i></div>
        <div class="es-title">No accounts yet</div>
        <p class="es-body">Add Cash, your bank, or your UPI wallet to start tracking balances.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add account</a>
    </div>
}
else
{
    var grandTotal = balances.Values.Sum();
    var activeCount = Model.Count(a => a.IsActive);

    @* The hero figure of the page — no decorative rule above it. *@
    <section class="acct-total" aria-label="Total across active accounts">
        <div>
            <div class="acct-total-label">Total across active accounts</div>
            <span class="acct-total-value @(grandTotal < 0 ? "is-neg" : "")">
                @(grandTotal < 0 ? "−" : "")@MoneyFormat.Full(Math.Abs(grandTotal))
            </span>
        </div>
        <div class="acct-total-meta">
            <span class="n">@activeCount</span>
            <span class="l">active account@(activeCount == 1 ? "" : "s")</span>
        </div>
    </section>

    <div class="acct-grid">
        @foreach (var a in Model)
        {
            var bal = balances.TryGetValue(a.Id, out var b) ? b : a.OpeningBalance;
            var icon = a.Type switch
            {
                AccountType.Cash => "bi-cash-coin",
                AccountType.Bank => "bi-bank",
                AccountType.Credit => "bi-credit-card",
                AccountType.Wallet => "bi-wallet",
                AccountType.UPI => "bi-phone",
                _ => "bi-wallet2"
            };
            <article class="acct-card @(a.IsActive ? "" : "is-inactive")" data-acct-type="@a.Type">
                <div class="acct-card-top">
                    <span class="acct-mark"><i class="@icon" aria-hidden="true"></i></span>
                    <div class="acct-actions">
                        @if (!a.IsPrimary)
                        {
                            <form asp-action="SetPrimary" asp-route-id="@a.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="acct-btn" aria-label="Make primary account" title="Make primary account">
                                    <i class="bi bi-star" aria-hidden="true"></i>
                                </button>
                            </form>
                        }
                        <a asp-action="Edit" asp-route-id="@a.Id" class="acct-btn" aria-label="Edit account" title="Edit">
                            <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                        <a asp-action="Delete" asp-route-id="@a.Id" class="acct-btn is-danger" aria-label="Delete account" title="Delete">
                            <i class="bi bi-trash" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>

                <h2 class="acct-name">@a.Name</h2>
                <div class="acct-meta">
                    <span class="acct-type">@a.Type.ToString().ToUpperInvariant()</span>
                    @if (a.IsPrimary)
                    {
                        <span class="acct-primary" title="Debt settlements land here">
                            <i class="bi bi-star-fill" aria-hidden="true"></i>Primary
                        </span>
                    }
                    @if (!a.IsActive)
                    {
                        <span class="acct-inactive">Inactive</span>
                    }
                </div>

                <div class="acct-balance @(bal < 0 ? "is-neg" : "")">
                    @(bal < 0 ? "−" : "")@MoneyFormat.Full(Math.Abs(bal))
                </div>
                <div class="acct-opening">Opening balance &middot; @MoneyFormat.Full(a.OpeningBalance)</div>
            </article>
        }
    </div>
}
