@model ExpenseTracker.Models.Domain.Account

@{
    ViewData["Title"] = "Delete Account";
    var usage = (int)(ViewData["UsageCount"] ?? 0);
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Delete account</div>
    <h1><i class="bi bi-trash me-2"></i>Delete Account</h1>
    <p><a asp-action="Index" class="text-decoration-none">Accounts</a> / Delete</p>
</div>

<div class="row"><div class="col-md-6">
    <div class="delete-warning mb-3">
        <i class="bi bi-exclamation-triangle-fill me-1"></i>
        @if (usage > 0)
        {
            <span>
                This account is referenced by <strong>@usage</strong> transaction(s) / transfer(s).
                If you delete it, the AccountId on those expense/income rows will be cleared (history preserved).
                Transfers referencing this account will <strong>block deletion</strong>.
            </span>
        }
        else
        {
            <span>Are you sure you want to delete this account? This cannot be undone.</span>
        }
    </div>
    <div class="card mb-3"><div class="card-body p-0">
        <table class="table table-hover mb-0">
            <tbody>
                <tr>
                    <th scope="row" style="width:40%;">Name</th>
                    <td>@Model.Name</td>
                </tr>
                <tr>
                    <th scope="row">Type</th>
                    <td>@Model.Type</td>
                </tr>
                <tr>
                    <th scope="row">Opening</th>
                    <td class="text-tabular t-balance">@Model.OpeningBalance.ToString("C2", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                </tr>
            </tbody>
        </table>
    </div></div>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div></div>
