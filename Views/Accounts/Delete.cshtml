@model ExpenseTracker.Models.Domain.Account

@{
    ViewData["Title"] = "Delete Account";
    var usage = (int)(ViewData["UsageCount"] ?? 0);
}

<div class="page-header">
    <h1><i class="bi bi-trash me-2"></i>Delete Account</h1>
    <p><a asp-action="Index" class="text-decoration-none">Accounts</a> / Delete</p>
</div>

<div class="row"><div class="col-md-6"><div class="card"><div class="card-body">
    @if (usage > 0)
    {
        <div class="alert alert-warning">
            <i class="bi bi-exclamation-triangle-fill me-1"></i>
            This account is referenced by <strong>@usage</strong> transaction(s) / transfer(s).
            If you delete it, the AccountId on those expense/income rows will be cleared (history preserved).
            Transfers referencing this account will <strong>block deletion</strong>.
        </div>
    }
    else
    {
        <p class="text-muted">Are you sure you want to delete this account?</p>
    }
    <dl class="row mb-3">
        <dt class="col-sm-4">Name</dt><dd class="col-sm-8">@Model.Name</dd>
        <dt class="col-sm-4">Type</dt><dd class="col-sm-8">@Model.Type</dd>
        <dt class="col-sm-4">Opening</dt><dd class="col-sm-8">@Model.OpeningBalance.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
    </form>
</div></div></div></div>
