@using Microsoft.AspNetCore.Mvc.Rendering
@model ExpenseTracker.Models.Domain.Expense

@{
    ViewData["Title"] = "Add Expense";
    string currentYearMonth = DateTime.Now.ToString("yyyy-MM");
    var categories = (SelectList)ViewData["Categories"]!;
    var accounts = ViewData["Accounts"] as SelectList;
}

<div class="create-page-header illus-expense">
    <i class="bi bi-cash-stack header-icon"></i>
    <h1>Add Expense</h1>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="card create-form-card" style="border-top-color: #1565c0;">
            <div class="card-body">
                <form asp-action="Create" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control text-tabular" inputmode="decimal" aria-required="true" aria-describedby="amountHelp" />
                        </div>
                        <small id="amountHelp" class="form-text">In Indian rupees.</small>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Date" class="form-label"></label>
                        <input asp-for="Date" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Date" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <input asp-for="Description" class="form-control" />
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label asp-for="CategoryId" class="form-label"></label>
                        <select asp-for="CategoryId" class="form-select" asp-items="@categories">
                            <option value="">-- Select Category --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                        <div class="form-text">
                            Don't see what you need? <a asp-controller="Categories" asp-action="Create" asp-route-type="Expense">Add a new category</a>.
                        </div>
                    </div>
                    @if (accounts != null && accounts.Any())
                    {
                        <div class="form-group mb-3">
                            <label asp-for="AccountId" class="form-label"></label>
                            <select asp-for="AccountId" class="form-select" asp-items="@accounts">
                                <option value="">— none —</option>
                            </select>
                            <span asp-validation-for="AccountId" class="text-danger"></span>
                            <div class="form-text">Optional. Track which wallet/account this came from.</div>
                        </div>
                    }
                    <div class="form-group mb-3">
                        <label asp-for="Month" class="form-label">Month (yyyy-MM)</label>
                        <input asp-for="Month" class="form-control" value="@currentYearMonth" placeholder="@currentYearMonth" />
                        <span asp-validation-for="Month" class="text-danger"></span>
                    </div>
                    <div class="form-group mb-3">
                        <label for="receipt" class="form-label">Receipt <span class="text-muted">(optional, JPG/PNG/WEBP/PDF, max 5 MB)</span></label>
                        <input type="file" name="receipt" id="receipt" class="form-control" accept="image/jpeg,image/png,image/webp,application/pdf" />
                        @if (ViewData.ModelState["receipt"]?.Errors.Any() == true)
                        {
                            <div class="text-danger">@ViewData.ModelState["receipt"]!.Errors.First().ErrorMessage</div>
                        }
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
                        <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
        <div class="create-illustration illus-expense">
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <span class="illus-particle"><i class="bi bi-coin"></i></span>
            <span class="illus-particle"><i class="bi bi-receipt"></i></span>
            <span class="illus-particle"><i class="bi bi-cart3"></i></span>
            <span class="illus-particle"><i class="bi bi-credit-card"></i></span>
            <span class="illus-particle"><i class="bi bi-bag"></i></span>
            <i class="bi bi-wallet2 illus-icon"></i>
            <div class="illus-title">Track Every Rupee</div>
            <div class="illus-subtitle">Recording your expenses is the first step towards better financial health.</div>
            <div class="create-tip">
                <i class="bi bi-lightbulb-fill"></i> Tip: Categorize expenses accurately for insightful reports.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
