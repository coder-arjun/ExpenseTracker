@using System.Globalization
@using Microsoft.AspNetCore.Mvc.Rendering
@model ExpenseTracker.Models.PaginatedList<ExpenseTracker.Models.Domain.Expense>

@*
    Presentation only. Every form field name, route value, id and JS hook is unchanged —
    filters, export links, bulk delete and the inline-confirm delete all behave exactly
    as before. What changed is hierarchy: surfaces, typography, numeric alignment and
    the removal of per-icon boxes.
*@

@{
    ViewData["Title"] = "Expenses";
    var inr = CultureInfo.GetCultureInfo("en-IN");
    var selectedCategory = ViewData["SelectedCategory"] as int?;
    var selectedCategoryName = ViewData["SelectedCategoryName"] as string;
    var filteredTotal = (decimal)(ViewData["FilteredTotal"] ?? 0m);
    var filteredCount = (int)(ViewData["FilteredCount"] ?? 0);
    var categories = (SelectList)ViewData["Categories"]!;

    var metricLabel = !string.IsNullOrEmpty(selectedCategoryName)
        ? $"{selectedCategoryName} expenses"
        : "Total expenses";

    // Period caption comes only from the filter the user actually applied — no invented data.
    var filterType = ViewData["FilterType"]?.ToString();
    var selMonth = ViewData["SelectedMonth"]?.ToString();
    var selYear = ViewData["SelectedYear"]?.ToString();
    string? periodCaption = null;
    if (filterType == "Month" && !string.IsNullOrEmpty(selMonth)
        && DateTime.TryParseExact(selMonth, "yyyy-MM", CultureInfo.InvariantCulture, DateTimeStyles.None, out var pm))
        periodCaption = pm.ToString("MMMM yyyy", inr);
    else if (filterType == "Year" && !string.IsNullOrEmpty(selYear))
        periodCaption = selYear;
    else if (filterType == "DateRange")
        periodCaption = "Selected range";
    else
        periodCaption = "All time";

    var hasFilter = !string.IsNullOrEmpty(filterType) || selectedCategory.HasValue;
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
    <div class="page-head mb-0">
        <h1>Expenses</h1>
        <p class="page-lede">Manage and track every outflow.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group flex-fill flex-sm-grow-0">
            <button type="button" class="btn btn-outline-secondary dropdown-toggle w-100" data-bs-toggle="dropdown" aria-expanded="false">
                Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="xlsx"
                       asp-route-filterType="@ViewData["FilterType"]" asp-route-selectedMonth="@ViewData["SelectedMonth"]"
                       asp-route-selectedYear="@ViewData["SelectedYear"]" asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]" asp-route-selectedCategory="@(selectedCategory?.ToString())">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Excel (.xlsx)
                </a></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="pdf"
                       asp-route-filterType="@ViewData["FilterType"]" asp-route-selectedMonth="@ViewData["SelectedMonth"]"
                       asp-route-selectedYear="@ViewData["SelectedYear"]" asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]" asp-route-selectedCategory="@(selectedCategory?.ToString())">
                    <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>PDF
                </a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="csv"
                       asp-route-filterType="@ViewData["FilterType"]" asp-route-selectedMonth="@ViewData["SelectedMonth"]"
                       asp-route-selectedYear="@ViewData["SelectedYear"]" asp-route-startDate="@ViewData["StartDate"]"
                       asp-route-endDate="@ViewData["EndDate"]" asp-route-selectedCategory="@(selectedCategory?.ToString())">
                    <i class="bi bi-filetype-csv me-2 text-secondary"></i>CSV
                </a></li>
            </ul>
        </div>
        <a asp-action="Create" class="btn btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-lg me-1"></i>Add expense
        </a>
    </div>
</div>

@* ── Filters: same fields, same names, quieter chrome ─────────────── *@
<div class="xp-filters sticky-filter">
    <div class="xp-filters-title">Filters</div>
    <form method="get" asp-action="Index" class="row g-3 align-items-end" data-persist-key="expenses">
        <div class="col-6 col-md-2">
            <label class="form-label" for="filterType">Period</label>
            <select name="filterType" id="filterType" class="form-select" onchange="toggleFilterInputs()">
                <option value="">All time</option>
                <option value="Month" selected="@(filterType == "Month" ? "selected" : null)">Month</option>
                <option value="Year" selected="@(filterType == "Year" ? "selected" : null)">Year</option>
                <option value="DateRange" selected="@(filterType == "DateRange" ? "selected" : null)">Date range</option>
            </select>
        </div>
        <div class="col-6 col-md-2" id="monthInput" style="display:none;">
            <label class="form-label">Month</label>
            <input type="month" name="selectedMonth" class="form-control" value="@ViewData["SelectedMonth"]" />
        </div>
        <div class="col-6 col-md-2" id="yearInput" style="display:none;">
            <label class="form-label">Year</label>
            <input type="number" name="selectedYear" class="form-control" min="2020" max="2030" value="@ViewData["SelectedYear"]" />
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label">Category</label>
            <select name="selectedCategory" class="form-select" asp-items="@categories">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-6 col-md-2" id="startDateInput" style="display:none;">
            <label class="form-label">Start date</label>
            <input type="date" name="startDate" class="form-control" value="@ViewData["StartDate"]" />
        </div>
        <div class="col-6 col-md-2" id="endDateInput" style="display:none;">
            <label class="form-label">End date</label>
            <input type="date" name="endDate" class="form-control" value="@ViewData["EndDate"]" />
        </div>
        <div class="col-md-auto ms-md-auto">
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary ms-1">Clear</a>
            }
        </div>
    </form>
</div>

@* ── The headline figure ──────────────────────────────────────────── *@
@if (filteredCount > 0)
{
    <section class="xp-metric" aria-label="@metricLabel">
        <div>
            <div class="xp-metric-label">@metricLabel</div>
            <span class="xp-metric-value">&minus;@filteredTotal.ToString("C0", inr)</span>
        </div>
        <div class="xp-metric-meta">
            <div class="xp-metric-count">@filteredCount.ToString("N0", inr) transaction@(filteredCount == 1 ? "" : "s")</div>
            <div class="xp-metric-period">@periodCaption</div>
        </div>
    </section>
}

@if (!Model.Any())
{
    ViewData["EmptyIcon"] = "cash-stack";
    ViewData["EmptyTitle"] = "No expenses match this view";
    ViewData["EmptyBody"] = "Add your first expense or change the filter above.";
    ViewData["EmptyCtaText"] = "Add Expense";
    ViewData["EmptyCtaUrl"] = Url.Action("Create");
    <partial name="_EmptyState" />
}
else
{
    @* Bulk-delete posts via this standalone form; checkboxes associate with it through
       the HTML5 form="bulkForm" attribute. The table is intentionally NOT wrapped in it,
       so the per-row delete forms are not nested (nested <form>s duplicated the
       antiforgery token → BulkDelete 400). *@
    <form id="bulkForm" asp-action="BulkDelete" method="post" class="d-none">
        @Html.AntiForgeryToken()
    </form>

    <table class="xp-table">
        <thead>
            <tr>
                <th class="xp-select">
                    <input type="checkbox" id="bulkSelectAll" class="form-check-input" aria-label="Select all rows" />
                </th>
                <th>Date</th>
                <th>Description</th>
                <th>Category</th>
                <th class="xp-amount">Amount</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="xp-select" data-label="Select">
                        <input type="checkbox" class="form-check-input bulk-row" name="ids" value="@item.Id" form="bulkForm" aria-label="Select expense" />
                    </td>
                    <td class="xp-date" data-label="Date">
                        @item.Date.ToString("dd MMM", inr)
                        <small>@item.Date.ToString("yyyy", inr)</small>
                    </td>
                    <td class="xp-desc" data-label="Description">
                        @if (string.IsNullOrWhiteSpace(item.Description))
                        {
                            <span class="none">No description</span>
                        }
                        else
                        {
                            @item.Description
                        }
                    </td>
                    <td data-label="Category">
                        <span class="xp-tag">@(item.Category?.Name ?? "—")</span>
                    </td>
                    <td class="xp-amount" data-label="Amount">&minus;@item.Amount.ToString("C2", inr)</td>
                    <td data-label="Actions">
                        <div class="xp-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm" aria-label="Edit" title="Edit">
                                <i class="bi bi-pencil" aria-hidden="true"></i>
                            </a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm" aria-label="View details" title="View details">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </a>
                            <span class="inline-confirm">
                                <button type="button" class="btn btn-sm" data-inline-confirm aria-label="Delete" title="Delete">
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                </button>
                                <span class="inline-confirm-bubble">
                                    <div class="inline-confirm-text">Delete this expense?</div>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                        <button type="button" class="btn btn-sm btn-link inline-confirm-cancel">Cancel</button>
                                    </form>
                                </span>
                            </span>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div id="bulkBar" class="bulk-bar" role="region" aria-live="polite" aria-label="Selection actions">
        <span class="bulk-count" id="bulkCount">0</span>
        <span>selected</span>
        <button type="button" class="btn btn-sm btn-danger" id="bulkDeleteBtn">
            <i class="bi bi-trash me-1"></i>Delete
        </button>
        <button type="button" class="btn-close" id="bulkClear" aria-label="Clear selection"></button>
    </div>
}

@{
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPreviousPage"] = Model.HasPreviousPage;
    ViewData["HasNextPage"] = Model.HasNextPage;
}
<partial name="_PaginationPartial" />

@section Scripts {
    <script src="~/js/persistent-filters.js" asp-append-version="true"></script>
    <script>
        function toggleFilterInputs() {
            var type = document.getElementById('filterType').value;
            document.getElementById('monthInput').style.display = type === 'Month' ? '' : 'none';
            document.getElementById('yearInput').style.display = type === 'Year' ? '' : 'none';
            document.getElementById('startDateInput').style.display = type === 'DateRange' ? '' : 'none';
            document.getElementById('endDateInput').style.display = type === 'DateRange' ? '' : 'none';
        }
        toggleFilterInputs();

        // Bulk-select wiring — unchanged.
        (function () {
            var all = document.getElementById('bulkSelectAll');
            var rows = document.querySelectorAll('.bulk-row');
            var bar = document.getElementById('bulkBar');
            var count = document.getElementById('bulkCount');
            var del = document.getElementById('bulkDeleteBtn');
            var clear = document.getElementById('bulkClear');
            var form = document.getElementById('bulkForm');
            if (!all || rows.length === 0) return;

            function refresh() {
                var selected = Array.from(rows).filter(function (r) { return r.checked; });
                count.textContent = selected.length;
                bar.classList.toggle('show', selected.length > 0);
                all.indeterminate = selected.length > 0 && selected.length < rows.length;
                all.checked = selected.length === rows.length;
            }
            all.addEventListener('change', function () {
                rows.forEach(function (r) { r.checked = all.checked; });
                refresh();
            });
            rows.forEach(function (r) { r.addEventListener('change', refresh); });
            clear.addEventListener('click', function () {
                rows.forEach(function (r) { r.checked = false; });
                refresh();
            });
            del.addEventListener('click', function () {
                if (!confirm('Delete ' + count.textContent + ' expense(s)? This cannot be undone.')) return;
                form.submit();
            });
        })();
    </script>
}
