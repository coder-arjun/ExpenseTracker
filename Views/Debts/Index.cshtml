@using System.Globalization
@using ExpenseTracker.Models.Domain
@using ExpenseTracker.Services
@model ExpenseTracker.Models.PaginatedList<ExpenseTracker.Models.Domain.Debt>

@*
    Presentation only. Same model, same filter parameters (person / direction /
    showSettled), same Settle POST and the same Edit/Details/Delete routes.
    Colour is semantic here: green = owed to you, rose = you owe.
*@

@{
    ViewData["Title"] = "Owed to Me";
    var inr = CultureInfo.GetCultureInfo("en-IN");

    var owedToMe = (decimal)(ViewData["OwedToMe"] ?? 0m);
    var iOwe = (decimal)(ViewData["IOwe"] ?? 0m);
    var net = (decimal)(ViewData["DebtNet"] ?? 0m);
    var overdue = (int)(ViewData["OverdueCount"] ?? 0);

    var fPerson = ViewData["Person"]?.ToString();
    var personOptions = ViewData["PersonOptions"] as List<string> ?? new List<string>();
    var fDirection = ViewData["Direction"]?.ToString();
    var fShowSettled = (bool)(ViewData["ShowSettled"] ?? false);
    var hasFilter = !string.IsNullOrEmpty(fPerson) || !string.IsNullOrEmpty(fDirection) || fShowSettled;

    (string cls, string label, string icon) DirChip(Debt d) => d.Direction == DebtDirection.TheyOweMe
        ? ("owe-in", "Owed to me", "bi-arrow-down-left")
        : ("owe-out", "I owe", "bi-arrow-up-right");

    (string cls, string label, string icon) StatChip(Debt d) => d.Status switch
    {
        DebtStatus.Settled => ("owe-st-settled", "Settled", "bi-check-circle-fill"),
        DebtStatus.PartlyPaid => ("owe-st-partly", "Partly paid", "bi-circle-half"),
        _ => ("owe-st-open", "Outstanding", "bi-circle")
    };

    // Initials from the person's name — display only, no data change.
    string Initials(string name)
    {
        var parts = (name ?? "").Split(new[] { ' ', '&', '/', ',' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "?";
        if (parts.Length == 1) return parts[0].Substring(0, 1).ToUpperInvariant();
        return (parts[0].Substring(0, 1) + parts[1].Substring(0, 1)).ToUpperInvariant();
    }
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-end gap-3 mb-4">
    <div class="page-head has-stroke mb-0">
        <div class="page-eyebrow">Personal ledger</div>
        <h1>Owed to Me</h1>
        <p class="page-lede">Money you're owed, and money you owe.</p>
    </div>
    <div class="d-flex gap-2">
        <div class="btn-group flex-fill flex-sm-grow-0">
            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle w-100" data-bs-toggle="dropdown" aria-expanded="false">
                Export
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="xlsx">
                    <i class="bi bi-file-earmark-spreadsheet me-2 text-success"></i>Excel (.xlsx)
                </a></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="pdf">
                    <i class="bi bi-file-earmark-pdf me-2 text-danger"></i>PDF
                </a></li>
                <li><hr class="dropdown-divider" /></li>
                <li><a class="dropdown-item" asp-action="Export" asp-route-format="csv">
                    <i class="bi bi-filetype-csv me-2 text-secondary"></i>CSV
                </a></li>
            </ul>
        </div>
        <a asp-action="Create" class="btn btn-sm btn-primary flex-fill flex-sm-grow-0">
            <i class="bi bi-plus-lg me-1"></i>Add debt
        </a>
    </div>
</div>

@* ── Filters: one grouped row, same parameters ────────────────────── *@
<div class="xp-filters sticky-filter">
    <div class="xp-filters-title">Filters</div>
    <form method="get" asp-action="Index" class="row g-3 align-items-end">
        <div class="col-6 col-md-3">
            <label class="form-label" for="personFilter">Person</label>
            <select name="person" id="personFilter" class="form-select">
                <option value="">All people</option>
                @foreach (var pn in personOptions)
                {
                    <option value="@pn" selected="@(pn == fPerson ? "selected" : null)">@pn</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-3">
            <label class="form-label" for="directionFilter">Direction</label>
            <select name="direction" id="directionFilter" class="form-select">
                <option value="">All directions</option>
                <option value="TheyOweMe" selected="@(fDirection == "TheyOweMe" ? "selected" : null)">Owed to me</option>
                <option value="IOweThem" selected="@(fDirection == "IOweThem" ? "selected" : null)">I owe</option>
            </select>
        </div>
        <div class="col-auto">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="showSettled" value="true" id="showSettled" @(fShowSettled ? "checked" : null) />
                <label class="form-check-label" for="showSettled">Show settled</label>
            </div>
        </div>
        <div class="col-md-auto ms-md-auto">
            <button type="submit" class="btn btn-sm btn-primary">Apply</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-sm btn-link owe-clear">Clear filters</a>
            }
        </div>
    </form>
</div>

@* ── Position: the net figure is the anchor ───────────────────────── *@
<section class="owe-position" aria-label="Debt position">
    <div class="owe-side">
        <div class="owe-side-item">
            <div class="owe-side-label"><i class="bi bi-arrow-down-left"></i> Owed to you</div>
            <div class="owe-side-value credit" title="@MoneyFormat.Full(owedToMe)">@MoneyFormat.Full(owedToMe)</div>
        </div>
        <div class="owe-side-item">
            <div class="owe-side-label"><i class="bi bi-arrow-up-right"></i> You owe</div>
            <div class="owe-side-value debit" title="@MoneyFormat.Full(iOwe)">@MoneyFormat.Full(iOwe)</div>
        </div>
    </div>
    <div class="owe-net @(net >= 0 ? "is-pos" : "is-neg")">
        <div class="owe-net-label">Net position</div>
        <div class="owe-net-value">@(net >= 0 ? "+" : "−")@MoneyFormat.Full(Math.Abs(net))</div>
        @if (overdue > 0)
        {
            <div class="owe-net-flag"><i class="bi bi-exclamation-triangle-fill"></i> @overdue overdue</div>
        }
    </div>
</section>

@if (!Model.Any() && hasFilter)
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-funnel"></i></div>
        <div class="es-title">No debts match these filters</div>
        <p class="es-body">Try a different name, direction, or turn on “Show settled”.</p>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear filters</a>
    </div>
}
else if (!Model.Any())
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-cash-coin"></i></div>
        <div class="es-title">No debts tracked yet</div>
        <p class="es-body">Lent a friend some cash, or borrowed a little? Record it here so nothing slips through the cracks.</p>
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Add debt</a>
    </div>
}
else
{
    <table class="xp-table owe-table">
        <thead>
            <tr>
                <th>Person</th>
                <th class="owe-dir-col">Direction</th>
                <th class="xp-amount owe-total-col">Total</th>
                <th class="xp-amount">Outstanding</th>
                <th class="owe-status-col">Status</th>
                <th class="owe-due-col">Due</th>
                <th><span class="visually-hidden">Actions</span></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var dir = DirChip(item);
                var st = StatChip(item);
                var settled = item.Outstanding <= 0m;
                <tr class="@(item.Direction == DebtDirection.TheyOweMe ? "is-in" : "is-out")">
                    <td data-label="Person">
                        <span class="owe-person">
                            <span class="owe-avatar" aria-hidden="true">@Initials(item.PersonName)</span>
                            <span class="owe-name">@item.PersonName</span>
                        </span>
                    </td>
                    <td class="owe-dir-col" data-label="Direction">
                        <span class="owe-chip @dir.cls"><i class="bi @dir.icon" aria-hidden="true"></i> @dir.label</span>
                    </td>
                    @* Total recedes; what is still outstanding is the operational number. *@
                    <td class="xp-amount owe-total owe-total-col" data-label="Total">@MoneyFormat.Full(item.Amount)</td>
                    <td class="xp-amount owe-outstanding @(settled ? "is-settled" : "")" data-label="Outstanding">
                        @MoneyFormat.Full(item.Outstanding)
                    </td>
                    <td class="owe-status-col" data-label="Status">
                        <span class="owe-status @st.cls"><i class="bi @st.icon" aria-hidden="true"></i>@st.label</span>
                        @if (item.IsOverdue)
                        {
                            <span class="owe-status owe-st-overdue"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>Overdue</span>
                        }
                    </td>
                    <td class="owe-due-col" data-label="Due">
                        @if (item.DueDate.HasValue)
                        {
                            <span class="owe-due">@item.DueDate.Value.ToString("dd MMM yyyy", inr)</span>
                        }
                        else
                        {
                            <span class="owe-due-none">No due date</span>
                        }
                    </td>
                    <td data-label="Actions">
                        <div class="xp-actions owe-actions">
                            @* The contextual action stays visible; the rest move into a menu. *@
                            @if (item.Outstanding > 0m)
                            {
                                <form asp-action="Settle" asp-route-id="@item.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm owe-settle" aria-label="Mark settled" title="Mark settled">
                                        <i class="bi bi-check2-circle" aria-hidden="true"></i>
                                    </button>
                                </form>
                            }
                            <div class="dropdown d-inline-block">
                                <button type="button" class="btn btn-sm" data-bs-toggle="dropdown" data-bs-boundary="viewport"
                                        aria-expanded="false" aria-label="More actions for @item.PersonName" title="More actions">
                                    <i class="bi bi-three-dots" aria-hidden="true"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end owe-menu">
                                    <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">
                                        <i class="bi bi-pencil me-2"></i>Edit</a></li>
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">
                                        <i class="bi bi-eye me-2"></i>View details</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li><a class="dropdown-item owe-menu-danger" asp-action="Delete" asp-route-id="@item.Id">
                                        <i class="bi bi-trash me-2"></i>Delete</a></li>
                                </ul>
                            </div>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@{
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPreviousPage"] = Model.HasPreviousPage;
    ViewData["HasNextPage"] = Model.HasNextPage;
}
<partial name="_PaginationPartial" />
