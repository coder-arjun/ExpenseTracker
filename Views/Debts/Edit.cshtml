@model ExpenseTracker.Models.Domain.Debt

@{
    ViewData["Title"] = "Edit Debt";
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Amend debt</div>
    <h1><i class="bi bi-pencil me-2"></i>Edit Debt</h1>
    <p><a asp-action="Index" class="text-decoration-none">Owed to Me</a> / Edit</p>
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="form-group mb-3">
                        <label asp-for="Direction" class="form-label">Direction</label>
                        <select asp-for="Direction" class="form-select">
                            <option value="TheyOweMe">Someone owes me</option>
                            <option value="IOweThem">I owe someone</option>
                        </select>
                        <span asp-validation-for="Direction" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PersonName" class="form-label"></label>
                        <input asp-for="PersonName" class="form-control" />
                        <span asp-validation-for="PersonName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="AmountPaid" class="form-label">Amount paid so far</label>
                        <div class="input-currency">
                            <input asp-for="AmountPaid" class="form-control" />
                        </div>
                        <div class="form-text">Capped at the total amount. Use the Details page to log a quick repayment instead.</div>
                        <span asp-validation-for="AmountPaid" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="form-group mb-3 col-sm-6">
                            <label asp-for="Date" class="form-label">Date</label>
                            <input asp-for="Date" type="date" class="form-control" max="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3 col-sm-6">
                            <label asp-for="DueDate" class="form-label">Due date <span class="text-muted">(optional)</span></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Note" class="form-label">Note <span class="text-muted">(optional)</span></label>
                        <input asp-for="Note" class="form-control" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
