@model ExpenseTracker.Models.Domain.Debt

@{
    ViewData["Title"] = "Add Debt";
}

<div class="create-page-header">
    <i class="bi bi-cash-coin header-icon"></i>
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> New IOU</div>
    <h1>Add Debt</h1>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="card create-form-card" style="border-top-color: #15715A;">
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                    <div class="form-group mb-3">
                        <label asp-for="Direction" class="form-label">Direction</label>
                        <select asp-for="Direction" class="form-select">
                            <option value="TheyOweMe">Someone owes me</option>
                            <option value="IOweThem">I owe someone</option>
                        </select>
                        <span asp-validation-for="Direction" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="PersonName" class="form-label"></label>
                        <input asp-for="PersonName" class="form-control" placeholder="e.g. Priya, Landlord, Office" />
                        <span asp-validation-for="PersonName" class="text-danger"></span>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-currency">
                            <input asp-for="Amount" class="form-control" />
                        </div>
                        <span asp-validation-for="Amount" class="text-danger"></span>
                    </div>

                    <div class="row">
                        <div class="form-group mb-3 col-sm-6">
                            <label asp-for="Date" class="form-label">Date</label>
                            <input asp-for="Date" type="date" class="form-control" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>
                        <div class="form-group mb-3 col-sm-6">
                            <label asp-for="DueDate" class="form-label">Due date <span class="text-muted">(optional)</span></label>
                            <input asp-for="DueDate" type="date" class="form-control" />
                            <span asp-validation-for="DueDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <label asp-for="Note" class="form-label">Note <span class="text-muted">(optional)</span></label>
                        <input asp-for="Note" class="form-control" placeholder="What it was for…" />
                        <span asp-validation-for="Note" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-6 d-none d-lg-block">
        <div class="create-illustration illus-saving">
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <div class="illus-ring"></div>
            <span class="illus-particle"><i class="bi bi-people"></i></span>
            <span class="illus-particle"><i class="bi bi-hand-thumbs-up"></i></span>
            <span class="illus-particle"><i class="bi bi-cash"></i></span>
            <span class="illus-particle"><i class="bi bi-clock-history"></i></span>
            <span class="illus-particle"><i class="bi bi-check2-circle"></i></span>
            <i class="bi bi-cash-coin illus-icon"></i>
            <div class="illus-title">Never Forget an IOU</div>
            <div class="illus-subtitle">Track what's lent and borrowed, record repayments as they happen, and settle up with a clear conscience.</div>
            <div class="create-tip">
                <i class="bi bi-lightbulb-fill"></i> Tip: Add a due date and you'll see overdue debts flagged automatically.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
