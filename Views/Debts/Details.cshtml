@using System.Globalization
@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.Debt

@{
    ViewData["Title"] = "Debt Details";
    var inr = CultureInfo.GetCultureInfo("en-IN");
    string Money(decimal a) => a.ToString("C2", inr);
    var isOwedToMe = Model.Direction == DebtDirection.TheyOweMe;
    var dirLabel = isOwedToMe ? "Owed to me" : "I owe";
    var statLabel = Model.Status switch
    {
        DebtStatus.Settled => "Settled",
        DebtStatus.PartlyPaid => "Partly paid",
        _ => "Outstanding"
    };
    var pct = Model.Amount > 0 ? (int)Math.Round((double)(Model.AmountPaid / Model.Amount) * 100) : 0;
    pct = Math.Clamp(pct, 0, 100);
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Debt record</div>
    <h1><i class="bi bi-eye me-2"></i>Debt Details</h1>
    <p><a asp-action="Index" class="text-decoration-none">Owed to Me</a> / Details</p>
</div>

<div class="row g-4">
    <div class="col-md-7">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Person</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PersonName</dd>

                    <dt class="col-sm-4">Direction</dt>
                    <dd class="col-sm-8">@dirLabel</dd>

                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8 text-tabular t-balance fw-semibold">@Money(Model.Amount)</dd>

                    <dt class="col-sm-4">Paid</dt>
                    <dd class="col-sm-8 text-tabular">@Money(Model.AmountPaid)</dd>

                    <dt class="col-sm-4">Outstanding</dt>
                    <dd class="col-sm-8 text-tabular fw-semibold">@Money(Model.Outstanding)</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        @statLabel
                        @if (Model.IsOverdue) { <span class="badge bg-danger ms-1">Overdue</span> }
                    </dd>

                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8 folio">@Model.Date.ToString("dd MMM yyyy")</dd>

                    <dt class="col-sm-4">Due date</dt>
                    <dd class="col-sm-8 folio">@(Model.DueDate?.ToString("dd MMM yyyy") ?? "—")</dd>

                    <dt class="col-sm-4">Note</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</dd>
                </dl>

                <div class="mt-3">
                    <div class="d-flex justify-content-between small text-muted mb-1">
                        <span>@Money(Model.AmountPaid) repaid</span>
                        <span>@pct%</span>
                    </div>
                    <div class="progress" role="progressbar" aria-valuenow="@pct" aria-valuemin="0" aria-valuemax="100" style="height: 8px;">
                        <div class="progress-bar bg-success" style="width: @pct%"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Back to List</a>
        </div>
    </div>

    @if (Model.Outstanding > 0m)
    {
        <div class="col-md-5">
            <div class="card">
                <div class="card-body">
                    <h2 class="h6 mb-3"><i class="bi bi-cash-stack me-1"></i>Record a repayment</h2>
                    <p class="text-muted small">@Money(Model.Outstanding) still outstanding@(isOwedToMe ? " — log what they've paid you back." : " — log what you've paid back.")</p>
                    <form asp-action="Repay" asp-route-id="@Model.Id" method="post" class="mb-3">
                        @Html.AntiForgeryToken()
                        <div class="input-currency mb-2">
                            <input type="number" name="amount" class="form-control" step="0.01" min="0.01"
                                   max="@Model.Outstanding" placeholder="Amount received" inputmode="decimal" />
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-plus-circle me-1"></i>Add repayment</button>
                    </form>
                    <form asp-action="Settle" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-success w-100"><i class="bi bi-check2-circle me-1"></i>Settle in full</button>
                    </form>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-md-5">
            <div class="card">
                <div class="card-body text-center py-4">
                    <div class="display-6 text-success mb-2"><i class="bi bi-check2-circle"></i></div>
                    <div class="fw-semibold">Fully settled</div>
                    <p class="text-muted small mb-0">Nothing outstanding on this one.</p>
                </div>
            </div>
        </div>
    }
</div>
