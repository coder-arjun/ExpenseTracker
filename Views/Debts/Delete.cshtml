@using System.Globalization
@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.Debt

@{
    ViewData["Title"] = "Delete Debt";
    var inr = CultureInfo.GetCultureInfo("en-IN");
    string Money(decimal a) => a.ToString("C0", inr);
    var dirLabel = Model.Direction == DebtDirection.TheyOweMe ? "Owed to me" : "I owe";
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Remove debt</div>
    <h1><i class="bi bi-trash me-2"></i>Delete Debt</h1>
    <p><a asp-action="Index" class="text-decoration-none">Owed to Me</a> / Delete</p>
</div>
<div class="delete-warning">
    <i class="bi bi-exclamation-triangle-fill"></i>
    Are you sure you want to delete this debt? This action cannot be undone.
</div>
<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Person</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.PersonName</dd>
                    <dt class="col-sm-4">Direction</dt>
                    <dd class="col-sm-8">@dirLabel</dd>
                    <dt class="col-sm-4">Amount</dt>
                    <dd class="col-sm-8 text-tabular t-balance fw-semibold">@Money(Model.Amount)</dd>
                    <dt class="col-sm-4">Outstanding</dt>
                    <dd class="col-sm-8 text-tabular">@Money(Model.Outstanding)</dd>
                    <dt class="col-sm-4">Date</dt>
                    <dd class="col-sm-8 folio">@Model.Date.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-4">Note</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Note) ? "—" : Model.Note)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>
<div class="mt-3">
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button>
        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
    </form>
</div>
