@model ExpenseTracker.Models.ViewModel.SearchResultsViewModel
@{
    ViewData["Title"] = "Search";
    var q = Model.Query;
}

<div class="page-header mb-4">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Search the ledger</div>
    <h1>Search</h1>
    @if (!string.IsNullOrEmpty(q))
    {
        <p>@Model.TotalCount result@(Model.TotalCount == 1 ? "" : "s") for &ldquo;@q&rdquo;</p>
    }
</div>

<form method="get" asp-action="Results" class="mb-4">
    <div class="input-group input-group-lg">
        <span class="input-group-text"><i class="bi bi-search"></i></span>
        <input type="search" name="q" value="@q" class="form-control"
               placeholder="Search expenses, categories or pages…" autofocus autocomplete="off" />
        <button class="btn btn-primary px-4" type="submit">Search</button>
    </div>
</form>

@if (string.IsNullOrEmpty(q))
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-search"></i></div>
        <div class="es-title">Look something up</div>
        <p class="es-body">Search across every expense, category and page in your ledger. Tip: press <kbd>/</kbd> anywhere to jump straight here.</p>
    </div>
}
else if (!Model.HasAny)
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-emoji-frown"></i></div>
        <div class="es-title">Nothing matched &ldquo;@q&rdquo;</div>
        <p class="es-body">Try a shorter or different term.</p>
    </div>
}
else
{
    @if (Model.Nav.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Navigation</div>
            <div class="list-group list-group-flush">
                @foreach (var n in Model.Nav)
                {
                    <a href="@n.Url" class="list-group-item list-group-item-action d-flex align-items-center">
                        <i class="bi bi-@n.Icon me-2 text-danger"></i>@n.Label
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Categories.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Categories</div>
            <div class="list-group list-group-flush">
                @foreach (var c in Model.Categories)
                {
                    <a href="@c.Url" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-tag me-2"></i>@c.Name</span>
                        <span class="badge bg-secondary">@c.Type</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Expenses.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Expenses</div>
            <div class="list-group list-group-flush">
                @foreach (var e in Model.Expenses)
                {
                    <a href="@e.Url" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                        <span><i class="bi bi-cash me-2"></i>@(e.Description ?? "(no description)")</span>
                        <span class="text-muted small text-tabular t-expense">&minus;@e.Amount &middot; @e.Month</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Events.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Events</div>
            <div class="list-group list-group-flush">
                @foreach (var e in Model.Events)
                {
                    <a href="@e.Url" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                        <span>
                            <i class="bi bi-calendar-event me-2"></i>@e.Name
                            <span class="text-muted small ms-2">@e.Context</span>
                        </span>
                        <span class="text-muted small text-tabular">@e.Amount</span>
                    </a>
                }
            </div>
        </div>
    }

    @if (Model.Debts.Count > 0)
    {
        <div class="card mb-3">
            <div class="card-header">Owed to Me</div>
            <div class="list-group list-group-flush">
                @foreach (var d in Model.Debts)
                {
                    <a href="@d.Url" class="list-group-item list-group-item-action d-flex align-items-center justify-content-between">
                        <span>
                            <i class="bi @(d.TheyOweMe ? "bi-arrow-down-left text-success" : "bi-arrow-up-right text-danger") me-2"></i>@d.Person
                        </span>
                        <span class="text-muted small">
                            <span class="badge @(d.TheyOweMe ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger") me-2">@d.Direction</span>
                            <span class="text-tabular">@d.Outstanding</span>
                        </span>
                    </a>
                }
            </div>
        </div>
    }
}
