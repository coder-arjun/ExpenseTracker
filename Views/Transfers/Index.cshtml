@model ExpenseTracker.Models.PaginatedList<ExpenseTracker.Models.Domain.Transfer>

@{ ViewData["Title"] = "Transfers"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div class="page-header mb-0">
        <h1><i class="bi bi-arrow-left-right me-2"></i>Transfers</h1>
        <p>Move money between your accounts.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>New Transfer</a>
</div>

@if (!Model.Any())
{
    <div class="card"><div class="empty-state">
        <i class="bi bi-inbox"></i>
        <p>No transfers yet. Use this to move from your Cash to your Bank, etc.</p>
    </div></div>
}
else
{
    <div class="card"><div class="card-body p-0">
        <table class="table table-hover table-stack table-sticky mb-0 data-table">
            <thead><tr>
                <th>Date</th><th>From</th><th></th><th>To</th><th>Amount</th><th>Note</th><th>Actions</th>
            </tr></thead>
            <tbody>
                @foreach (var t in Model)
                {
                    <tr>
                        <td>@t.Date.ToString("yyyy-MM-dd")</td>
                        <td>@(t.FromAccount?.Name ?? "—")</td>
                        <td class="text-muted"><i class="bi bi-arrow-right"></i></td>
                        <td>@(t.ToAccount?.Name ?? "—")</td>
                        <td class="fw-semibold">@t.Amount.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-IN"))</td>
                        <td>@t.Description</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@t.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="Delete" asp-route-id="@t.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}

@{
    ViewData["PageIndex"] = Model.PageIndex;
    ViewData["TotalPages"] = Model.TotalPages;
    ViewData["HasPreviousPage"] = Model.HasPreviousPage;
    ViewData["HasNextPage"] = Model.HasNextPage;
}
<partial name="_PaginationPartial" />
