@using Microsoft.AspNetCore.Mvc.Rendering
@model ExpenseTracker.Models.Domain.Transfer

@{
    ViewData["Title"] = "Edit Transfer";
    var accounts = (SelectList)ViewData["Accounts"]!;
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Edit transfer</div>
    <h1><i class="bi bi-pencil me-2"></i>Edit Transfer</h1>
    <p><a asp-action="Index" class="text-decoration-none">Transfers</a> / Edit</p>
</div>

<div class="row"><div class="col-md-6"><div class="card"><div class="card-body">
    <form asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FromAccountId" class="form-label">From</label>
                <select asp-for="FromAccountId" class="form-select" asp-items="@accounts"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="ToAccountId" class="form-label">To</label>
                <select asp-for="ToAccountId" class="form-select" asp-items="@accounts"></select>
            </div>
            <div class="col-md-6">
                <label asp-for="Amount" class="form-label"></label>
                <div class="input-currency">
                    <input asp-for="Amount" class="form-control" type="number" step="0.01" />
                </div>
            </div>
            <div class="col-md-6">
                <label asp-for="Date" class="form-label"></label>
                <input asp-for="Date" type="date" class="form-control" />
            </div>
            <div class="col-12">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Save</button>
            <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
        </div>
    </form>
</div></div></div></div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
