@using System.Text.Json
@using Microsoft.AspNetCore.Mvc.Rendering
@using ExpenseTracker.Services
@model ExpenseTracker.Models.Domain.Transfer

@*
    Presentation only. FromAccountId, ToAccountId, Amount, Date and Description keep
    their exact names and bindings, and every server-side rule (same-account, amount
    greater than zero, ownership) is untouched. The summary panel only visualises what
    the form already contains — it never decides whether a transfer is valid.
*@

@{
    ViewData["Title"] = "New Transfer";
    var accounts = (SelectList)ViewData["Accounts"]!;
    // Tolerate a missing key so a validation re-render can never break the page.
    var accountMeta = ViewData["AccountMeta"];
    var metaJson = accountMeta != null ? JsonSerializer.Serialize(accountMeta) : "[]";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
}

<a asp-action="Index" class="ev-back"><i class="bi bi-arrow-left"></i> All transfers</a>

<div class="page-head has-stroke">
    <div class="page-eyebrow">New transfer</div>
    <h1>New transfer</h1>
    <p class="page-lede">Move money between your accounts.</p>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-7">
        <form asp-action="Create" id="tfrForm" class="tfr-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            @* From and To read as one movement, not two unrelated fields. *@
            <div class="tfr-route">
                <label class="tfr-leg">
                    <span class="xp-label">From</span>
                    <select asp-for="FromAccountId" class="form-select" asp-items="@accounts" id="tfrFrom">
                        <option value="">Select source account</option>
                    </select>
                    <span asp-validation-for="FromAccountId" class="text-danger"></span>
                </label>
                <span class="tfr-arrow" aria-hidden="true"><i class="bi bi-arrow-left-right"></i></span>
                <label class="tfr-leg">
                    <span class="xp-label">To</span>
                    <select asp-for="ToAccountId" class="form-select" asp-items="@accounts" id="tfrTo">
                        <option value="">Select destination account</option>
                    </select>
                    <span asp-validation-for="ToAccountId" class="text-danger"></span>
                </label>
            </div>

            @* The amount is the decision on this page, so it leads. *@
            <div class="xp-field">
                <label asp-for="Amount" class="xp-label">Transfer amount</label>
                <div class="xp-money is-hero">
                    <span class="xp-money-prefix" aria-hidden="true">&#8377;</span>
                    <input asp-for="Amount" type="number" step="0.01" min="0.01"
                           inputmode="decimal" placeholder="0.00" id="tfrAmount" />
                </div>
                <span asp-validation-for="Amount" class="text-danger"></span>
            </div>

            <div class="tfr-minor">
                <div class="xp-field">
                    <label asp-for="Date" class="xp-label">Date</label>
                    <input asp-for="Date" type="date" class="form-control form-control-sm" id="tfrDate" />
                    <div class="xp-date-echo" id="tfrDateEcho" aria-live="polite"></div>
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="xp-field">
                    <label asp-for="Description" class="xp-label">Description <em>(optional)</em></label>
                    <input asp-for="Description" class="form-control form-control-sm"
                           placeholder="What was it for?" />
                </div>
            </div>

            <hr class="hairline my-4" />

            <div class="d-flex gap-2 align-items-center">
                <button type="submit" class="btn btn-primary btn-lg">Create transfer</button>
                <a asp-action="Index" class="btn btn-link tfr-cancel">Cancel</a>
            </div>
        </form>
    </div>

    @* Shows what is about to happen — it does not decide whether it can. *@
    <div class="col-lg-5">
        <aside class="xp-panel tfr-summary" aria-label="Transfer summary" aria-live="polite">
            <div class="xp-panel-eyebrow">Transfer summary</div>

            <div class="tfr-node" id="tfrNodeFrom">
                <div class="tfr-node-label">From</div>
                <div class="tfr-node-body is-empty">
                    <span class="tfr-node-name">Select source account</span>
                </div>
            </div>

            <div class="tfr-flow" aria-hidden="true"><i class="bi bi-arrow-down"></i></div>

            <div class="tfr-node" id="tfrNodeTo">
                <div class="tfr-node-label">To</div>
                <div class="tfr-node-body is-empty">
                    <span class="tfr-node-name">Select destination account</span>
                </div>
            </div>

            <div class="tfr-amount-row">
                <span class="tfr-amount-label">Transfer amount</span>
                <span class="tfr-amount-value" id="tfrSumAmount">@MoneyFormat.Full(0)</span>
            </div>

            <div class="tfr-impact" id="tfrImpact" hidden>
                <div class="tfr-impact-label">After transfer</div>
                <ul class="tfr-impact-list">
                    <li><span class="n" id="tfrImpFromName"></span><span class="v" id="tfrImpFrom"></span></li>
                    <li><span class="n" id="tfrImpToName"></span><span class="v" id="tfrImpTo"></span></li>
                </ul>
            </div>

            <p class="tfr-note" id="tfrNote" hidden></p>
        </aside>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        // Display only. Mirrors the form into the summary panel and previews the
        // resulting balances. The server still decides whether the transfer is valid.
        (function () {
            var META = @Html.Raw(metaJson);
            if (!Array.isArray(META)) META = [];
            var byId = {};
            META.forEach(function (a) { byId[String(a.id)] = a; });

            var ICONS = { Cash: 'bi-cash-coin', Bank: 'bi-bank', Credit: 'bi-credit-card',
                          Wallet: 'bi-wallet', UPI: 'bi-phone' };
            var nf = new Intl.NumberFormat('en-IN', { style: 'currency', currency: 'INR', minimumFractionDigits: 2 });
            function money(n) {
                try { return nf.format(n).replace(/ | /g, ''); }
                catch (e) { return '₹' + Number(n).toFixed(2); }
            }
            var MONTHS = ['January','February','March','April','May','June',
                          'July','August','September','October','November','December'];

            var from = document.getElementById('tfrFrom');
            var to = document.getElementById('tfrTo');
            var amount = document.getElementById('tfrAmount');
            var date = document.getElementById('tfrDate');
            var echo = document.getElementById('tfrDateEcho');
            var sumAmount = document.getElementById('tfrSumAmount');
            var impact = document.getElementById('tfrImpact');
            var note = document.getElementById('tfrNote');

            function renderNode(el, acc, placeholder) {
                var body = el.querySelector('.tfr-node-body');
                if (!acc) {
                    body.className = 'tfr-node-body is-empty';
                    body.innerHTML = '<span class="tfr-node-name">' + placeholder + '</span>';
                    return;
                }
                body.className = 'tfr-node-body';
                body.innerHTML =
                    '<span class="tfr-node-mark" data-acct-type="' + acc.type + '">' +
                    '<i class="bi ' + (ICONS[acc.type] || 'bi-wallet2') + '"></i></span>' +
                    '<span class="tfr-node-text">' +
                    '<span class="tfr-node-name">' + acc.name + '</span>' +
                    '<span class="tfr-node-bal">' + money(acc.balance) + ' available</span>' +
                    '</span>';
            }

            function sync() {
                var f = byId[from.value] || null;
                var t = byId[to.value] || null;
                var amt = parseFloat(amount.value);
                if (isNaN(amt) || amt < 0) amt = 0;

                renderNode(document.getElementById('tfrNodeFrom'), f, 'Select source account');
                renderNode(document.getElementById('tfrNodeTo'), t, 'Select destination account');
                sumAmount.textContent = money(amt);

                if (date && echo) {
                    var p = (date.value || '').split('-');
                    echo.textContent = (p.length === 3 && MONTHS[parseInt(p[1], 10) - 1])
                        ? p[2].padStart(2, '0') + ' ' + MONTHS[parseInt(p[1], 10) - 1] + ' ' + p[0] : '';
                }

                // Preview the resulting balances once both ends and an amount are known.
                if (f && t && f.id !== t.id && amt > 0) {
                    document.getElementById('tfrImpFromName').textContent = f.name;
                    document.getElementById('tfrImpToName').textContent = t.name;
                    document.getElementById('tfrImpFrom').textContent =
                        money(f.balance) + ' → ' + money(f.balance - amt);
                    document.getElementById('tfrImpTo').textContent =
                        money(t.balance) + ' → ' + money(t.balance + amt);
                    impact.hidden = false;
                } else {
                    impact.hidden = true;
                }

                // A hint, not a gate — the server still rejects it.
                if (f && t && f.id === t.id) {
                    note.textContent = 'Source and destination are the same account.';
                    note.hidden = false;
                } else if (f && amt > 0 && amt > f.balance) {
                    note.textContent = 'This is more than the current balance of ' + f.name + '.';
                    note.hidden = false;
                } else {
                    note.hidden = true;
                }
            }

            [from, to, amount, date].forEach(function (el) {
                if (!el) return;
                el.addEventListener('input', sync);
                el.addEventListener('change', sync);
            });
            sync();
        })();
    </script>
}
