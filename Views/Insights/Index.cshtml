@using System.Globalization
@using System.Text
@using System.Text.Json
@using Markdig
@using ExpenseTracker.Services
@model ExpenseTracker.Services.FinancialSnapshot?

@{
    ViewData["Title"] = "Insights";
    var period = (string)ViewData["Period"]!;
    var options = (List<string>)ViewData["PeriodOptions"]!;
    var generatedAt = ViewData["GeneratedAt"] as DateTime?;
    var isMtd = (bool)(ViewData["IsMonthToDate"] ?? false);
    var markdown = ViewData["Markdown"] as string;
    var hasContent = !string.IsNullOrEmpty(markdown);
    var debtSummary = ViewData["DebtSummary"] as ExpenseTracker.Models.ViewModel.DebtSummaryViewModel;
    var inr = CultureInfo.GetCultureInfo("en-IN");

    string LabelFor(string p)
    {
        if (p == ExpenseTracker.Controllers.InsightsController.MonthToDateKey)
            return $"This month so far ({DateTime.Now:MMM} 1–{DateTime.Now.Day})";
        var d = DateTime.ParseExact(p, "yyyy-MM", CultureInfo.InvariantCulture);
        return d.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    }

    string Money(decimal a) => a.ToString("C0", inr);

    // Map each narrative section heading to an icon + accent colour.
    (string icon, string accent) SectionStyle(string title)
    {
        var t = title.ToLowerInvariant();
        if (t.Contains("overview")) return ("bi-binoculars", "ink");
        if (t.Contains("leak")) return ("bi-droplet-half", "red");
        if (t.Contains("save")) return ("bi-piggy-bank", "green");
        if (t.Contains("budget")) return ("bi-bullseye", "brass");
        if (t.Contains("first") || t.Contains("do these")) return ("bi-flag", "ink");
        return ("bi-card-text", "ink");
    }

    // Markdig pipeline (pipe tables for "A budget to aim for", etc.).
    var pipeline = new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();

    // Split the cached/rendered Markdown into ## sections + pull the trailing
    // _disclaimer_ line out so we can render it as a footnote. Zero info is lost —
    // every section's prose is rendered, just inside styled cards.
    var sections = new List<(string title, string body)>();
    var disclaimer = "";
    if (hasContent)
    {
        var lines = markdown!.Replace("\r\n", "\n").Split('\n').ToList();
        for (int i = lines.Count - 1; i >= 0; i--)
        {
            var t = lines[i].Trim();
            if (t.Length == 0) continue;
            if (t.StartsWith("_") && t.EndsWith("_") && t.Length > 2)
            {
                disclaimer = t.Trim('_').Trim();
                lines.RemoveAt(i);
            }
            break;
        }
        string? curTitle = null;
        var cur = new StringBuilder();
        foreach (var line in lines)
        {
            if (line.StartsWith("## "))
            {
                if (curTitle != null) sections.Add((curTitle, cur.ToString().Trim()));
                curTitle = line.Substring(3).Trim();
                cur.Clear();
            }
            else { cur.AppendLine(line); }
        }
        if (curTitle != null) sections.Add((curTitle, cur.ToString().Trim()));
    }

    // Snapshot-derived figures for the visual layer.
    var s = Model;
    var hasData = s != null && (s.TotalIncome != 0 || s.TotalExpenses != 0);
    decimal income = s?.TotalIncome ?? 0, expenses = s?.TotalExpenses ?? 0;
    decimal net = income - expenses;
    var savingsPct = (int)Math.Round((s?.SavingsRate ?? 0) * 100);
    var gaugeFill = Math.Clamp((double)(s?.SavingsRate ?? 0), 0d, 1d);
    const double circ = 326.726; // 2πr, r = 52
    var gaugeOffset = (circ * (1 - gaugeFill)).ToString("0.0", CultureInfo.InvariantCulture);
    var incomeMax = (double)Math.Max(1m, Math.Max(income, expenses));

    string PeriodLabel()
    {
        if (isMtd) return $"1–{DateTime.Now.Day} {DateTime.Now:MMMM yyyy}";
        var d = DateTime.ParseExact(period, "yyyy-MM", CultureInfo.InvariantCulture);
        return d.ToString("MMMM yyyy", CultureInfo.InvariantCulture);
    }

    // Doughnut data: top 7 categories + "Other".
    var cats = s?.Categories ?? new List<CategorySpend>();
    var topCats = cats.Take(7).ToList();
    var otherSum = cats.Skip(7).Sum(c => c.Amount);
    var doughLabels = topCats.Select(c => c.Category).ToList();
    var doughValues = topCats.Select(c => (double)c.Amount).ToList();
    if (otherSum > 0) { doughLabels.Add("Other"); doughValues.Add((double)otherSum); }
    var palette = new[] { "#C20E3A", "#A87A2C", "#15715A", "#1A1814", "#DA1140", "#876122", "#0F5946", "#8A857A" };
}

<div class="page-header mb-4">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Ledger insights</div>
    <h1><i class="bi bi-lightbulb me-2"></i>Insights</h1>
    <p>A plain-English read on your money, computed locally — nothing leaves your machine.</p>
</div>

<!-- Period + Generate -->
<div class="card mb-4">
    <div class="card-body">
        <form method="post" asp-action="Generate" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Period</label>
                <select name="period" class="form-select">
                    @foreach (var p in options)
                    {
                        <option value="@p" selected="@(p == period ? "selected" : null)">@LabelFor(p)</option>
                    }
                </select>
                <div class="form-text">
                    @if (isMtd)
                    {
                        <span><i class="bi bi-arrow-clockwise me-1"></i>Live — recomputed every visit, not cached.</span>
                    }
                    else
                    {
                        <span>Default is last completed month.</span>
                    }
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-stars me-1"></i>@(hasContent ? "Regenerate" : "Generate")
                </button>
            </div>
            <div class="col-md-auto">
                <button type="submit" formaction="@Url.Action("Email", "Statements")" class="btn btn-outline-secondary"
                        title="Email a PDF statement for the selected month to your registered email">
                    <i class="bi bi-envelope-arrow-up me-1"></i>Email me this (PDF)
                </button>
            </div>
            @if (generatedAt.HasValue)
            {
                <div class="col-md-auto ms-auto text-muted small">
                    Last generated @generatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            }
        </form>
    </div>
</div>

@if (debtSummary?.HasAny == true)
{
    <section class="owed-card mb-4" aria-label="Money owed">
        <div class="owed-card-head">
            <span class="chip"><i class="bi bi-cash-coin"></i></span>
            <h2>Money owed</h2>
            <a asp-controller="Debts" asp-action="Index" class="owed-card-link">Open ledger <i class="bi bi-arrow-right-short"></i></a>
        </div>
        <div class="owed-card-stats">
            <div class="owed-card-stat">
                <div class="l"><i class="bi bi-arrow-down-left"></i> Owed to you</div>
                <div class="v credit">@Money(debtSummary.OwedToMe)</div>
            </div>
            <div class="owed-card-stat">
                <div class="l"><i class="bi bi-arrow-up-right"></i> You owe</div>
                <div class="v debit">@Money(debtSummary.IOwe)</div>
            </div>
            <div class="owed-card-stat owed-card-net">
                <div class="l"><i class="bi bi-safe2"></i> Net</div>
                <div class="v @(debtSummary.Net >= 0 ? "credit" : "debit")">@(debtSummary.Net >= 0 ? "+" : "−")@Money(Math.Abs(debtSummary.Net))</div>
                @if (debtSummary.OverdueCount > 0)
                {
                    <div class="owed-card-overdue"><i class="bi bi-exclamation-triangle-fill"></i> @debtSummary.OverdueCount overdue</div>
                }
            </div>
        </div>
        @if (debtSummary.Top.Count > 0)
        {
            <ul class="owed-card-list">
                @foreach (var d in debtSummary.Top)
                {
                    <li>
                        <span class="nm"><i class="bi @(d.TheyOweMe ? "bi-arrow-down-left" : "bi-arrow-up-right") @(d.TheyOweMe ? "in" : "out")"></i>@d.Name</span>
                        @if (d.Overdue)
                        {
                            <span class="od">Overdue</span>
                        }
                        <span class="amt">@Money(d.Outstanding)</span>
                    </li>
                }
            </ul>
        }
    </section>
}

@if (!hasContent)
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-stars"></i></div>
        <div class="es-title">No insights generated for @LabelFor(period) yet</div>
        <p class="es-body">Click <strong>Generate</strong> above to analyse this period.</p>
    </div>
}
else
{
    <div class="ins" id="insightsRoot">

        @if (hasData)
        {
            <!-- ── HERO · The Reckoning ───────────────────────────── -->
            <section class="ins-hero ins-reveal" aria-label="Summary for @PeriodLabel()">
                <span class="ins-hero-glow" aria-hidden="true"></span>
                <div class="ins-gauge @(savingsPct < 0 ? "is-deficit" : "")" id="insGauge" style="--target-offset:@gaugeOffset;">
                    <svg viewBox="0 0 120 120" aria-hidden="true">
                        <circle class="ins-gauge-track" cx="60" cy="60" r="52"></circle>
                        <circle class="ins-gauge-val" cx="60" cy="60" r="52"></circle>
                    </svg>
                    <div class="ins-gauge-center">
                        <div class="ins-gauge-pct"><span data-countup="@savingsPct" data-countup-format="number">@savingsPct</span><span class="u">%</span></div>
                        <div class="ins-gauge-lbl">@(net >= 0 ? "saved" : "deficit")</div>
                    </div>
                </div>
                <div class="ins-hero-body">
                    <div class="ins-hero-eyebrow"><span class="seal-dot">&#9679;</span> The Reckoning &middot; @PeriodLabel()</div>
                    <div class="ins-stats">
                        <div class="ins-stat">
                            <div class="l"><i class="bi bi-arrow-down-left"></i> Earned</div>
                            <div class="v credit" data-countup="@income" data-countup-format="currency">@Money(income)</div>
                        </div>
                        <div class="ins-stat">
                            <div class="l"><i class="bi bi-arrow-up-right"></i> Spent</div>
                            <div class="v debit" data-countup="@expenses" data-countup-format="currency">@Money(expenses)</div>
                        </div>
                        <div class="ins-stat ins-stat-net">
                            <div class="l"><i class="bi bi-safe2"></i> @(net >= 0 ? "Kept" : "Shortfall")</div>
                            <div class="v net @(net < 0 ? "debit" : "")" data-countup="@Math.Abs(net)" data-countup-format="currency">@Money(Math.Abs(net))</div>
                        </div>
                    </div>
                    @if (isMtd && s!.AsOf.HasValue)
                    {
                        var daysIn = s.AsOf.Value.Day;
                        var totalDays = DateTime.DaysInMonth(s.AsOf.Value.Year, s.AsOf.Value.Month);
                        var monthPct = (int)Math.Round(daysIn * 100.0 / totalDays);
                        <div class="ins-mtd">
                            <div class="ins-mtd-bar"><span style="width:@monthPct%"></span></div>
                            <div class="ins-mtd-text">Day @daysIn of @totalDays — @(totalDays - daysIn) to go</div>
                        </div>
                    }
                </div>
            </section>

            <!-- ── At-a-glance visuals ────────────────────────────── -->
            <div class="ins-grid">
                @if (doughValues.Count > 0)
                {
                    <section class="ins-panel ins-reveal" aria-label="Spending mix">
                        <div class="ins-panel-title acc-red"><span class="chip"><i class="bi bi-pie-chart-fill"></i></span> Where it went</div>
                        <div class="ins-dough-wrap">
                            <div class="ins-dough"><canvas id="insDoughnut" role="img" aria-label="Spending by category for @PeriodLabel()"></canvas>
                                <div class="ins-dough-center"><span class="t">Total</span><span class="a">@Money(expenses)</span></div>
                            </div>
                            <ul class="ins-cats">
                                @{ var ci = 0; }
                                @foreach (var c in cats)
                                {
                                    var col = palette[ci % palette.Length];
                                    ci++;
                                    <li class="ins-cat-row">
                                        <span class="dot" style="background:@col"></span>
                                        <span class="nm">@c.Category</span>
                                        <span class="bar"><span style="width:@(((double)c.PctOfSpend).ToString("0.0", CultureInfo.InvariantCulture))%;background:@col"></span></span>
                                        <span class="amt">@Money(c.Amount)</span>
                                        @if (c.MoMChangePct.HasValue)
                                        {
                                            var up = c.MoMChangePct.Value > 0;
                                            <span class="mom @(up ? "up" : "down")" title="vs last month">
                                                <i class="bi @(up ? "bi-arrow-up-short" : "bi-arrow-down-short")"></i>@Math.Abs(c.MoMChangePct.Value).ToString("0").Replace("-", "")%
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="mom new">new</span>
                                        }
                                    </li>
                                }
                            </ul>
                        </div>
                    </section>
                }

                @if (s!.Budgets.Count > 0)
                {
                    <section class="ins-panel ins-reveal" aria-label="Budget performance">
                        <div class="ins-panel-title acc-brass"><span class="chip"><i class="bi bi-speedometer2"></i></span> Budget performance</div>
                        <div class="ins-budgets">
                            @foreach (var b in s.Budgets.OrderByDescending(x => x.Budget > 0 ? x.Actual / x.Budget : 0))
                            {
                                var ratio = b.Budget > 0 ? (double)(b.Actual / b.Budget) : (b.Actual > 0 ? 1d : 0d);
                                var fill = Math.Clamp(ratio, 0d, 1d) * 100;
                                var over = b.Actual > b.Budget;
                                <div class="ins-budget-row @(over ? "over" : "under")">
                                    <div class="bh">
                                        <span class="nm">@b.Category</span>
                                        <span class="vp">@b.VariancePct.ToString("+0.0;-0.0", CultureInfo.InvariantCulture)%</span>
                                    </div>
                                    <div class="ins-bar"><span class="ins-bar-fill" style="width:@fill.ToString("0.0", CultureInfo.InvariantCulture)%"></span></div>
                                    <div class="bf"><span>@Money(b.Actual)</span><span class="muted">of @Money(b.Budget)</span></div>
                                </div>
                            }
                        </div>
                    </section>
                }
            </div>
        }

        <!-- ── The written analysis ───────────────────────────── -->
        <div class="ins-narrative">
            @foreach (var sec in sections)
            {
                var (icon, accent) = SectionStyle(sec.title);
                var bodyHtml = Markdig.Markdown.ToHtml(sec.body, pipeline);
                <section class="ins-section ins-reveal acc-@accent">
                    <div class="ins-section-head">
                        <span class="chip"><i class="bi @icon"></i></span>
                        <h2>@sec.title</h2>
                    </div>
                    <div class="ins-section-body">@Html.Raw(bodyHtml)</div>
                </section>
            }
        </div>

        @if (!string.IsNullOrEmpty(disclaimer))
        {
            <p class="ins-disclaimer"><i class="bi bi-shield-lock me-1"></i>@disclaimer</p>
        }
    </div>
}

<style>
    /* ====== INSIGHTS · "The Audited Statement" ====== */
    .ins { display: flex; flex-direction: column; gap: 1.25rem; }

    /* Reveal-on-scroll: fail-safe (visible unless JS enables .ins-anim). */
    .ins-anim .ins-reveal { opacity: 0; transform: translateY(16px); transition: opacity .6s var(--ease-out), transform .6s var(--ease-out); }
    .ins-anim .ins-reveal.is-in { opacity: 1; transform: none; }

    /* ── HERO ───────────────────────────────────────── */
    .ins-hero {
        position: relative; overflow: hidden;
        display: flex; align-items: center; gap: 1.75rem; flex-wrap: wrap;
        padding: 1.75rem 1.9rem;
        background:
            radial-gradient(120% 140% at 100% 0%, var(--red-tint) 0%, transparent 45%),
            linear-gradient(180deg, var(--surface), var(--surface-2));
        border: 1px solid var(--rule); border-radius: var(--r-lg);
        box-shadow: var(--shadow-md);
    }
    .ins-hero-glow {
        position: absolute; right: -60px; top: -60px; width: 240px; height: 240px; border-radius: 50%;
        background: radial-gradient(circle, var(--red-tint-2), transparent 70%);
        pointer-events: none; animation: ins-float 7s ease-in-out infinite;
    }
    .ins-gauge { position: relative; width: 144px; height: 144px; flex-shrink: 0; animation: ins-float 6s ease-in-out infinite; }
    .ins-gauge svg { width: 100%; height: 100%; transform: rotate(-90deg); }
    .ins-gauge-track { fill: none; stroke: var(--rule-strong); stroke-width: 9; }
    .ins-gauge-val {
        fill: none; stroke: var(--green); stroke-width: 9; stroke-linecap: round;
        stroke-dasharray: 326.726; stroke-dashoffset: 326.726;
        transition: stroke-dashoffset 1.3s var(--ease-out);
    }
    .ins-gauge.is-drawn .ins-gauge-val { stroke-dashoffset: var(--target-offset); }
    .ins-gauge.is-deficit .ins-gauge-val { stroke: var(--red); }
    .ins-gauge-center {
        position: absolute; inset: 0; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center;
    }
    .ins-gauge-pct { font-family: var(--font-display); font-weight: 700; font-size: 1.85rem; line-height: 1; color: var(--ink); }
    .ins-gauge-pct .u { font-size: 1rem; color: var(--ink-muted); margin-left: 1px; }
    .ins-gauge-lbl { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-muted); margin-top: 0.25rem; }

    .ins-hero-body { flex: 1 1 320px; min-width: 0; }
    .ins-hero-eyebrow { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.14em; color: var(--ink-muted); font-weight: 600; margin-bottom: 0.85rem; }
    .ins-hero-eyebrow .seal-dot { color: var(--red); }
    .ins-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    .ins-stat .l { font-size: 0.78rem; color: var(--ink-muted); font-weight: 500; display: flex; align-items: center; gap: 0.3rem; margin-bottom: 0.25rem; }
    .ins-stat .v { font-family: var(--font-mono); font-weight: 600; font-size: clamp(1.05rem, 0.9rem + 0.9vw, 1.5rem); letter-spacing: -0.02em; }
    .ins-stat .v.credit { color: var(--green); }
    .ins-stat .v.debit { color: var(--red); }
    .ins-stat .v.net { color: var(--ink); }
    .ins-stat-net { border-left: 1px solid var(--rule); padding-left: 1rem; }
    .ins-mtd { margin-top: 1.1rem; }
    .ins-mtd-bar { height: 6px; border-radius: var(--r-pill); background: var(--paper-3); overflow: hidden; }
    .ins-mtd-bar span { display: block; height: 100%; background: var(--brass); border-radius: var(--r-pill); }
    .ins-mtd-text { font-size: 0.75rem; color: var(--ink-muted); margin-top: 0.4rem; }

    /* ── Visual grid ────────────────────────────────── */
    .ins-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @@media (max-width: 860px) { .ins-grid { grid-template-columns: 1fr; } }

    .ins-panel { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 1.3rem 1.4rem; }
    .ins-panel-title, .ins-section-head { display: flex; align-items: center; gap: 0.65rem; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); margin-bottom: 1.1rem; }
    .ins-panel-title .chip, .ins-section-head .chip {
        width: 2.1rem; height: 2.1rem; flex-shrink: 0; border-radius: var(--r-sm);
        display: inline-flex; align-items: center; justify-content: center; font-size: 1rem;
        background: var(--paper-2); border: 1px solid var(--rule); color: var(--ink-muted);
    }
    .acc-red .chip { background: var(--red-tint); border-color: var(--red-tint-2); color: var(--red); }
    .acc-green .chip { background: var(--green-tint); border-color: var(--green-tint); color: var(--green); }
    .acc-brass .chip { background: var(--brass-tint); border-color: var(--brass-tint); color: var(--brass); }
    .acc-ink .chip { background: var(--paper-2); border-color: var(--rule-strong); color: var(--ink-soft); }

    /* Doughnut + category legend */
    .ins-dough-wrap { display: flex; gap: 1.2rem; align-items: center; flex-wrap: wrap; }
    .ins-dough { position: relative; width: 168px; height: 168px; flex-shrink: 0; margin: 0 auto; }
    .ins-dough-center { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: none; }
    .ins-dough-center .t { font-size: 0.62rem; text-transform: uppercase; letter-spacing: 0.12em; color: var(--ink-muted); }
    .ins-dough-center .a { font-family: var(--font-mono); font-weight: 600; font-size: 0.95rem; color: var(--ink); }
    .ins-cats { list-style: none; margin: 0; padding: 0; flex: 1 1 220px; min-width: 200px; display: flex; flex-direction: column; gap: 0.5rem; }
    .ins-cat-row { display: grid; grid-template-columns: auto 1fr auto; grid-template-areas: "dot nm mom" "bar bar bar" "amt amt amt"; gap: 0.15rem 0.5rem; align-items: center; font-size: 0.85rem; }
    .ins-cat-row .dot { grid-area: dot; width: 9px; height: 9px; border-radius: 2px; }
    .ins-cat-row .nm { grid-area: nm; color: var(--ink); font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ins-cat-row .amt { grid-area: amt; font-family: var(--font-mono); font-size: 0.8rem; color: var(--ink-soft); }
    .ins-cat-row .bar { grid-area: bar; height: 5px; border-radius: var(--r-pill); background: var(--paper-3); overflow: hidden; margin: 0.1rem 0; }
    .ins-cat-row .bar span { display: block; height: 100%; border-radius: var(--r-pill); }
    .ins-cat-row .mom { grid-area: mom; font-size: 0.72rem; font-weight: 600; font-family: var(--font-mono); display: inline-flex; align-items: center; white-space: nowrap; }
    .ins-cat-row .mom.up { color: var(--red); } .ins-cat-row .mom.down { color: var(--green); } .ins-cat-row .mom.new { color: var(--ink-muted); font-weight: 500; }

    /* Budget bars */
    .ins-budgets { display: flex; flex-direction: column; gap: 0.95rem; }
    .ins-budget-row .bh { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.3rem; }
    .ins-budget-row .bh .nm { font-weight: 500; color: var(--ink); font-size: 0.9rem; }
    .ins-budget-row .bh .vp { font-family: var(--font-mono); font-size: 0.78rem; font-weight: 600; }
    .ins-budget-row.over .bh .vp { color: var(--red); } .ins-budget-row.under .bh .vp { color: var(--green); }
    .ins-bar { height: 8px; border-radius: var(--r-pill); background: var(--paper-3); overflow: hidden; }
    .ins-bar-fill { display: block; height: 100%; border-radius: var(--r-pill); width: 0; transition: width 1s var(--ease-out); }
    .ins-budget-row.over .ins-bar-fill { background: var(--red); } .ins-budget-row.under .ins-bar-fill { background: var(--green); }
    .ins-budget-row .bf { display: flex; gap: 0.45rem; font-family: var(--font-mono); font-size: 0.78rem; color: var(--ink); margin-top: 0.3rem; }
    .ins-budget-row .bf .muted { color: var(--ink-muted); }

    /* ── Narrative section cards ────────────────────── */
    .ins-narrative { display: flex; flex-direction: column; gap: 1.1rem; }
    .ins-section { background: var(--surface); border: 1px solid var(--rule); border-left: 3px solid var(--rule-strong); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 1.3rem 1.5rem; }
    .ins-section.acc-red { border-left-color: var(--red); }
    .ins-section.acc-green { border-left-color: var(--green); }
    .ins-section.acc-brass { border-left-color: var(--brass); }
    .ins-section.acc-ink { border-left-color: var(--ink); }
    .ins-section-head h2 { margin: 0; font-size: 1.15rem; }
    .ins-section-body { color: var(--ink-soft); font-size: 0.95rem; line-height: 1.65; }
    .ins-section-body :first-child { margin-top: 0; }
    .ins-section-body :last-child { margin-bottom: 0; }
    .ins-section-body strong { color: var(--ink); font-weight: 600; }
    .ins-section-body ul { list-style: none; padding-left: 0; margin: 0.4rem 0; }
    .ins-section-body ul li { position: relative; padding-left: 1.4rem; margin-bottom: 0.6rem; }
    .ins-section-body ul li::before { content: ""; position: absolute; left: 0.15rem; top: 0.6em; width: 6px; height: 6px; border-radius: 50%; background: var(--red); }
    .ins-section.acc-green .ins-section-body ul li::before { background: var(--green); }
    .ins-section.acc-brass .ins-section-body ul li::before { background: var(--brass); }
    .ins-section.acc-ink .ins-section-body ul li::before { background: var(--ink-muted); }
    .ins-section-body ol { padding-left: 0; margin: 0.4rem 0; list-style: none; counter-reset: step; }
    .ins-section-body ol li { position: relative; padding-left: 2.5rem; margin-bottom: 0.85rem; min-height: 1.75rem; }
    .ins-section-body ol li::before {
        counter-increment: step; content: counter(step);
        position: absolute; left: 0; top: -0.1rem; width: 1.75rem; height: 1.75rem;
        display: flex; align-items: center; justify-content: center;
        background: var(--ink); color: var(--paper); border-radius: 50%;
        font-family: var(--font-mono); font-weight: 600; font-size: 0.85rem;
    }
    .ins-section-body table { width: 100%; border-collapse: collapse; margin: 0.5rem 0; font-size: 0.9rem; }
    .ins-section-body th, .ins-section-body td { padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--rule); text-align: left; vertical-align: top; }
    .ins-section-body thead th { background: var(--paper-2); color: var(--ink); font-weight: 600; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.04em; }
    .ins-section-body td:nth-child(2) { font-family: var(--font-mono); color: var(--ink); white-space: nowrap; }
    .ins-section-body tbody tr:last-child td { border-bottom: none; }

    .ins-disclaimer { font-size: 0.8rem; color: var(--ink-muted); border-top: 1px dashed var(--rule-strong); padding-top: 0.9rem; margin: 0.25rem 0 0; }

    @@keyframes ins-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-7px); } }
    @@media (prefers-reduced-motion: reduce) {
        .ins-gauge, .ins-hero-glow { animation: none; }
        .ins-gauge-val, .ins-bar-fill { transition: none; }
        .ins-anim .ins-reveal { opacity: 1; transform: none; transition: none; }
    }

    /* ── "Money owed" card (live IOU balance) ───────────── */
    .owed-card { background: var(--surface); border: 1px solid var(--rule); border-radius: var(--r-lg); box-shadow: var(--shadow-sm); padding: 1.3rem 1.4rem; }
    .owed-card-head { display: flex; align-items: center; gap: 0.65rem; margin-bottom: 1.1rem; }
    .owed-card-head .chip { width: 2.1rem; height: 2.1rem; flex-shrink: 0; border-radius: var(--r-sm); display: inline-flex; align-items: center; justify-content: center; font-size: 1rem; background: var(--green-tint); border: 1px solid var(--green-tint); color: var(--green); }
    .owed-card-head h2 { margin: 0; font-family: var(--font-display); font-weight: 600; font-size: 1.05rem; color: var(--ink); }
    .owed-card-link { margin-left: auto; font-size: 0.82rem; font-weight: 600; text-decoration: none; color: var(--ink-soft); white-space: nowrap; }
    .owed-card-link:hover { color: var(--red); }
    .owed-card-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @@media (max-width: 640px) { .owed-card-stats { grid-template-columns: 1fr; } }
    .owed-card-stat .l { font-size: 0.78rem; color: var(--ink-muted); font-weight: 500; display: flex; align-items: center; gap: 0.3rem; margin-bottom: 0.25rem; }
    .owed-card-stat .v { font-family: var(--font-mono); font-weight: 600; font-size: clamp(1.05rem, 0.9rem + 0.7vw, 1.4rem); letter-spacing: -0.02em; }
    .owed-card-stat .v.credit { color: var(--green); }
    .owed-card-stat .v.debit { color: var(--red); }
    .owed-card-net { border-left: 1px solid var(--rule); padding-left: 1rem; }
    @@media (max-width: 640px) { .owed-card-net { border-left: none; padding-left: 0; } }
    .owed-card-overdue { margin-top: 0.35rem; font-size: 0.74rem; font-weight: 600; color: var(--red); display: inline-flex; align-items: center; gap: 0.3rem; }
    .owed-card-list { list-style: none; margin: 1.1rem 0 0; padding: 0.9rem 0 0; border-top: 1px dashed var(--rule-strong); display: flex; flex-direction: column; gap: 0.55rem; }
    .owed-card-list li { display: flex; align-items: center; gap: 0.5rem; font-size: 0.88rem; }
    .owed-card-list .nm { color: var(--ink); display: inline-flex; align-items: center; gap: 0.45rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .owed-card-list .nm i.in { color: var(--green); } .owed-card-list .nm i.out { color: var(--red); }
    .owed-card-list .od { font-size: 0.68rem; font-weight: 600; color: var(--red); background: var(--red-tint); border: 1px solid var(--red-tint-2); padding: 0.05rem 0.4rem; border-radius: var(--r-pill); }
    .owed-card-list .amt { margin-left: auto; font-family: var(--font-mono); font-weight: 600; color: var(--ink); }
</style>

@section Scripts {
    @if (hasContent && hasData)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js@@4.4.7/dist/chart.umd.min.js"></script>
    }
    <script>
        (function () {
            var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            var root = document.getElementById('insightsRoot');

            // ── Scroll-triggered staggered reveal (fail-safe) ──
            if (root && !reduced && 'IntersectionObserver' in window) {
                root.classList.add('ins-anim');
                var items = Array.prototype.slice.call(root.querySelectorAll('.ins-reveal'));
                var io = new IntersectionObserver(function (entries) {
                    entries.forEach(function (e) {
                        if (e.isIntersecting) {
                            var idx = items.indexOf(e.target);
                            e.target.style.transitionDelay = Math.min(idx, 6) * 70 + 'ms';
                            e.target.classList.add('is-in');
                            io.unobserve(e.target);
                        }
                    });
                }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
                items.forEach(function (el) { io.observe(el); });
            }

            // ── Gauge arc draw + budget bars ──
            function paint() {
                var g = document.getElementById('insGauge');
                if (g) g.classList.add('is-drawn');
                document.querySelectorAll('.ins-bar-fill').forEach(function (el) {
                    var w = el.style.width; el.style.width = '0';
                    requestAnimationFrame(function () { requestAnimationFrame(function () { el.style.width = w; }); });
                });
            }
            if (reduced) { var g = document.getElementById('insGauge'); if (g) g.classList.add('is-drawn'); }
            else { requestAnimationFrame(function () { setTimeout(paint, 120); }); }

            // ── Spending-mix doughnut ──
            var canvas = document.getElementById('insDoughnut');
            if (canvas && window.Chart) {
                var labels = @Html.Raw(JsonSerializer.Serialize(doughLabels));
                var values = @Html.Raw(JsonSerializer.Serialize(doughValues));
                var colors = @Html.Raw(JsonSerializer.Serialize(palette));
                var css = getComputedStyle(document.documentElement);
                var ink = css.getPropertyValue('--ink').trim() || '#1A1814';
                var surface = css.getPropertyValue('--surface').trim() || '#fff';
                new Chart(canvas, {
                    type: 'doughnut',
                    data: { labels: labels, datasets: [{ data: values, backgroundColor: colors, borderColor: surface, borderWidth: 2, hoverOffset: 6 }] },
                    options: {
                        cutout: '70%', responsive: true, maintainAspectRatio: false,
                        animation: reduced ? false : { animateRotate: true, duration: 1100, easing: 'easeOutCubic' },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: ink, padding: 10, cornerRadius: 6,
                                callbacks: {
                                    label: function (c) {
                                        var t = c.dataset.data.reduce(function (a, b) { return a + b; }, 0);
                                        var pct = t ? Math.round(c.parsed / t * 100) : 0;
                                        try { return c.label + ': ' + c.parsed.toLocaleString('en-IN', { style: 'currency', currency: 'INR', maximumFractionDigits: 0 }) + ' (' + pct + '%)'; }
                                        catch (_) { return c.label + ': ' + pct + '%'; }
                                    }
                                }
                            }
                        }
                    }
                });
            }
        })();
    </script>
}
