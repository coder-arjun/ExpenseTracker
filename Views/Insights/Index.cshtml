@using Markdig
@model string?

@{
    ViewData["Title"] = "Insights";
    var period = (string)ViewData["Period"]!;
    var options = (List<string>)ViewData["PeriodOptions"]!;
    var generatedAt = ViewData["GeneratedAt"] as DateTime?;
    var isMtd = (bool)(ViewData["IsMonthToDate"] ?? false);

    string LabelFor(string p)
    {
        if (p == ExpenseTracker.Controllers.InsightsController.MonthToDateKey)
            return $"This month so far ({DateTime.Now:MMM} 1–{DateTime.Now.Day})";
        var d = DateTime.ParseExact(p, "yyyy-MM", System.Globalization.CultureInfo.InvariantCulture);
        return d.ToString("MMMM yyyy", System.Globalization.CultureInfo.InvariantCulture);
    }
    // Default Markdig pipeline is CommonMark only — no pipe tables, no auto-links.
    // UseAdvancedExtensions enables pipe tables (needed for "A budget to aim for"),
    // task lists, emoji, auto-links, strikethrough, etc.
    var pipeline = new Markdig.MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();
    var html = !string.IsNullOrEmpty(Model)
        ? Markdig.Markdown.ToHtml(Model, pipeline)
        : null;
}

<div class="page-header mb-4">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Ledger insights</div>
    <h1><i class="bi bi-lightbulb me-2"></i>Insights</h1>
    <p>A plain-English read on your money, computed locally — nothing leaves your machine.</p>
</div>

<!-- Period + Generate -->
<div class="card mb-4">
    <div class="card-body">
        <form method="post" asp-action="Generate" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-3">
                <label class="form-label">Period</label>
                <select name="period" class="form-select">
                    @foreach (var p in options)
                    {
                        <option value="@p" selected="@(p == period ? "selected" : null)">
                            @LabelFor(p)
                        </option>
                    }
                </select>
                <div class="form-text">
                    @if (isMtd)
                    {
                        <span><i class="bi bi-arrow-clockwise me-1"></i>Live — recomputed every visit, not cached.</span>
                    }
                    else
                    {
                        <span>Default is last completed month.</span>
                    }
                </div>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-stars me-1"></i>@(html == null ? "Generate" : "Regenerate")
                </button>
            </div>
            @if (generatedAt.HasValue)
            {
                <div class="col-md-auto ms-auto text-muted small">
                    Last generated @generatedAt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            }
        </form>
    </div>
</div>

@if (html == null)
{
    <div class="empty-state-v2">
        <div class="es-icon"><i class="bi bi-stars"></i></div>
        <div class="es-title">No insights generated for @LabelFor(period) yet</div>
        <p class="es-body">Click <strong>Generate</strong> above to analyse this period.</p>
    </div>
}
else
{
    <div class="card">
        <div class="card-body insights-content">
            @Html.Raw(html)
        </div>
    </div>
}

@section Scripts {
    <style>
        .insights-content h2 {
            font-size: 1.25rem;
            margin-top: 1.5rem;
            margin-bottom: 0.75rem;
            padding-bottom: 0.25rem;
            border-bottom: 1px solid var(--bs-border-color);
        }
        .insights-content h2:first-child { margin-top: 0; }
        .insights-content ul { padding-left: 1.25rem; }
        .insights-content li { margin-bottom: 0.35rem; }
        .insights-content table {
            width: 100%;
            margin: 0.75rem 0 1.25rem;
            border-collapse: collapse;
            font-size: 0.95rem;
        }
        .insights-content table th,
        .insights-content table td {
            padding: 0.55rem 0.85rem;
            border-bottom: 1px solid var(--bs-border-color);
            text-align: left;
            vertical-align: top;
        }
        .insights-content table th {
            background: var(--bs-tertiary-bg);
            font-weight: 600;
        }
        .insights-content table tr:last-child td { border-bottom: none; }
        .insights-content em:last-of-type {
            display: block;
            margin-top: 1rem;
            font-size: 0.85rem;
            color: var(--bs-secondary-color);
        }
    </style>
}
