@{
    ViewData["Title"] = "Home";
}

<div class="hero-section">
    <h1>Take control of<br />your finances</h1>
    <p class="hero-subtitle">
        Track expenses, monitor income, set budgets, and gain insights into your spending habits — all in one place.
    </p>
    <div class="hero-cta">
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg px-4">
            <i class="bi bi-speedometer2 me-2"></i>Go to Dashboard
        </a>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon" style="background: var(--color-danger-light); color: var(--color-danger);">
                <i class="bi bi-cash-stack"></i>
            </div>
            <h3>Track Expenses</h3>
            <p>Log every transaction with categories, dates, and descriptions to understand where your money goes.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon" style="background: var(--color-info-light); color: var(--color-info);">
                <i class="bi bi-bullseye"></i>
            </div>
            <h3>Set Budgets</h3>
            <p>Define spending limits per category and get alerts when you're approaching or exceeding your budget.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="feature-card">
            <div class="feature-icon" style="background: var(--color-success-light); color: var(--color-success);">
                <i class="bi bi-graph-up"></i>
            </div>
            <h3>Visual Insights</h3>
            <p>Interactive charts and dashboards give you a clear picture of your financial health at a glance.</p>
        </div>
    </div>
</div>
