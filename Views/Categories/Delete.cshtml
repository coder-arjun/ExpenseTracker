@using ExpenseTracker.Models.Domain
@model ExpenseTracker.Models.Domain.Category

@{
    ViewData["Title"] = "Delete Category";
    var usageCount = (int)(ViewData["UsageCount"] ?? 0);
}

<div class="page-header">
    <div class="eyebrow mb-2"><span class="seal-dot">&#9679;</span> Void entry</div>
    <h1>Delete Category</h1>
    <p><a asp-action="Index" class="text-decoration-none">Categories</a> / Delete</p>
</div>

<div class="row">
    <div class="col-md-6">
        @if (usageCount > 0)
        {
            <div class="delete-warning">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                This category is referenced by <strong>@usageCount</strong> record(s).
                Reassign or delete them first, otherwise deletion will be blocked.
            </div>
        }
        else
        {
            <div class="delete-warning">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                Are you sure you want to delete this category? This action cannot be undone.
            </div>
        }

        <div class="card">
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.Name</dd>
                    <dt class="col-sm-4">Type</dt>
                    <dd class="col-sm-8">
                        @if (Model.Type == CategoryType.Expense)
                        {
                            <span class="badge bg-danger-subtle text-danger">Expense</span>
                        }
                        else
                        {
                            <span class="badge bg-success-subtle text-success">Income</span>
                        }
                    </dd>
                </dl>

                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit" class="btn btn-danger" @(usageCount > 0 ? "disabled" : "")>
                        <i class="bi bi-trash me-1"></i>Delete
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                </form>
            </div>
        </div>
    </div>
</div>
